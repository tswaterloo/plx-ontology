{
 "id": "freightcom.bookings",
 "description": "Freightcom Customer API (test host, GET only): services, booked shipments, each booking's carrier/tracking/BOL presence and tracking events; counts only, never a rate value (licence 5(k)-(m)). Blocks credentials_absent naming the missing setting.",
 "source": "freightcom",
 "command": [
  "python3",
  "-m",
  "integrations.freightcom_read",
  "probe"
 ],
 "timeout_seconds": 300,
 "optional_env": [
  "FREIGHTCOM_API_TOKEN",
  "FREIGHTCOM_API_BASE_URL"
 ],
 "blocked_without_env": [
  "FREIGHTCOM_API_TOKEN"
 ],
 "blocked_when": "blocked",
 "blocked_cause": "later_ask",
 "expect": {
  "exit_code": 0,
  "json_fields": [
   "services",
   "shipments",
   "bookings_read",
   "requests_sent"
  ],
  "json_equals": {
   "ok": true,
   "token": "ok",
   "host": "test",
   "evidence_label": "live-read"
  },
  "json_min": {
   "services": 1
  }
 },
 "record": [
  "blocked",
  "missing_settings",
  "invalid_settings",
  "token",
  "host",
  "services",
  "shipments",
  "bookings_read",
  "tracking_events",
  "with_tracking_number",
  "with_amazon_shipment_id",
  "with_bol",
  "complete",
  "error",
  "error_class",
  "http_status",
  "requests_sent",
  "operations_read",
  "evidence_label"
 ],
 "record_enums": [
  "blocked",
  "missing_settings",
  "invalid_settings",
  "token",
  "host",
  "error",
  "error_class",
  "operations_read",
  "evidence_label"
 ],
 "notes": "Live-unverified until a real read passes: paths beyond /rate are from the Freightcom API 2 docs, not observed. Production host external-api.freightcom.com is refused by the guard."
}
