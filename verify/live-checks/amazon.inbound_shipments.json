{
 "id": "amazon.inbound_shipments",
 "description": "Amazon SP-API (LWA token POST, then GET only): Fulfillment Inbound shipments of the last 90 days, items of up to three, FBA inventory summaries and 30-day order metrics for up to 20 seller SKUs; counts only. Blocks credentials_absent naming the missing setting.",
 "source": "amazon-sp-api",
 "command": [
  "python3",
  "-m",
  "integrations.amazon_sp_read",
  "probe"
 ],
 "timeout_seconds": 300,
 "optional_env": [
  "AMAZON_SP_API_LWA_CLIENT_ID",
  "AMAZON_SP_API_LWA_CLIENT_SECRET",
  "AMAZON_SP_API_REFRESH_TOKEN",
  "AMAZON_SP_API_REGION",
  "AMAZON_SP_API_MARKETPLACE_IDS"
 ],
 "blocked_without_env": [
  "AMAZON_SP_API_LWA_CLIENT_ID",
  "AMAZON_SP_API_LWA_CLIENT_SECRET",
  "AMAZON_SP_API_REFRESH_TOKEN",
  "AMAZON_SP_API_MARKETPLACE_IDS"
 ],
 "blocked_when": "blocked",
 "blocked_cause": "later_ask",
 "expect": {
  "exit_code": 0,
  "json_fields": [
   "inbound_shipments",
   "inventory_skus",
   "sales_skus_read",
   "requests_sent"
  ],
  "json_equals": {
   "ok": true,
   "token": "ok",
   "evidence_label": "live-read"
  },
  "json_min": {
   "marketplaces": 1
  }
 },
 "record": [
  "blocked",
  "missing_settings",
  "invalid_settings",
  "token",
  "region",
  "marketplaces",
  "inbound_shipments",
  "inbound_with_fc",
  "inbound_items",
  "inventory_skus",
  "sales_skus_read",
  "sales_skus_with_units",
  "complete",
  "error",
  "error_class",
  "http_status",
  "error_code",
  "requests_sent",
  "operations_read",
  "evidence_label"
 ],
 "record_enums": [
  "blocked",
  "missing_settings",
  "invalid_settings",
  "token",
  "region",
  "error",
  "error_class",
  "error_code",
  "operations_read",
  "evidence_label"
 ],
 "notes": "Live-unverified until a real read passes. getOrderMetrics is throttled to one call per 2 s (0.5 rps), so 20 SKUs take about 40 s."
}
