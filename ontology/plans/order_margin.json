   "step": "loose_memos",
   "path": "meta.freshness.*.completeness",
   "where": {
    "source": "bc"
   },
   "reduce": "first",
   "description": "Whether the BC capture the order's customer and its credit memos were read from is complete: with a reached customer it proves no credit memo against the order is unseen."
  },
  {
