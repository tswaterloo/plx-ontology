   "kind": "select",
   "step": "root_read",
   "path": "object.object_id",
   "reduce": "first",
   "description": "The order's object: rooted at a binding of posted_bindings, BC no longer serves the order, so its lines are its posted invoice lines."
  },
  {
   "name": "order_margin",
   "kind": "compute",
   "required": true,
   "description": "Per line: revenue net of applied credit memos, booked cost net of returns and margin in the invoice currency; the order totals and margin % only when every item line is computed over a line set proven complete with no credit left unattributed to a line.",
