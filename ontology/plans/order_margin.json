   "kind": "select",
   "step": "loose_memos",
   "path": "hops.*.count",
   "where": {
    "link_type": "SalesOrder.ordered_by"
   },
   "reduce": "first",
   "description": "How many BC customers the order reached (one: its credit memos were searched)."
  },
  {
   "name": "credit_hidden",
   "kind": "select",
   "step": "loose_memos",
   "path": "gaps.*.state",
   "where": {
    "reason": "marking_withheld"
   },
   "reduce": "count",
   "description": "The customer's credit memos carry what this reader may not read (nothing readable reached)."
  },
  {
   "name": "credit_withheld",
   "kind": "select",
   "step": "loose_memos",
   "path": "gaps.*.state",
   "where": {
    "reason": "withheld_by_permission"
   },
   "reduce": "count",
   "description": "The customer's credit memos carry what this reader may not read (some readable reached)."
  },
  {
