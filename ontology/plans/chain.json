{
 "$schema": "_plan.schema.json",
 "format": "plx-investigate-plan/v1",
 "id": "chain",
 "families": [
  "F1"
 ],
 "title": "Records linked to a transaction across systems",
 "description": "The transaction chain around one root record: every declared link from the root's type (from a receipt's or invoice's order too, as the order's own chain), and one more hop from its lines, shipments, receipts and twins, along the Portal FKs and the FM/Sage/BC same-record links the ontology declares (docs/reference/portal-code-map.md 3.1-3.11), and the typed documents that name the root or its twins along every mention link the schema declares into their types (supplier confirmations, packing slips, freight bills ... of a purchase order; customer PO documents of a sales order; AO packets of an assembly order; a document type the schema adds is followed with no plan edit). Counts are of distinct visible records the walk reached, one count per system binding (a Portal order and its FileMaker twin are one sales order and one FM order entry, never two sales orders); a document is one record however it was captured (its mailed and filed copies with the same bytes count once); a type nothing reached is not counted as zero. Links below the default tier floor (every machine-read document reference today) are followed only at lead tier and labelled.",
 "root": {
  "object_types": [
   "SalesOrder",
   "PurchaseOrder",
   "Receipt",
   "AssemblyOrder",
   "SalesInvoice",
   "PurchaseInvoice"
  ],
  "fallback_filters": [
   {
    "object_type": "PurchaseOrder",
    "property": "po_number"
   },
   {
    "object_type": "Receipt",
    "property": "receipt_number"
   },
   {
    "object_type": "SalesOrder",
    "property": "order_number"
   }
  ]
 },
 "step_budget": 128,
 "steps": [
  {
   "id": "root_read",
   "tool": "plx.object",
   "from": "root",
   "bind": "object_id"
  },
  {
   "id": "si_order",
   "tool": "plx.around",
   "from": "root",
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "SalesInvoice.bills",
      "direction": "forward"
     }
    ],
    "limit": 50
   },
   "retry": {
    "on_gap_reasons": [
     "below_tier_floor"
    ],
    "set_args": {
     "tier_floor": "lead"
    },
    "note_gap": "lead_tier_links_followed"
   }
  },
  {
