 "evidence": [
  {
   "name": "chain_roots",
   "kind": "count",
   "from": "root",
   "description": "The records the question resolved to."
  },
  {
   "name": "commercial_links",
   "kind": "compute",
   "engine": "commercial_chain",
   "engine_args": {
    "roots": "chain_roots",
    "hops": [
     {
      "label": "order_to_quote",
      "from_types": [
       "SalesOrder"
      ],
      "link_types": [
       "SalesOrder.created_from_quote",
       "Quote.converted_to"
      ],
      "through": [
       "SalesOrder.same_record_as"
      ],
      "gap": "order_quote_link_not_recorded",
      "question": "When an order is entered in Business Central or FileMaker rather than converted in the Portal, where is the quote it was priced from recorded, if anywhere?",
      "who_can_answer": "operations (who keeps the source)"
     },
     {
      "label": "quote_to_order",
      "from_types": [
       "Quote"
      ],
      "link_types": [
       "Quote.converted_to",
       "SalesOrder.created_from_quote"
      ],
      "gap": "quote_order_link_not_recorded",
      "question": "When a quote is won but the order is entered outside the Portal, where is the order it became recorded?",
      "who_can_answer": "operations (who keeps the source)"
     },
     {
      "label": "po_to_receipt",
      "from_types": [
       "PurchaseOrder"
      ],
      "link_types": [
       "Receipt.receives"
      ],
      "through": [
       "PurchaseOrder.same_record_as"
      ],
      "gap": "receipt_not_recorded",
      "question": "Which receiving record (a Business Central posted receipt, a warehouse slip or a FileMaker entry) shows the actual receipt of a purchase order, and does it name the order?",
      "who_can_answer": "operations (who keeps the source)"
     },
     {
      "label": "po_to_invoice",
      "from_types": [
       "PurchaseOrder"
      ],
      "link_types": [
       "PurchaseInvoice.invoices",
       "PurchaseInvoice.names_order"
      ],
      "through": [
       "PurchaseOrder.same_record_as"
      ],
      "gap": "purchase_invoice_not_recorded"
     },
     {
      "label": "invoice_payment",
      "from_types": [
       "PurchaseOrder"
      ],
      "link_types": [
       "Payment.applies_to_purchase_invoice"
      ],
      "through": [
       "PurchaseOrder.same_record_as",
       "PurchaseInvoice.invoices",
       "PurchaseInvoice.names_order"
      ],
      "depth": 2,
      "gap": "payment_not_recorded"
     },
     {
      "label": "deposit_to_po",
      "from_types": [
       "PurchaseOrder"
      ],
      "unbound": {
       "reason": "deposit_link_source_unknown",
       "state": "unknown",
       "detail": "no source the Workbench reads is known to link a supplier deposit to the purchase order or proforma it pays; a payment is never matched to an order by supplier, date or amount"
      },
      "question": "How is a supplier deposit recorded in Business Central (prepayment invoice, or a vendor payment line with which applies-to or external document number), and does it name the PO?",
      "who_can_answer": "operations (who keeps the source)"
     },
     {
      "label": "supply_agreement",
      "from_types": [
       "Quote",
       "SalesOrder"
      ],
      "unbound": {
       "reason": "supply_agreement_source_unknown",
       "state": "unknown",
       "detail": "no source the Workbench reads is known to hold the signed supply agreement or the payment terms and deposit rules it sets for the customer"
      },
      "question": "Where are signed MSAs and supply agreements stored, and who records their payment terms and deposit rules against the customer?",
      "who_can_answer": "operations (who keeps the source)"
     },
     {
      "label": "won_tier_to_order_line",
      "from_types": [
       "Quote"
      ],
      "unbound": {
       "reason": "won_tier_not_recorded",
       "state": "absent_in_source",
       "detail": "the Portal's quote conversion copies every quoted volume tier to the order and records no tier as the one won, so no order line is linked to a won tier"
      },
      "question": "When a quote offers several volume tiers, where is the tier the customer accepted recorded?",
      "who_can_answer": "operations (who keeps the source)"
     },
     {
      "label": "legacy_quote_screens",
      "from_types": [
       "Quote",
       "SalesOrder"
      ],
      "unbound": {
       "reason": "legacy_quote_source_not_ingested",
       "state": "not_ingested",
       "detail": "quotes priced and orders entered in FileMaker layouts or Sage screens are not read, so a link recorded only there is not seen"
      },
      "question": "Which FileMaker layouts and Sage screens are still used to price quotes or enter orders, and for which customers?",
      "who_can_answer": "operations (who keeps the source)"
     },
     {
      "label": "complaint_to_resolution",
      "from_types": [
       "SalesOrder",
       "PurchaseOrder"
      ],
      "unbound": {
       "reason": "complaint_source_unknown",
       "state": "unknown",
       "detail": "no source the Workbench reads is known to record customer complaints or their resolution against an order"
      },
      "question": "Where is a customer complaint and its resolution recorded, and which inventory transaction posts a replacement or return?",
      "who_can_answer": "operations (who keeps the source)"
     }
    ]
   },
   "description": "Each recorded link of the chain, and a typed gap with its owner question for each link no source records."
  }
 ]
}
