{
 "$schema": "_plan.schema.json",
 "format": "plx-investigate-plan/v1",
 "id": "commercial_chain",
 "families": [
  "F12"
 ],
 "title": "The recorded links of a quote, order or purchase order's commercial chain",
 "description": "Which recorded link joins a quote to its order (Portal app_quote.convertedSalesOrderId and app_sales_order.sourceQuoteId, written by the Portal's quote conversion), an order to its twins in BC, FM and Sage, a purchase order to its receipts, invoices and the payments applied to them; each link the chain needs and no source records is a typed gap with the question for the source's owner (deposit to PO or proforma, supply agreement, won volume tier, legacy FileMaker/Sage screens, complaint to resolution). Links are only read, never inferred: two records sharing a customer, date or amount are not linked unless a source stores the link (operating/commercial_chain.py).",
 "root": {
  "object_types": [
   "Quote",
   "SalesOrder",
   "PurchaseOrder"
  ],
  "fallback_filters": [
   {
    "object_type": "Quote",
    "property": "quote_number"
   },
   {
    "object_type": "SalesOrder",
    "property": "order_number"
   },
   {
    "object_type": "PurchaseOrder",
    "property": "po_number"
   }
  ]
 },
 "step_budget": 64,
