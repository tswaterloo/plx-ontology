  {
   "name": "stated",
   "kind": "compute",
   "required": true,
   "engine": "value_provenance",
   "description": "Each term a vendor message states, quoted with its place in the cited text, and its comparison with the system value.",
   "engine_args": {
    "system": {
     "po": [
      "po_number"
     ],
     "currency": [
      "po_currency",
      "supplier_currency"
     ],
     "line_price": [
      "line_price"
     ],
     "line_uom": [
      "line_uom"
     ],
     "line_description": [
      "line_description"
     ],
     "item": [
