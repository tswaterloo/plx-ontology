  },
  {
   "name": "si_uom",
   "kind": "property",
   "object_type": "SupplierItem",
   "properties": [
    "purchase_uom"
   ],
   "omit_empty": true
  },
  {
   "name": "si_moq",
   "kind": "property",
   "object_type": "SupplierItem",
   "properties": [
    "min_order"
   ],
   "omit_empty": true
  },
  {
   "name": "si_lead_time",
   "kind": "property",
   "object_type": "SupplierItem",
   "properties": [
    "lead_time_days"
   ],
   "omit_empty": true
  },
  {
   "name": "mail_time",
   "kind": "property",
   "object_type": "Email",
   "properties": [
