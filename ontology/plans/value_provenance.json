      "item_name"
     ],
     "supplier": [
      "supplier_name"
     ],
     "website": [
      "supplier_website"
     ],
     "supplier_lead_time": [
      "supplier_lead_time"
     ],
     "si_number": [
      "si_number"
     ],
     "si_cost_per_kg": [
      "si_cost_per_kg"
     ],
     "si_entry_cost": [
      "si_entry_cost"
     ],
     "si_uom": [
      "si_uom"
     ],
     "si_moq": [
