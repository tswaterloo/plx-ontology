      "mail_time",
      "teams_time",
      "channel_time"
     ],
     "sender": [
      "mail_sender",
      "teams_sender",
      "channel_sender"
     ],
     "subject": [
      "mail_subject"
     ],
     "conversation": [
      "mail_conversation"
     ],
     "attachment": [
      "attachment_name"
     ]
    },
    "links": {
     "attached_to": "Attachment.attached_to",
     "line_of": "PurchaseOrderLine.line_of",
     "for_item": [
      "PurchaseOrderLine.for_item",
      "SupplierItem.for_item"
     ],
     "offered_by": "SupplierItem.offered_by",
