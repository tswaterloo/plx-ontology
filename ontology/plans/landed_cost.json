   "tool": "plx.object",
   "from": "root",
   "bind": "object_id"
  },
  {
   "id": "twins",
   "tool": "plx.around",
   "from": "root",
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "PurchaseOrder.same_record_as",
      "direction": "forward"
