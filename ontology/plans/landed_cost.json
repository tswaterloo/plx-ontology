     "tier_floor": "lead"
    },
    "note_gap": "lead_tier_links_followed"
   }
  },
  {
   "id": "twins_back",
   "tool": "plx.around",
   "from": "root",
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "PurchaseOrder.same_record_as",
      "direction": "reverse"
     }
    ],
    "limit": 50
   },
   "retry": {
