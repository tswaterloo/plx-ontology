   "path": "object.object_id",
   "reduce": "first",
   "description": "The order's object: only a Sage O/E order (binding portal.sage_oe_order_header) is computed."
  },
  {
   "name": "order_margin",
   "kind": "compute",
   "required": true,
   "description": "Per item: invoiced revenue (extended amount less the invoice-discount share, times the invoice's posted rate into the home currency) against the cost Sage booked to cost of sales (quantity x unit conversion / cost-unit conversion x unit cost); the order totals and margin % only when the order is a sales order shipped and invoiced in full over invoices read whole.",
   "engine": "sage_order_margin",
   "engine_args": {
    "roles": {
     "order_number": "order_number",
     "order_type": "order_type",
     "line_type": "line_type",
