{
 "$schema": "_plan.schema.json",
 "format": "plx-investigate-plan/v1",
 "id": "lot_impact",
 "families": [
  "F17"
 ],
 "title": "Which customers, orders and shipments a supplier lot or a production batch touches, and where it came from",
 "description": "On a quality hold or recall of a lot (a supplier Lot record or its lot number: every receipt-line record carrying it at a firm tier is a root; or a production Batch, by its batch or lot number): walk only recorded firm-tier links. From a supplier lot: to the receipt, purchase order and supplier it was received on, and from the assembly-order components recorded as consuming it to their assembly orders. From a batch (and its recorded same-batch records): to the assembly orders filled from it, its order-entry batch allocations and the order its OE list names. Then to the order lines those are made or allocated for, the customer orders, their recorded shipments (on the order and its copies, by shipment header, Sage shipment line or invoice line) and the customers who ordered or were shipped them. Per order: the ordered quantity of the touched lines, with every link cited. A missing hop is a typed gap naming the source that would hold it; a component matched by lot number only is a candidate, never walked; a hop the served schema does not declare yet is named, not guessed. Needs the quality_controlled read scope.",
 "requires_markings": [
  "quality_controlled"
 ],
 "root": {
  "object_types": [
   "Lot",
   "Batch"
  ],
  "cardinality": "set",
  "set_tiers": [
   "verified",
   "reviewed",
   "corroborated"
  ],
  "fallback_filters": [
   {
    "object_type": "Lot",
    "property": "lot_number"
   },
   {
    "object_type": "Batch",
    "property": "lot_number"
   },
   {
    "object_type": "Batch",
    "property": "batch_number"
   }
  ]
 },
 "step_budget": 128,
 "max_each": 50,
 "steps": [
  {
   "id": "lot_read",
   "tool": "plx.object",
   "from": "root",
   "bind": "object_id",
   "object_types": [
    "Lot"
   ],
   "description": "Each lot record's lot number (one record per receipt line that received it)."
  },
  {
   "id": "batch_twins",
   "tool": "plx.around",
   "from": "root",
   "bind": "from",
   "object_types": [
    "Batch"
   ],
   "args": {
    "path": [
     {
      "link_type": "Batch.same_record_as",
      "direction": "forward"
     }
    ],
    "limit": 50
   },
   "description": "The batch record the FileMaker batch was upserted into (same batch)."
  },
  {
   "id": "batch_twins_rev",
   "tool": "plx.around",
   "from": "root",
   "bind": "from",
   "object_types": [
    "Batch"
   ],
   "args": {
    "path": [
     {
      "link_type": "Batch.same_record_as",
      "direction": "reverse"
     }
    ],
    "limit": 50
   },
   "description": "The FileMaker batches upserted into the batch record (same batch)."
  },
  {
   "id": "batch_aos",
   "tool": "plx.around",
   "from": [
    "root",
    "batch_twins_rev"
   ],
   "bind": "from",
   "object_types": [
    "Batch"
   ],
   "args": {
    "path": [
     {
      "link_type": "AssemblyOrder.fills_from",
      "direction": "reverse"
     }
    ],
    "limit": 50
   },
   "description": "The assembly orders filled from the batch."
  },
  {
   "id": "batch_allocs",
   "tool": "plx.around",
   "from": [
    "root",
    "batch_twins_rev"
   ],
   "bind": "from",
   "object_types": [
    "Batch"
   ],
   "args": {
    "path": [
     {
      "link_type": "BatchAllocation.allocates",
      "direction": "reverse"
     }
    ],
    "limit": 50
   },
   "description": "FileMaker order-entry batch allocations of the batch."
  },
  {
   "id": "batch_alloc_lines",
   "tool": "plx.around",
   "from": "batch_allocs",
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "BatchAllocation.for_order_line",
      "direction": "forward"
     }
    ],
    "limit": 50
   },
   "description": "The FileMaker order line each batch allocation is for."
  },
  {
   "id": "batch_orders",
   "tool": "plx.around",
   "from": [
    "root",
    "batch_twins_rev"
   ],
   "bind": "from",
   "object_types": [
    "Batch"
   ],
   "args": {
    "path": [
     {
      "link_type": "Batch.for_sales_order",
      "direction": "forward"
     }
    ],
    "limit": 50
   },
   "if_declared": true,
   "description": "The FileMaker order the batch's OE list names (one order only)."
  },
  {
   "id": "batch_schedules",
   "tool": "plx.around",
   "from": [
    "root",
    "batch_twins_rev"
   ],
   "bind": "from",
   "object_types": [
    "Batch"
   ],
   "args": {
    "path": [
     {
      "link_type": "BatchSchedule.for_batch",
      "direction": "reverse"
     }
    ],
    "limit": 50
   },
   "description": "The batch's QC calibration schedule rows."
  },
  {
   "id": "schedule_products",
   "tool": "plx.around",
   "from": "batch_schedules",
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "BatchSchedule.for_bulk_product",
      "direction": "forward"
     }
    ],
    "limit": 50
   },
   "if_declared": true,
   "description": "The bulk product each QC calibration schedule row names."
  },
  {
   "id": "lines",
   "tool": "plx.around",
   "from": "root",
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "ReceiptLine.received_lot",
      "direction": "reverse"
     }
    ],
    "limit": 50
   },
   "description": "The receipt line that received the lot."
  },
  {
   "id": "receipts",
   "tool": "plx.around",
   "from": "root",
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "Lot.received_in",
      "direction": "forward"
     }
    ],
    "limit": 50
   },
   "description": "The receipt the lot came in on."
  },
  {
   "id": "line_receipts",
   "tool": "plx.around",
   "from": "lines",
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "ReceiptLine.line_of",
      "direction": "forward"
     }
    ],
    "limit": 50
   },
   "description": "The receipt each receipt line belongs to."
  },
  {
   "id": "pos",
   "tool": "plx.around",
   "from": [
    "receipts",
    "line_receipts"
   ],
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "Receipt.receives",
      "direction": "forward"
     }
    ],
    "limit": 50
   },
   "description": "The purchase order each receipt receives."
  },
  {
   "id": "po_lines",
   "tool": "plx.around",
   "from": "lines",
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "ReceiptLine.receives_line",
      "direction": "forward"
     }
    ],
    "limit": 50
   },
   "description": "The purchase order line each FileMaker receipt line receives."
  },
  {
   "id": "line_pos",
   "tool": "plx.around",
   "from": "po_lines",
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "PurchaseOrderLine.line_of",
      "direction": "forward"
     }
    ],
    "limit": 50
   },
   "description": "The purchase order of that line."
  },
  {
   "id": "po_suppliers",
   "tool": "plx.around",
   "from": [
    "pos",
    "line_pos"
   ],
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "PurchaseOrder.ordered_from",
      "direction": "forward"
     }
    ],
    "limit": 50
   },
   "description": "The supplier each purchase order is placed with."
  },
  {
   "id": "receipt_suppliers",
   "tool": "plx.around",
   "from": [
    "receipts",
    "line_receipts"
   ],
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "Receipt.supplied_by",
      "direction": "forward"
     }
    ],
    "limit": 50
   },
   "description": "The supplier on each receipt."
  },
  {
   "id": "components",
   "tool": "plx.around",
   "from": "root",
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "AssemblyOrderComponent.consumed_lot",
      "direction": "reverse"
     }
    ],
    "limit": 50
   },
   "description": "Assembly-order components recorded as consuming the lot (a reviewed lot-number match; quality-controlled links)."
  },
  {
   "id": "candidate_components",
   "tool": "plx.around",
   "from": "root",
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "AssemblyOrderComponent.consumed_lot",
      "direction": "reverse"
     }
    ],
    "tier_floor": "lead",
    "limit": 50
   },
   "description": "Components matched to the lot by lot number only (lead tier): candidates, never walked further."
  },
  {
   "id": "assembly",
   "tool": "plx.around",
   "from": "components",
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "AssemblyOrderComponent.component_of",
      "direction": "forward"
     }
    ],
    "limit": 50
   },
   "description": "The assembly order each consuming component belongs to."
  },
  {
   "id": "allocations",
   "tool": "plx.around",
   "from": [
    "assembly",
    "batch_aos"
   ],
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "AssemblyOrderAllocation.allocates",
      "direction": "reverse"
     }
    ],
    "limit": 50
   },
   "description": "FileMaker order-entry assembly allocations of the FileMaker assembly order.",
   "object_types": [
    "AssemblyOrder"
   ]
  },
  {
   "id": "alloc_lines",
   "tool": "plx.around",
   "from": "allocations",
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "AssemblyOrderAllocation.for_order_line",
      "direction": "forward"
     }
    ],
    "limit": 50
   },
   "description": "The FileMaker order line each allocation is for."
  },
  {
   "id": "ao_twins",
   "tool": "plx.around",
   "from": [
    "assembly",
    "batch_aos"
   ],
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "AssemblyOrder.same_record_as",
      "direction": "reverse"
     }
    ],
    "limit": 50
   },
   "description": "The Portal manufacturing order recorded as the same record as the FileMaker assembly order.",
   "object_types": [
    "AssemblyOrder"
   ]
  },
  {
   "id": "ao_lines",
   "tool": "plx.around",
   "from": "ao_twins",
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "AssemblyOrder.for_order_line",
      "direction": "forward"
     }
    ],
    "limit": 50
   },
   "description": "The Portal sales order line a manufacturing order is made for."
  },
  {
   "id": "line_read",
   "tool": "plx.object",
   "from": [
    "alloc_lines",
    "batch_alloc_lines"
   ],
   "bind": "object_id",
   "description": "Each touched FileMaker order line's ordered quantity.",
   "object_types": [
    "SalesOrderLine"
   ]
  },
  {
   "id": "portal_line_read",
   "tool": "plx.object",
   "from": "ao_lines",
   "bind": "object_id",
   "description": "Each touched Portal order line's ordered quantity."
  },
  {
   "id": "orders",
   "tool": "plx.around",
   "from": [
    "alloc_lines",
    "batch_alloc_lines"
   ],
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "SalesOrderLine.line_of",
      "direction": "forward"
     }
    ],
    "limit": 50
   },
   "description": "The FileMaker customer order each touched order line belongs to.",
   "object_types": [
    "SalesOrderLine"
   ]
  },
  {
   "id": "portal_orders",
   "tool": "plx.around",
   "from": "ao_lines",
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "SalesOrderLine.line_of",
      "direction": "forward"
     }
    ],
    "limit": 50
   },
   "description": "The Portal customer order each touched order line belongs to."
  },
  {
   "id": "order_twins",
   "tool": "plx.around",
   "from": [
    "orders",
    "batch_orders"
   ],
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "SalesOrder.same_record_as",
      "direction": "forward"
     }
    ],
    "limit": 50
   },
   "description": "The FileMaker order's records in other systems.",
   "object_types": [
    "SalesOrder"
   ]
  },
  {
   "id": "order_twins_named",
   "tool": "plx.around",
   "from": [
    "orders",
    "batch_orders"
   ],
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "SalesOrder.same_record_as",
      "direction": "reverse"
     }
    ],
    "limit": 50
   },
   "description": "The same, where the other record holds the link.",
   "object_types": [
    "SalesOrder"
   ]
  },
  {
   "id": "portal_order_twins",
   "tool": "plx.around",
   "from": "portal_orders",
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "SalesOrder.same_record_as",
      "direction": "reverse"
     }
    ],
    "limit": 50
   },
   "description": "The Portal order's FileMaker record, where that record holds the link."
  },
  {
   "id": "portal_order_twins_fwd",
   "tool": "plx.around",
   "from": "portal_orders",
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "SalesOrder.same_record_as",
      "direction": "forward"
     }
    ],
    "limit": 50
   },
   "description": "The Portal order's records in other systems it holds the link to (FileMaker, Sage, BC)."
  },
  {
   "id": "order_twins2",
   "tool": "plx.around",
   "from": "order_twins",
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "SalesOrder.same_record_as",
      "direction": "forward"
     }
    ],
    "limit": 50
   },
   "description": "Second link: the copies a twin of the FileMaker order links to (the Portal order's Sage and BC records)."
  },
  {
   "id": "order_twins2_named",
   "tool": "plx.around",
   "from": "order_twins_named",
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "SalesOrder.same_record_as",
      "direction": "forward"
     }
    ],
    "limit": 50
   },
   "description": "Second link: the copies the Portal record holding the link to the FileMaker order links to (Sage, BC)."
  },
  {
   "id": "shipments",
   "tool": "plx.around",
   "from": "order_twins",
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "Shipment.ships",
      "direction": "reverse"
     }
    ],
    "limit": 50
   },
   "description": "Shipments recorded for the order (which lot a shipment carried is not recorded)."
  },
  {
   "id": "shipments_named",
   "tool": "plx.around",
   "from": "order_twins_named",
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "Shipment.ships",
      "direction": "reverse"
     }
    ],
    "limit": 50
   },
   "description": "The same, for twins that hold the link."
  },
  {
   "id": "portal_shipments",
   "tool": "plx.around",
   "from": "portal_orders",
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "Shipment.ships",
      "direction": "reverse"
     }
    ],
    "limit": 50
   },
   "description": "Shipments recorded for the Portal order."
  },
  {
   "id": "portal_copy_shipments",
   "tool": "plx.around",
   "from": "portal_order_twins_fwd",
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "Shipment.ships",
      "direction": "reverse"
     }
    ],
    "limit": 50
   },
   "description": "Shipments recorded on the Portal order's Sage or BC copy."
  },
  {
   "id": "copy_shipments",
   "tool": "plx.around",
   "from": "order_twins2",
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "Shipment.ships",
      "direction": "reverse"
     }
    ],
    "limit": 50
   },
   "description": "Shipments recorded on a copy two links from the FileMaker order."
  },
  {
   "id": "copy_shipments_named",
   "tool": "plx.around",
   "from": "order_twins2_named",
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "Shipment.ships",
      "direction": "reverse"
     }
    ],
    "limit": 50
   },
   "description": "The same, through the Portal record holding the link."
  },
  {
   "id": "ship_lines",
   "tool": "plx.around",
   "from": [
    "orders",
    "batch_orders",
    "order_twins",
    "order_twins_named",
    "portal_order_twins_fwd",
    "order_twins2",
    "order_twins2_named"
   ],
   "bind": "from",
   "object_types": [
    "SalesOrder"
   ],
   "args": {
    "path": [
     {
      "link_type": "ShipmentLine.of_sales_order",
      "direction": "reverse"
     }
    ],
    "limit": 50
   },
   "if_declared": true,
   "description": "The Sage shipment lines that name the order (line level)."
  },
  {
   "id": "ship_line_shipments",
   "tool": "plx.around",
   "from": "ship_lines",
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "ShipmentLine.line_of",
      "direction": "forward"
     }
    ],
    "limit": 50
   },
   "if_declared": true,
   "description": "The shipment each of those Sage shipment lines belongs to."
  },
  {
   "id": "invoice_lines",
   "tool": "plx.around",
   "from": [
    "orders",
    "batch_orders",
    "order_twins",
    "order_twins_named",
    "portal_order_twins_fwd",
    "order_twins2",
    "order_twins2_named"
   ],
   "bind": "from",
   "object_types": [
    "SalesOrder"
   ],
   "args": {
    "path": [
     {
      "link_type": "SalesInvoiceLine.of_sales_order",
      "direction": "reverse"
     }
    ],
    "limit": 50
   },
   "if_declared": true,
   "description": "The Sage invoice lines that bill the order."
  },
  {
   "id": "invoice_shipments",
   "tool": "plx.around",
   "from": "invoice_lines",
   "bind": "from",
   "args": {
    "path": [
     {
      "link_type": "SalesInvoiceLine.of_shipment",
      "direction": "forward"
     }
    ],
    "limit": 50
   },
   "if_declared": true,
   "description": "The shipment each of those Sage invoice lines bills."
  },
  {
   "id": "order_customers",
   "tool": "plx.around",
   "from": [
    "orders",
    "batch_orders",
    "portal_orders",
    "order_twins",
    "order_twins_named",
    "portal_order_twins_fwd",
    "order_twins2",
    "order_twins2_named"
   ],
   "bind": "from",
   "object_types": [
    "SalesOrder"
   ],
   "args": {
    "path": [
     {
      "link_type": "SalesOrder.ordered_by",
      "direction": "forward"
     }
    ],
    "limit": 50
   },
   "description": "The customer each touched order (or a copy of it) is ordered by."
  },
  {
   "id": "ship_customers",
   "tool": "plx.around",
   "from": [
    "shipments",
    "shipments_named",
    "portal_shipments",
    "portal_copy_shipments",
    "copy_shipments",
    "copy_shipments_named",
    "ship_line_shipments",
    "invoice_shipments"
   ],
   "bind": "from",
   "object_types": [
    "Shipment"
   ],
   "args": {
    "path": [
     {
      "link_type": "Shipment.shipped_to",
      "direction": "forward"
     }
    ],
    "limit": 50
   },
   "description": "The customer each shipment was shipped to."
  },
  {
   "id": "customer_twins",
   "tool": "plx.around",
   "from": [
    "order_customers",
    "ship_customers"
   ],
   "bind": "from",
   "object_types": [
    "Customer"
   ],
   "args": {
    "path": [
     {
      "link_type": "Customer.same_record_as",
      "direction": "forward"
     }
    ],
    "limit": 50
   },
   "description": "The customer's records in other systems (one customer, not two)."
  },
  {
   "id": "customer_twins_rev",
   "tool": "plx.around",
   "from": [
    "order_customers",
    "ship_customers"
   ],
   "bind": "from",
   "object_types": [
    "Customer"
   ],
   "args": {
    "path": [
     {
      "link_type": "Customer.same_record_as",
      "direction": "reverse"
     }
    ],
    "limit": 50
   },
   "description": "The same, where the other record holds the link."
  }
 ],
 "evidence": [
  {
   "name": "lot",
   "kind": "property",
   "object_type": "Lot",
   "properties": [
    "lot_number"
   ],
   "numbering": "value",
   "description": "Each lot record's lot number."
  },
  {
   "name": "line_ordered",
   "kind": "property",
   "object_type": "SalesOrderLine",
   "properties": [
    "ordered_quantity"
   ],
   "quantity_role": "ordered",
   "description": "Each touched order line's ordered quantity."
  },
  {
   "name": "lot_impact",
   "kind": "compute",
   "engine": "lot_impact",
   "required": true,
