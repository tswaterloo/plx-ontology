{
 "format": "plx-ontology-stamps/v1",
 "rule": "A column is a write stamp of a relation when it is write metadata (a write or sync time, an entity tag, a regenerated id, or a label computed from such a time; never an amount, quantity, status, flag or business date) and, in the capture store's own history, at least 90% of the version pairs in which it changes (at least 50 measured) change nothing else but write metadata. Consecutive versions of a record differing only in these are one projected version (ontology/stamps.py).",
 "measured": "2026-11-12 ET, read-only samples of the live capture stores: up to 240 Portal records per relation (source-mirror.sqlite), up to 400 records per relation of the BC, Mission Control, Teams and meetings stores; consecutive versions compared column by column (nested objects flattened, list items by position).",
 "not_declared": {
  "portal_api:public.app_purchase_order_line": "updated_at moves with quantity_received in every sampled pair (sighting share 0.0): a real change each time",
  "portal_api:FileMaker (public.*), sage.*, silver.*": "audit stamps (audittimestampmodified, modificationtimestamp, audtdate/audttime, updated_at) move with business columns in most pairs (sighting share 0.0-0.83)",
  "bc:items/customers/vendors/contacts": "lastModifiedDateTime moves with real edits (sighting share 0.0-0.6)",
  "mission_control:tasks/projects": "sync.ts sighting share 0.01-0.02: tasks really change",
  "meetings:calendar_event": "change_key/last_modified sighting share 0.83 (attendee responses change): below 0.9",
  "meetings:planner_task": "etag sighting share 0.07",
  "teams:channels team.*": "the parent team's fields flap between filled and empty (read with or without permission): not write metadata",
  "sharepoint_list": "the changing columns are the item's ACL (meta.source_acl): permissions, never a stamp"
 },
