{
  "schema": "plx-precedence-evidence/v1",
  "note": "What each record type and field is checked against when its live copies (FileMaker, Portal, Sage, BC) disagree: the downstream records that show what really happened. operating/source_precedence.py measures, on history and read-only, how often each source's value agrees with this evidence across same-record copies; the measured table (not this file) decides which copy is trusted at read time. 'subject' is the type x field the table is keyed by. 'rollup' sums a child field per record when the field lives on lines. Each evidence 'path' step follows links of the named types into ('in') or out of ('out') the record; 'aggregate' combines the evidence values of one source system; 'tolerance_days' widens a date match. No entry names a record, a party or a person.",
  "rules": [
    {"subject": "SalesOrder.total_amount", "type": "SalesOrder", "field": "total_amount",
     "evidence_label": "the posted invoices",
     "path": [{"links": ["SalesInvoice.bills", "SalesInvoice.posted_for_order"], "dir": "in"}],
     "evidence_field": "total_amount", "aggregate": "sum"},
    {"subject": "SalesOrder.subtotal", "type": "SalesOrder", "field": "subtotal",
     "evidence_label": "the posted invoices",
     "path": [{"links": ["SalesInvoice.bills", "SalesInvoice.posted_for_order"], "dir": "in"}],
     "evidence_field": "subtotal", "aggregate": "sum"},
    {"subject": "SalesOrder.required_date", "type": "SalesOrder", "field": "required_date",
     "evidence_label": "the shipments",
     "path": [{"links": ["Shipment.ships"], "dir": "in"}],
     "evidence_field": "ship_date", "aggregate": "min", "tolerance_days": 7},
    {"subject": "SalesOrderLine.ordered_quantity", "type": "SalesOrder",
     "field": "ordered_quantity",
     "rollup": {"links": ["SalesOrderLine.line_of"], "dir": "in"},
     "evidence_label": "the shipments",
     "path": [{"links": ["Shipment.ships"], "dir": "in"},
              {"links": ["ShipmentLine.line_of"], "dir": "in"}],
     "evidence_field": "shipped_quantity", "aggregate": "sum"},
    {"subject": "SalesOrderLine.shipped_quantity", "type": "SalesOrder",
     "field": "shipped_quantity",
     "rollup": {"links": ["SalesOrderLine.line_of"], "dir": "in"},
     "evidence_label": "the shipments",
     "path": [{"links": ["Shipment.ships"], "dir": "in"},
              {"links": ["ShipmentLine.line_of"], "dir": "in"}],
     "evidence_field": "shipped_quantity", "aggregate": "sum"},
    {"subject": "PurchaseOrder.total_cost", "type": "PurchaseOrder", "field": "total_cost",
     "evidence_label": "the posted purchase invoices",
     "path": [{"links": ["PurchaseInvoice.invoices", "PurchaseInvoice.names_order"],
               "dir": "in"}],
     "evidence_field": "subtotal", "aggregate": "sum"},
    {"subject": "PurchaseOrder.expected_date", "type": "PurchaseOrder",
     "field": "expected_date",
     "evidence_label": "the receipts",
     "path": [{"links": ["Receipt.receives"], "dir": "in"}],
     "evidence_field": "received_date", "aggregate": "min", "tolerance_days": 7},
    {"subject": "PurchaseOrderLine.ordered_quantity", "type": "PurchaseOrder",
     "field": "ordered_quantity",
     "rollup": {"links": ["PurchaseOrderLine.line_of"], "dir": "in"},
     "evidence_label": "the receipts",
     "path": [{"links": ["Receipt.receives"], "dir": "in"},
              {"links": ["ReceiptLine.line_of"], "dir": "in"}],
     "evidence_field": "received_quantity", "aggregate": "sum"},
    {"subject": "PurchaseOrderLine.received_quantity", "type": "PurchaseOrder",
     "field": "received_quantity",
     "rollup": {"links": ["PurchaseOrderLine.line_of"], "dir": "in"},
     "evidence_label": "the receipts",
     "path": [{"links": ["Receipt.receives"], "dir": "in"},
              {"links": ["ReceiptLine.line_of"], "dir": "in"}],
     "evidence_field": "received_quantity", "aggregate": "sum"},
    {"subject": "AssemblyOrder.expected_quantity", "type": "AssemblyOrder",
     "field": "expected_quantity",
     "evidence_label": "the production completion records",
     "path": [{"links": ["AssemblyOrderStatusEntry.update_of"], "dir": "in"}],
     "evidence_field": "manufactured_quantity", "aggregate": "sum"},
    {"subject": "AssemblyOrder.ordered_quantity", "type": "AssemblyOrder",
     "field": "ordered_quantity",
     "evidence_label": "the production completion records",
     "path": [{"links": ["AssemblyOrderStatusEntry.update_of"], "dir": "in"}],
     "evidence_field": "manufactured_quantity", "aggregate": "sum"}
  ]
}
