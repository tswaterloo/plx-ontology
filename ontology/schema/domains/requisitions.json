{
 "$schema": "../_format.schema.json",
 "format": "plx-ontology-domain/v1",
 "domain": "requisitions",
 "origin": "curated",
 "description": "Portal purchase requisitions and their lines. Portal-native rows (gold_native_staging). The line estimated cost has two contradicting writers, so it is a finance-marked decimal, not money. No PR-to-PO link: conversion stores no reference.",
 "upstream_pins": {
  "plx-customer-portal": "790256ca43"
 },
 "object_types": [
  {
   "id": "PurchaseRequisition",
   "description": "A Portal purchase requisition (PR-YYYYMMDD-NNNN, UAT- prefixed on UAT): requested materials, optionally for one supplier, approved and then converted to a PO or DPO. The converted PO stores no requisition reference, so no PR-to-PO link is declared.",
   "interfaces": [
    "Document"
   ],
   "anchor": true,
   "availability": {
    "state": "served"
   },
   "bindings": [
    {
     "id": "portal.app_purchase_requisition",
     "source": "portal_api",
     "relation": "public.app_purchase_requisition",
     "key": [
      "id"
     ],
     "lineage": {
      "default": "gold_native_staging"
     },
     "evidence": [
