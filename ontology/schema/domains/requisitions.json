     "evidence": [
      {
       "kind": "ref",
       "id": "prisma.purchase_requisition"
      }
     ]
    },
    {
     "name": "approved_date",
     "value_type": "timestamp",
     "sources": [
      {
       "binding": "portal.app_purchase_requisition",
       "path": "approved_date",
       "parser": "iso_timestamp"
      }
     ],
     "evidence": [
      {
       "kind": "ref",
       "id": "prisma.purchase_requisition"
      }
     ]
    },
