       "kind": "ref",
       "id": "prisma.pr_line_item"
      }
     ]
    },
    {
     "name": "estimated_cost",
     "value_type": "decimal",
     "markings": [
      "finance"
     ],
     "description": "Writers disagree on its meaning: the generate-po route stores a line total and convert divides it by the quantity, the reorder service multiplies it by the quantity as a unit cost. It is therefore not declared as money: never summed, priced or compared.",
     "sources": [
      {
       "binding": "portal.app_pr_line_item",
       "path": "estimated_cost",
       "parser": "decimal_text"
      }
     ],
     "evidence": [
      {
       "kind": "ref",
       "id": "portal.pr_route_estimates"
      },
      {
       "kind": "ref",
       "id": "portal.pr_reorder_estimates"
      },
      {
       "kind": "ref",
       "id": "portal.pr_convert"
      }
     ]
    },
    {
     "name": "notes",
     "value_type": "text",
     "sources": [
      {
       "binding": "portal.app_pr_line_item",
       "path": "notes",
       "parser": "trim"
      }
     ],
     "evidence": [
      {
       "kind": "ref",
       "id": "prisma.pr_line_item"
      }
     ]
    }
   ],
   "evidence": [
    {
     "kind": "ref",
     "id": "prisma.pr_line_item"
    }
   ]
  }
