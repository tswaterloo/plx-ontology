       "kind": "ref",
       "id": "allowlist.public.app_purchase_requisition"
      },
      {
       "kind": "ref",
       "id": "prisma.purchase_requisition"
      },
      {
       "kind": "ref",
       "id": "context.portal.3.5"
      }
     ],
     "note": "Portal-native rows: gold_native_staging, never authority without a human confirmation."
    }
   ],
