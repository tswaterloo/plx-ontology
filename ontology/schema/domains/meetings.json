{
 "$schema": "../_format.schema.json",
 "format": "plx-ontology-domain/v1",
 "domain": "meetings",
 "origin": "curated",
 "description": "Calendar events, meetings, Planner tasks and Teams meeting transcripts captured by integrations/capture_meetings.py and projected by ontology/project_meetings.py MeetingsCaptures (source family meetings). Each record is gated per audience unit (meetings:calendar:<mailbox>, meetings:plan:<plan>, meetings:organizer:<organizer>) and per handle by its captured source ACL (the mailbox owner, the plan's group and people, the meeting's participants) and the people exclusion, re-checked by the case runtime. Their text (event subject and preview, task title and description, transcript speech) is a mention document: an identifier of a PO, vendor or customer named in it is a lead link (ontology/schema.py MEETINGS_MENTION_LINK_RULES). People are Entra object ids and work addresses; a Person is formed per reader by the people graph (no Person object is projected). Source text is untrusted.",
 "object_types": [
  {
   "id": "CalendarEvent",
   "description": "One event on one captured mailbox's calendar (Graph event, the rolling window a year back to 90 days ahead), cited calendar-event://<mailbox>/<event>@<generation>-<capture-id> in the calendar's unit meetings:calendar:<mailbox>; the reader needs that unit and the mailbox owner's ACL (decided per handle). An event naming an excluded person is never captured. Source text is untrusted.",
   "availability": {
    "state": "served"
   },
   "bindings": [
    {
     "id": "meetings.calendar_events",
     "source": "meetings",
     "relation": "calendarEvents",
     "key": [
      "mailbox",
      "id"
     ],
     "lineage": {
      "default": "mail"
     },
     "evidence": [
      {
       "kind": "ref",
       "id": "wb.capture_meetings"
      }
     ]
    }
   ],
