       "kind": "ref",
       "id": "allowlist.public.app_quote_line"
      },
      {
       "kind": "ref",
       "id": "prisma.quote_line"
      }
     ],
     "note": "Lines inherit their quote's lineage (QuoteLine.line_of). A PATCH with lines deletes and recreates every line, so line ids are not stable across edits."
    }
   ],
