       "kind": "ref",
       "id": "prisma.quote"
      },
      {
       "kind": "ref",
       "id": "context.portal.3.12"
      }
     ],
     "note": "Portal-native rows of the served staging replica: gold_native_staging, never authority without a human confirmation."
    }
   ],
