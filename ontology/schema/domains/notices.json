      {
       "binding": "graph_mail.notices",
       "path": "record_type",
       "parser": "trim"
      }
     ],
     "evidence": [
      {
       "kind": "workbench_code",
       "path": "integrations/notice_mail.py"
      }
     ]
    },
    {
     "name": "kind",
     "value_type": "text",
     "description": "The family's declared kind the subject or text matched (e.g. delivered, scheduled, payment received).",
