{
 "$schema": "../_format.schema.json",
 "format": "plx-ontology-domain/v1",
 "domain": "notices",
 "origin": "curated",
 "description": "Notification mail read into records by declared sender families (integrations/notice_mail.py; open-capture-gaps-notice-binding option 1): carrier, payment, support, replenishment, EDI and expense notices. One generic Notice type (its record_type says which) and one NoticeReference per value it names, so shipments, POs, orders, invoices, customer POs, items and customers join by the one identifier grammar. Each record takes its message's version, citation and audience (mail:<mailbox>); payments are finance-marked and expense reports finance and pii, by the bindings' marking rules. Machine-read leads, never business facts.",
 "upstream_pins": {},
 "object_types": [
  {
   "id": "Notice",
   "description": "A notification message from a declared sender family read into a record: its family, record type and kind, the dates and amount it states, and (via NoticeReference) the numbers and names it carries. Cited to the message; visible only to readers of the message's mailbox who hold its markings.",
   "anchor": true,
   "availability": {
    "state": "served"
   },
   "bindings": [
    {
     "id": "graph_mail.notices",
     "source": "graph_mail",
     "relation": "notices",
     "key": [
      "mailbox",
      "message_id"
     ],
     "lineage": {
      "default": "mail"
     },
     "marking_rules": [
      {
       "when": [
        {
         "path": "family",
         "op": "eq",
         "value": "payments"
        }
       ],
       "markings": [
        "finance"
       ],
       "why": "a payment notice is a customer's payment to us: finance (integrations/notice_mail_families.json payments markings)"
      },
      {
       "when": [
        {
         "path": "family",
         "op": "eq",
         "value": "concur"
        }
       ],
       "markings": [
        "finance",
        "pii"
       ],
       "why": "an expense report notice is one person's expenses: finance and personal (notice_mail_families.json concur markings)"
      }
     ],
     "evidence": [
      {
       "kind": "workbench_code",
       "path": "ontology/project.py"
      }
     ],
     "note": "One object per latest captured message version a declared family parses (ontology/project.py MailCaptures notices); same handle, audience and validity interval as the message."
    }
   ],
   "properties": [
    {
     "name": "family",
     "value_type": "text",
     "description": "The declared sender family that read the message (integrations/notice_mail_families.json).",
     "sources": [
      {
       "binding": "graph_mail.notices",
       "path": "family",
       "parser": "trim"
      }
     ],
     "evidence": [
      {
       "kind": "workbench_code",
       "path": "integrations/notice_mail.py"
      }
     ]
    },
    {
     "name": "record_type",
     "value_type": "text",
     "description": "What the notice is: CarrierNotice, PaymentNotice, SupportTicket, ReplenishmentNotice, EdiNotice or ExpenseNotice.",
