    "order_twin_link": "SalesOrder.same_record_as",
    "quantity": "ordered_quantity",
    "done_quantity": "shipped_quantity",
    "outstanding_quantity": "outstanding_quantity",
    "uom": "uom",
    "line_date": "shipment_date",
    "order_date": "required_date",
    "line_preference": ["bc.sales_order_lines", "portal.app_sales_order_line",
                        "portal.fm_order_entry_item", "portal.sage_oe_order_detail"],
    "open": {"status": ["Open", "OPEN"], "fm_status": ["Open"],
             "bc_fully_shipped": ["false"], "sage_complete": ["1", "2"]}
  },
  "supply": {
    "line_type": "PurchaseOrderLine",
    "order_link": "PurchaseOrderLine.line_of",
    "item_link": "PurchaseOrderLine.for_item",
    "order_twin_link": "PurchaseOrder.same_record_as",
    "quantity": "ordered_quantity",
    "done_quantity": "received_quantity",
    "uom": "uom",
    "line_date": "bc_expected_receipt_date",
    "order_date": "expected_date",
    "line_preference": ["bc.purchase_order_lines", "portal.app_purchase_order_line",
