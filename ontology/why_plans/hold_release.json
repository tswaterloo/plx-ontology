 ],
 "verdict": {
  "label": "Hold or release state",
  "claim_terms": [
   "on hold",
   "held",
   "quarantin\\w*",
   "released",
   "not released",
   "expired",
   "expir\\w*",
   "passed",
   "failed",
   "rejected",
   "approved",
   "extended",
   "contaminat\\w*",
   "out of spec\\w*",
   "oos",
   "non.?conform\\w*",
   "retest\\w*"
  ],
  "events": [
   "Batch.released",
   "Batch.quality_status_changed"
  ],
  "missing": "The hold or release decision is not in a record you can see"
 },
 "next_actions": [
  {
   "when": "verdict_missing",
   "text": "Ask Quality for the hold or release decision on {record}, pointing to the test steps above."
  },
  {
   "when": "no_communication",
   "text": "Confirm the decision on {record} with Quality in writing, so the reason is on record."
  },
  {
   "when": "always",
   "text": "Check that the steps above are the latest before acting on {record}."
  }
 ]
