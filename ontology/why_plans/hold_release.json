{
 "format": "plx-why-plan/v1",
 "id": "hold_release",
 "title": "Why a batch or lot is on hold, not released or expired",
 "description": "The batch's or lot's own test, quality-status and release events, the receipt that brought a lot in, the decision records and Mission Control approvals that name it, and the mail and chats about it, in time order. The verdict is the gated claim stating its hold, release or expiry state; else the last release event as recorded; else it is not established.",
 "priority": 10,
 "root_types": [
  "Batch",
  "Lot"
 ],
 "question_terms": [
  "hold",
  "held",
  "on hold",
  "quarantine\\w*",
  "releas\\w*",
  "expir\\w*",
  "test\\w*",
  "fail\\w*",
  "pass\\w*",
  "qc",
  "quality",
  "disposition",
  "extend\\w*",
  "waiver"
 ],
 "root_events": {
  "Batch.manufactured": {
   "kind": "record_change",
   "label": "Batch made"
  },
  "Batch.tested": {
   "kind": "record_change",
   "label": "Batch tested"
  },
  "Batch.quality_status_changed": {
   "kind": "decision",
   "label": "Quality status changed"
  },
  "Batch.released": {
   "kind": "decision",
   "label": "Batch released"
  }
 },
 "links": [
