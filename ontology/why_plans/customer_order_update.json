{
 "format": "plx-why-plan/v1",
 "id": "customer_order_update",
 "title": "What we last told the customer about an order, and whether its dates changed since",
 "description": "The order's own date and status events, its shipments, and the mail, chats and Mission Control approvals naming it, in time order: the last message to or from the customer beside the order's dates. The verdict is the gated claim about what was last said or the current date; a message is cited context, never the order's state.",
 "priority": 20,
 "root_types": [
  "SalesOrder"
 ],
 "question_terms": [
  "told",
  "tell",
  "said",
  "say",
  "last (?:email|message|update)",
  "promis\\w*",
  "ship date",
  "required date",
  "due date",
  "eta",
  "update\\w*",
  "changed",
  "customer",
  "informed",
  "notif\\w*"
 ],
 "root_events": {
  "SalesOrder.created": {
   "kind": "record_change",
   "label": "Order created"
  },
  "SalesOrder.ordered": {
   "kind": "record_change",
   "label": "Order placed"
  },
  "SalesOrder.required": {
   "kind": "record_change",
   "label": "Required date on the order"
  },
  "SalesOrder.fm_required": {
   "kind": "record_change",
   "label": "Required date in FileMaker"
  },
  "SalesOrder.status_changed": {
   "kind": "record_change",
   "label": "Order status changed"
  },
  "Shipment.shipped": {
   "kind": "record_change",
   "label": "Shipped"
  },
  "Shipment.sage_shipped": {
   "kind": "record_change",
   "label": "Shipped (Sage)"
  },
  "SalesInvoice.invoiced": {
   "kind": "record_change",
   "label": "Invoiced"
  },
  "ShipRelease.released": {
   "kind": "decision",
   "label": "Released to ship"
  }
 },
 "links": [
  {
   "link": "mentioned_in_email",
   "kind": "communication",
   "label": "Email",
   "events": [
    "Email.received"
   ],
   "who": "sender",
   "tier_floor": "lead",
   "max": 6
  },
  {
   "link": "mentioned_in_teams_chat_message",
   "kind": "communication",
   "label": "Teams chat message",
   "date_property": "created_at",
   "who": "from",
   "tier_floor": "lead",
   "max": 4
  },
  {
   "link": "mentioned_in_teams_channel_message",
   "kind": "communication",
   "label": "Teams channel message",
   "date_property": "created_at",
   "who": "from",
   "tier_floor": "lead",
   "max": 4
  },
  {
   "link": "mentioned_in_mc_approval",
   "kind": "decision",
   "label": "Mission Control approval decided",
   "events": [
    "MCApproval.decided"
   ],
   "who": "decided_by",
   "tier_floor": "lead",
   "max": 4
  }
 ],
 "verdict": {
  "label": "What was last said and the current date",
  "claim_terms": [
   "told",
   "said",
   "wrote",
   "promis\\w*",
   "ship date",
   "required",
   "due",
   "eta",
   "changed",
   "moved"
  ],
  "events": [
   "SalesOrder.required",
   "SalesOrder.status_changed"
  ],
  "missing": "What the customer was last told is not in a record you can see"
 },
 "next_actions": [
  {
   "when": "no_communication",
   "text": "Draft an update to the customer on {record} with the dates above, for you to review and send."
  },
  {
   "when": "verdict_missing",
   "text": "Check the latest message above against the order's current dates before replying about {record}."
  },
  {
   "when": "always",
   "text": "If the dates above differ from the last message, draft a correction to the customer on {record} for review."
  }
 ]
}
