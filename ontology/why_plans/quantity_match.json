{
 "format": "plx-why-plan/v1",
 "id": "quantity_match",
 "title": "Why the invoice, PO and receipt quantities don't match",
 "description": "The purchase order's issue and expected events, its receipts, vendor invoices, supplier confirmations and posted purchase invoices, and the mail naming it, in time order. The verdict is the gated claim comparing ordered, received and invoiced quantities; a document stays a lead until the gate checks its figure.",
 "priority": 30,
 "root_types": [
  "PurchaseOrder",
  "Receipt"
 ],
 "question_terms": [
  "match\\w*",
  "mismatch\\w*",
  "differ\\w*",
  "discrepan\\w*",
  "three.way",
  "short",
  "over.?(?:shipped|invoiced|received)",
  "invoic\\w*",
  "receiv\\w*",
  "quantit\\w*",
  "count\\w*"
 ],
