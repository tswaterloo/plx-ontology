{
 "format": "plx-why-plan/v1",
 "id": "production_shortfall",
 "title": "Why an assembly order made fewer units than planned, or is behind",
 "description": "The assembly order's schedule, allocation, manufacture and completion events, its status entries and damage entries, the batches it fills from, and the mail, chats, approvals and decision records naming it, in time order. The verdict is the gated claim stating the made, damaged or left quantity, or the cancellation.",
 "priority": 40,
 "root_types": [
  "AssemblyOrder"
 ],
 "question_terms": [
  "short",
  "fewer",
  "less",
  "shortfall",
  "behind",
  "delay\\w*",
  "damag\\w*",
  "scrap\\w*",
  "reject\\w*",
  "yield",
  "made",
  "manufactur\\w*",
  "produc\\w*",
  "left",
  "cancel\\w*",
  "stuck"
 ],
 "root_events": {
  "AssemblyOrder.created": {
   "kind": "record_change",
   "label": "Assembly order created"
  },
  "AssemblyOrder.scheduled": {
   "kind": "record_change",
   "label": "Scheduled"
  },
  "AssemblyOrder.allocated": {
   "kind": "record_change",
   "label": "Materials allocated"
  },
  "AssemblyOrder.committed": {
   "kind": "record_change",
   "label": "Committed"
  },
  "AssemblyOrder.manufactured": {
   "kind": "record_change",
   "label": "Manufactured"
  },
  "AssemblyOrder.realized": {
   "kind": "record_change",
   "label": "Realized"
  },
  "AssemblyOrder.portal_completed": {
   "kind": "record_change",
   "label": "Completed in the Portal"
  },
  "AssemblyOrder.status_changed": {
   "kind": "record_change",
   "label": "Status changed"
  },
  "AssemblyOrder.cancelled": {
   "kind": "decision",
   "label": "Cancelled"
  },
  "AssemblyOrderStatusEntry.entered": {
   "kind": "record_change",
   "label": "Production count entered"
  },
  "AssemblyOrderDamage.entered": {
   "kind": "record_change",
   "label": "Damage entered"
  },
  "ProductionTask.started": {
   "kind": "record_change",
   "label": "Production task started"
  }
 },
 "links": [
  {
   "link": "fills_from",
   "kind": "record_change",
   "label": "Batch released",
   "events": [
    "Batch.released",
    "Batch.tested"
   ],
   "max": 3
  },
  {
   "link": "decision_records",
   "kind": "decision",
   "label": "Decision record",
   "date_property": "decided_on",
   "who": "decided_by",
   "tier_floor": "lead",
   "max": 4
  },
  {
   "link": "mentioned_in_mc_approval",
   "kind": "decision",
   "label": "Mission Control approval decided",
   "events": [
    "MCApproval.decided"
   ],
   "who": "decided_by",
   "tier_floor": "lead",
   "max": 4
  },
  {
   "link": "mentioned_in_email",
   "kind": "communication",
   "label": "Email",
   "events": [
    "Email.received"
   ],
   "who": "sender",
   "tier_floor": "lead",
   "max": 6
  },
  {
   "link": "mentioned_in_teams_chat_message",
   "kind": "communication",
   "label": "Teams chat message",
   "date_property": "created_at",
   "who": "from",
   "tier_floor": "lead",
   "max": 4
  }
 ],
 "verdict": {
  "label": "Made, damaged and left",
  "claim_terms": [
   "manufactured",
   "made",
   "produced",
   "damaged",
   "left",
   "short",
   "fewer",
   "cancel\\w*",
   "remaining"
  ],
  "events": [
   "AssemblyOrder.cancelled"
  ],
  "missing": "A checked count of what was made, damaged or left is not in a record you can see"
 },
 "next_actions": [
  {
   "when": "verdict_missing",
   "text": "Ask Production for the final count on {record}, pointing to the entries above."
  },
  {
   "when": "always",
   "text": "If the shortfall above affects a customer order, draft an update to Customer Service about {record} for review."
  }
 ]
}
