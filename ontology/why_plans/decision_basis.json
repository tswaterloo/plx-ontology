{
 "format": "plx-why-plan/v1",
 "id": "decision_basis",
 "title": "Who decided, when, and on what basis",
 "description": "The Mission Control approvals, decision records and approval events that name the record, the decider and time of each, and the mail and chats around them, in time order. The verdict is the gated claim stating the decision; a decision without a recorded basis says so, and a reason is never inferred from another record.",
 "priority": 60,
 "root_types": [
  "MCApproval",
  "PurchaseOrder",
  "SalesOrder",
  "AssemblyOrder",
  "Batch",
  "Quote",
  "Receipt",
  "SupplierInvoice",
  "PurchaseInvoice"
 ],
 "question_terms": [
  "approv\\w*",
  "decid\\w*",
  "decision",
  "signed off",
  "sign.?off",
  "authori[sz]\\w*",
  "rejected",
  "declined",
  "who (?:approved|decided|signed)",
  "on what basis",
  "basis",
  "justif\\w*"
 ],
