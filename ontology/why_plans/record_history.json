{
 "format": "plx-why-plan/v1",
 "id": "record_history",
 "title": "How we know: the record's history",
 "description": "Any record's own events and the decisions, mail and chats naming it, in time order, for a why or how-do-we-know question no use-case plan covers. The verdict is the gated claim the answer rests on.",
 "priority": 1000,
 "root_types": [
  "*"
 ],
 "question_terms": [],
 "root_events": {
  "*": {
   "kind": "record_change",
   "label": "Recorded"
  }
 },
 "links": [
  {
   "link": "mentioned_in_mc_approval",
   "kind": "decision",
   "label": "Mission Control approval decided",
   "events": [
    "MCApproval.decided"
   ],
   "who": "decided_by",
   "tier_floor": "lead",
   "max": 4
  },
  {
   "link": "decision_records",
   "kind": "decision",
   "label": "Decision record",
   "date_property": "decided_on",
   "who": "decided_by",
   "tier_floor": "lead",
   "max": 4
  },
  {
   "link": "mentioned_in_email",
   "kind": "communication",
   "label": "Email",
   "events": [
    "Email.received"
   ],
   "who": "sender",
   "tier_floor": "lead",
   "max": 6
  },
  {
   "link": "mentioned_in_teams_chat_message",
   "kind": "communication",
   "label": "Teams chat message",
   "date_property": "created_at",
   "who": "from",
   "tier_floor": "lead",
   "max": 4
  },
  {
   "link": "mentioned_in_teams_channel_message",
   "kind": "communication",
   "label": "Teams channel message",
   "date_property": "created_at",
   "who": "from",
   "tier_floor": "lead",
   "max": 4
  }
 ],
 "verdict": {
  "label": "What the answer rests on",
  "claim_terms": [],
  "events": [],
  "missing": "No checked statement answers this from a record you can see"
 },
 "next_actions": [
  {
   "when": "verdict_missing",
   "text": "Ask the owner of {record} for the missing record, pointing to the steps above."
  },
  {
   "when": "always",
   "text": "Open the steps above to check them before acting on {record}."
  }
 ]
}
