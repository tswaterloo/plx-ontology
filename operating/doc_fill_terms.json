{
  "schema": "plx-doc-fill-terms/v1",
  "note": "Which form labels the fill engine (operating/doc_fill.py) fills, and from which ontology properties. A label is matched only when its normalized text equals one listed here; every other label is left blank and flagged. A field names the properties it may be read from; two different values among them leave it blank (ambiguous). Party contact details (an unqualified 'company name', 'address', 'phone', 'email') are not listed: a form usually asks for the filler's own company there, which no record holds. 'person_only' labels are never filled (a signature, who signs, the day it is signed). Nothing here names a record, a party or a person.",
  "hops": {
    "PurchaseOrder": [["PurchaseOrder.ordered_from", "forward", "Supplier"]],
    "PurchaseOrderLine": [["PurchaseOrderLine.line_of", "forward", "PurchaseOrder"],
                          ["PurchaseOrderLine.for_item", "forward", "Product"]],
    "SalesOrder": [["SalesOrder.ordered_by", "forward", "Customer"]],
    "SalesOrderLine": [["SalesOrderLine.line_of", "forward", "SalesOrder"],
                       ["SalesOrderLine.for_item", "forward", "Product"]],
    "Shipment": [["Shipment.ships", "forward", "SalesOrder"],
                 ["Shipment.shipped_to", "forward", "Customer"]],
    "SalesInvoice": [["SalesInvoice.bills", "forward", "SalesOrder"],
                     ["SalesInvoice.billed_to", "forward", "Customer"],
                     ["SalesInvoice.for_shipment", "forward", "Shipment"]],
    "Receipt": [["Receipt.receives", "forward", "PurchaseOrder"],
                ["Receipt.supplied_by", "forward", "Supplier"]],
    "Lot": [["Lot.of_item", "forward", "Product"], ["Lot.received_in", "forward", "Receipt"]],
    "Product": [["Product.owned_by", "forward", "Customer"]]
  },
  "person_only": ["signature", "signed", "signed by", "authorized signature",
                  "authorised signature", "signature of authorized person", "name of signer",
                  "printed name", "print name", "title", "position", "date signed",
                  "signature date", "date", "today's date", "todays date", "initials",
                  "approved by", "prepared by", "completed by", "checked by", "verified by"],
  "fields": [
    {"field": "po_number",
     "labels": ["po", "po number", "po no", "po num", "po#", "po #", "p o", "p o number",
                "purchase order", "purchase order number", "purchase order no",
                "purchase order #", "customer po", "customer po number", "customer po no",
                "customer po #", "customer purchase order", "your po", "your po number",
                "your order number", "buyer po", "buyer's po", "order reference"],
     "from": ["PurchaseOrder.po_number", "SalesOrder.customer_po", "Shipment.customer_po",
              "SalesInvoice.customer_po", "CertificateOfAnalysis.po_reference",
              "PackingSlip.po_reference", "Receipt.po_reference"]},
    {"field": "sales_order_number",
     "labels": ["sales order", "sales order number", "sales order no", "sales order #",
                "so", "so number", "so no", "so #", "so#", "our order number",
                "order number", "order no", "order #", "order#"],
     "from": ["SalesOrder.order_number", "SalesInvoice.order_number"]},
    {"field": "order_date",
     "labels": ["order date", "po date", "date of order", "purchase order date", "date ordered"],
     "from": ["PurchaseOrder.order_date", "SalesOrder.order_date"]},
    {"field": "required_date",
     "labels": ["required date", "date required", "required by", "need by date",
                "requested delivery date", "requested date", "expected date",
                "expected delivery date"],
     "from": ["SalesOrder.required_date", "PurchaseOrder.expected_date"]},
    {"field": "ship_date",
     "labels": ["ship date", "date shipped", "shipping date", "shipment date", "date of shipment"],
     "from": ["Shipment.ship_date", "PackingSlip.ship_date"]},
    {"field": "delivery_date",
     "labels": ["delivery date", "date delivered", "date of delivery"],
     "from": ["Shipment.delivery_date"]},
    {"field": "carrier",
     "labels": ["carrier", "carrier name", "ship via", "shipped via", "freight carrier",
                "shipping carrier", "via"],
     "from": ["Shipment.carrier"]},
    {"field": "tracking_number",
     "labels": ["tracking number", "tracking no", "tracking #", "tracking", "waybill",
                "waybill number", "pro number", "pro no", "pro #"],
     "from": ["Shipment.tracking_number", "PurchaseOrder.tracking_number"]},
    {"field": "incoterms",
     "labels": ["incoterms", "incoterm", "inco terms", "delivery terms", "terms of delivery",
                "shipping terms", "freight terms"],
     "from": ["PurchaseOrder.incoterms", "Supplier.incoterms"]},
    {"field": "currency",
     "labels": ["currency", "currency code", "invoice currency", "order currency"],
     "from": ["PurchaseOrder.currency", "SalesOrder.currency", "SalesInvoice.currency",
              "Receipt.currency"]},
    {"field": "supplier_name",
     "labels": ["vendor", "vendor name", "supplier", "supplier name", "name of supplier",
                "name of vendor", "supplier company name", "vendor company name"],
     "from": ["Supplier.name", "PurchaseOrder.vendor_name", "Receipt.supplier_name",
              "CertificateOfAnalysis.supplier"]},
    {"field": "supplier_number",
     "labels": ["vendor number", "vendor no", "vendor #", "vendor id", "vendor code",
                "supplier number", "supplier no", "supplier #", "supplier id", "supplier code"],
     "from": ["Supplier.code", "PurchaseOrder.vendor_number", "Receipt.vendor_number"]},
    {"field": "customer_name",
     "labels": ["customer", "customer name", "name of customer", "client", "client name",
                "consignee name", "customer company name"],
     "from": ["Customer.name"]},
    {"field": "customer_number",
     "labels": ["customer number", "customer no", "customer #", "customer id",
                "customer code", "customer account number", "customer account"],
     "from": ["Customer.code", "Customer.erp_code", "SalesInvoice.customer_number"]},
    {"field": "invoice_number",
     "labels": ["invoice number", "invoice no", "invoice #", "invoice#", "commercial invoice number",
                "commercial invoice no"],
     "from": ["SalesInvoice.invoice_number"]},
    {"field": "invoice_date",
     "labels": ["invoice date", "date of invoice"],
     "from": ["SalesInvoice.invoice_date"]},
    {"field": "shipment_number",
     "labels": ["shipment number", "shipment no", "shipment #", "shipper number",
                "packing slip number", "packing slip no", "bol number", "bill of lading number",
                "b/l number", "bl number"],
     "from": ["Shipment.shipment_number"]},
    {"field": "lot_number",
     "labels": ["lot", "lot number", "lot no", "lot #", "lot#", "lot code", "batch",
                "batch number", "batch no", "batch #", "batch/lot number", "lot/batch number",
                "batch / lot number", "lot / batch number", "batch code"],
     "from": ["Lot.lot_number", "CertificateOfAnalysis.lot", "ShipmentLine.lot_number"]},
    {"field": "expiry_date",
     "labels": ["expiry date", "expiry", "expiration date", "exp date", "exp", "best before",
                "best before date", "use by date", "retest date"],
     "from": ["Lot.expiry_date", "CertificateOfAnalysis.expiry_date"]},
    {"field": "manufacture_date",
     "labels": ["manufacture date", "manufacturing date", "date of manufacture", "mfg date",
                "production date", "date manufactured"],
     "from": ["CertificateOfAnalysis.manufacture_date"]},
    {"field": "product_code",
     "labels": ["item number", "item no", "item #", "item code", "product code",
                "product number", "product no", "sku", "part number", "part no", "part #",
                "material code", "material number"],
     "from": ["Product.code", "PurchaseOrderLine.item_code", "CertificateOfAnalysis.product_code"]},
    {"field": "product_name",
     "labels": ["product", "product name", "item name", "item description",
                "product description", "material name", "material description",
                "name of product", "trade name"],
     "from": ["Product.name", "CertificateOfAnalysis.product"]},
    {"field": "hs_code",
     "labels": ["hs code", "hs", "hts code", "hts", "hs tariff number", "tariff code",
                "harmonized code", "harmonized tariff code", "harmonized system code",
                "hts number", "commodity code"],
     "from": ["Product.hs_code"]},
    {"field": "unit_of_measure",
     "labels": ["unit of measure", "uom", "unit", "units"],
     "from": ["Product.uom", "PurchaseOrderLine.uom", "SalesOrderLine.uom"]},
    {"field": "ordered_quantity",
     "labels": ["quantity ordered", "ordered quantity", "order quantity", "qty ordered",
                "order qty"],
     "from": ["PurchaseOrderLine.ordered_quantity", "SalesOrderLine.ordered_quantity"]},
    {"field": "shipped_quantity",
     "labels": ["quantity shipped", "shipped quantity", "qty shipped", "total units",
                "number of units"],
     "from": ["Shipment.total_units", "SalesOrderLine.shipped_quantity",
              "ShipmentLine.shipped_quantity"]},
    {"field": "net_weight",
     "labels": ["net weight", "net wt"],
     "from": ["PackingSlip.net_weight"]},
    {"field": "gross_weight",
     "labels": ["gross weight", "gross wt"],
     "from": ["PackingSlip.gross_weight"]},
    {"field": "packages",
     "labels": ["number of packages", "no of packages", "packages", "# of packages",
                "number of cartons", "no of cartons", "cartons"],
     "from": ["PackingSlip.packages"]},
    {"field": "fill_weight",
     "labels": ["fill weight", "fill size", "net fill", "net contents"],
     "from": ["Product.fill_weight"]},
    {"field": "units_per_case",
     "labels": ["units per case", "units per box", "case pack", "pack size", "units/case"],
     "from": ["Product.units_per_box"]},
    {"field": "manufacturer_name",
     "labels": ["manufacturer", "manufacturer name", "name of manufacturer"],
     "from": ["Manufacturer.name"]},
    {"field": "country_of_origin",
     "labels": ["country of origin", "origin", "country of manufacture", "made in", "coo"],
     "from": ["Manufacturer.country"]}
  ]
}
