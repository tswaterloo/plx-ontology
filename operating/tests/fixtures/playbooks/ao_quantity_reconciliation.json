{
  "schema": "plx-case-playbook/v1",
  "id": "ao_quantity_reconciliation",
  "version": 1,
  "question_pattern": "Was assembly order <AO number> produced as ordered for sales order <order number>: planned vs manufactured vs filled vs damaged quantities, and on time?",
  "allowed_tools": [
    "plx.case_open",
    "plx.source_resolve",
    "plx.source_rows",
    "plx.source_citation",
    "plx.case_add_finding",
    "plx.case_compute",
    "plx.case_record_gap",
    "plx.case_attach_original",
    "plx.case_get"
  ],
  "writes_case_state": [
    "plx.case_open",
    "plx.case_add_finding",
    "plx.case_compute",
    "plx.case_record_gap",
    "plx.case_attach_original"
  ],
  "required_evidence": [
    {
      "role": "ao",
      "relation": "public.assembly_order",
      "key_hint": "resolved from the AO literal (e.g. AO-26005B); id is the hop key",
      "identity": {
        "kind": "case_root",
        "fields": [
          "nameamo_c"
        ]
      }
    },
    {
      "role": "order",
      "relation": "public.order_entry",
      "key_hint": "resolved from the order literal (e.g. OR1000151885)",
      "identity": {
        "kind": "case_root",
        "fields": [
          "erpcode"
        ]
      }
    },
    {
      "role": "link",
      "relation": "public.order_entry_item_assembly",
      "key_hint": "idassembly equals the AO id; idoeitem names the order line",
      "identity": {
        "kind": "join",
        "to_role": "ao",
        "field": "idassembly",
        "to_field": "id"
      }
    },
    {
      "role": "line",
      "relation": "public.order_entry_item",
      "key_hint": "id equals the link idoeitem; idoe must equal the order id",
      "identity": {
        "kind": "join",
        "to_role": "link",
        "field": "id",
        "to_field": "idoeitem"
      }
    },
    {
      "role": "item",
      "relation": "silver.assembly_order_items",
      "key_hint": "assembly_order_id equals the AO id",
      "identity": {
        "kind": "join",
        "to_role": "ao",
        "field": "assembly_order_id",
        "to_field": "id"
      }
    },
    {
      "role": "filling",
      "relation": "silver.production_tasks",
      "key_hint": "mo_id equals the AO id and task_type is Filling",
      "identity": {
        "kind": "join",
        "to_role": "ao",
        "field": "mo_id",
        "to_field": "id",
        "fixed": {
          "task_type": "Filling"
        }
      }
    },
    {
      "role": "damage",
      "relation": "silver.assembly_order_damage",
      "key_hint": "assembly_order_id equals the AO id; one or more rows",
      "identity": {
        "kind": "join",
        "to_role": "ao",
        "field": "assembly_order_id",
        "to_field": "id"
      }
    }
  ],
  "required_computations": [
    {
      "name": "planned_minus_manufactured",
      "unit": "EA",
      "expression": "planned - manufactured",
      "inputs": {
        "planned": {
          "role": "item",
          "field": "row.quantity",
          "unit": "EA"
        },
        "manufactured": {
          "role": "item",
          "field": "row.actual_amount",
          "unit": "EA"
        }
      }
    },
    {
      "name": "manufactured_minus_filled",
      "unit": "EA",
      "expression": "manufactured - filled",
      "inputs": {
        "manufactured": {
          "role": "link",
          "field": "row.qtymfg_c",
          "unit": "EA"
        },
        "filled": {
          "role": "filling",
          "field": "row.qty",
          "unit": "EA"
        }
      }
    },
    {
      "name": "damaged_packs",
      "unit": "pack",
      "expression": "sum(damaged)",
      "inputs": {
        "damaged": {
          "role": "damage",
          "field": "row.qty_damaged",
          "unit": "pack",
          "repeat": true
        }
      }
    },
    {
      "name": "ordered_minus_manufactured",
      "unit": "EA",
      "expression": "ordered - manufactured",
      "inputs": {
        "ordered": {
          "role": "line",
          "field": "row.qty",
          "unit": "EA"
        },
        "manufactured": {
          "role": "link",
          "field": "row.qtymfg_c",
          "unit": "EA"
        }
      }
    }
  ],
  "expected_gaps": [
    {
      "id": "chain_unproven",
      "kind": "unknown",
      "about": "Which sales order the AO was produced for, when the cited AO, link, line, item and order rows do not form one id chain",
      "when": "chain_inconsistent",
      "match": {
        "terms": [
          "which sales order"
        ],
        "cites": [
          "ao",
          "link"
        ]
      }
    },
    {
      "id": "dates_unreadable",
      "kind": "unknown",
      "about": "Whether the AO was produced by the required date, when a required, manufactured or filling date is empty or not an ISO date",
      "when": "dates_unreadable",
      "match": {
        "terms": [
          "by the required date"
        ],
        "cites": [
          "order",
          "filling"
        ]
      }
    },
    {
      "id": "late_reason_unknown",
      "kind": "unknown",
      "about": "Why production was recorded after the required date; no cited row gives a reason or an agreed new date",
      "when": "after_required_date",
      "match": {
        "terms": [
          "after the required date"
        ],
        "cites": [
          "ao",
          "order"
        ]
      }
    },
    {
      "id": "header_quantities_empty",
      "kind": "absent_in_source",
      "about": "AO header quantities qtytotal and finalqty; planned and manufactured quantities live only on the item and link rows",
      "when": "field_empty:ao:qtytotal,finalqty",
      "match": {
        "terms": [
          "qtytotal",
          "finalqty"
        ],
        "cites": [
          "ao"
        ]
      }
    },
    {
      "id": "original_scan_not_ingested",
      "kind": "not_ingested",
      "about": "The signed paper AO production record, which no source the Workbench reads holds; an operator attaches it with plx.case_attach_original",
      "when": "always",
      "match": {
        "terms": [
          "original",
          "scan"
        ],
        "cites": [
          "ao"
        ]
      }
    }
  ],
  "authority": {
    "business_writes": 0,
    "approvals": "portal"
  },
  "success_checks": [
    {
      "id": "facts_cite",
      "type": "every_fact_cites"
    },
    {
      "id": "no_uncited_numbers",
      "type": "no_uncited_number_in_statements"
    },
    {
      "id": "ao_cited",
      "type": "evidence_cited",
      "params": {
        "role": "ao"
      }
    },
    {
      "id": "order_cited",
      "type": "evidence_cited",
      "params": {
        "role": "order"
      }
    },
    {
      "id": "link_cited",
      "type": "evidence_cited",
      "params": {
        "role": "link"
      }
    },
    {
      "id": "line_cited",
      "type": "evidence_cited",
      "params": {
        "role": "line"
      }
    },
    {
      "id": "item_cited",
      "type": "evidence_cited",
      "params": {
        "role": "item"
      }
    },
    {
      "id": "filling_cited",
      "type": "evidence_cited",
      "params": {
        "role": "filling"
      }
    },
    {
      "id": "damage_cited",
      "type": "evidence_cited",
      "params": {
        "role": "damage"
      }
    },
    {
      "id": "planned_arith",
      "type": "calculation_equals_cited_arithmetic",
      "params": {
        "calculation": "planned_minus_manufactured"
      }
    },
    {
      "id": "filled_arith",
      "type": "calculation_equals_cited_arithmetic",
      "params": {
        "calculation": "manufactured_minus_filled"
      }
    },
    {
      "id": "damaged_arith",
      "type": "calculation_equals_cited_arithmetic",
      "params": {
        "calculation": "damaged_packs"
      }
    },
    {
      "id": "ordered_arith",
      "type": "calculation_equals_cited_arithmetic",
      "params": {
        "calculation": "ordered_minus_manufactured"
      }
    },
    {
      "id": "scan_gap",
      "type": "gap_recorded",
      "params": {
        "gap": "original_scan_not_ingested"
      }
    },
    {
      "id": "header_gap",
      "type": "gap_recorded",
      "params": {
        "gap": "header_quantities_empty"
      }
    }
  ]
}
