{
  "schema": "plx-autopilot-registry/v1",
  "note": "What the autopilot engine (operating/autopilot.py) watches and prepares. A source maps an object type to the event its new or changed records emit; an autopilot is event type + conditions -> a general handler that prepares work -> business rule -> due. No entry names a record, a party or a person.",
  "limits": {"per_owner_per_hour": 30, "handler_seconds": 20, "cycle_seconds": 240,
             "max_events_per_cycle": 5000},
  "sources": {
    "Email": {"event": "message.received", "time": "received_at"},
    "TeamsChatMessage": {"event": "message.received", "time": "created_at"},
    "TeamsChannelMessage": {"event": "message.received", "time": "created_at"},
    "MCTask": {"event": "task.assigned", "time": "updated_at"},
    "PlannerTask": {"event": "task.assigned", "time": "created_at"},
    "SalesOrder": {"event": "record.changed", "time": "portal_updated_at"},
    "PurchaseOrder": {"event": "record.changed", "time": "portal_updated_at"},
    "Receipt": {"event": "record.changed", "time": "received_date"},
    "Shipment": {"event": "record.changed", "time": "ship_date"},
    "SalesInvoice": {"event": "record.changed", "time": "invoice_date"},
    "Batch": {"event": "qc.result", "time": "released_at"},
    "MCApproval": {"event": "approval.requested", "time": "requested_at"},
    "MCTaskEvent": {"event": "question.asked", "time": "at"},
    "Meeting": {"event": "meeting.ended", "time": "end"}
  },
  "store_events": ["Email.received", "MCTaskEvent.occurred", "MCApproval.requested",
                   "SalesOrder.created", "SalesOrder.ordered", "PurchaseOrder.created",
                   "PurchaseOrder.sage_ordered", "Receipt.sage_received",
                   "Shipment.sage_shipped", "SalesInvoice.invoiced", "Batch.tested",
                   "Batch.released"],
  "value_windows": {"Meeting": "end", "PlannerTask": "created_at",
                    "TeamsChatMessage": "created_at", "TeamsChannelMessage": "created_at"},
  "autopilots": [
    {"id": "customer_po", "label": "Customer PO received", "on": "message.received",
     "when": {"intents_any": ["customer_po"], "intents_none": ["payment_question"],
              "side_in": ["customer", "unknown"]},
     "handler": "order_entry", "owner": "recipient", "due_minutes": 120,
     "done_when": "owner_replied"},
    {"id": "po_followup", "label": "Supplier PO without confirmation", "on": "record.due",
     "params": {"after_days": 2, "window_days": 21},
     "when": {"object_type_in": ["PurchaseOrder"]},
     "handler": "po_followup", "owner": "buyer", "due_minutes": 480,
     "done_when": "owner_replied"},
    {"id": "invoice_send", "label": "Invoice not sent to the customer", "on": "record.due",
     "params": {"window_days": 2},
     "when": {"object_type_in": ["SalesInvoice"]},
     "handler": "invoice_send", "owner": "hinted", "due_minutes": 480,
     "done_when": "owner_replied", "enabled": false,
     "off_reason": "measured 2026-10-06..25: a person mailed 13 of 199 new invoices within 3 days; the rule fired 154 times, 11 right (7%); no customer habit share raised it past 12%"},
    {"id": "routine_update", "label": "Recurring update to colleagues due", "on": "record.due",
     "params": {"lookback_days": 28, "min_sends": 3, "daily_share": 0.6},
     "when": {"object_type_in": ["Email"]},
     "handler": "routine_update", "owner": "hinted", "due_minutes": 480,
     "done_when": "owner_replied"},
    {"id": "rd_status_update", "label": "R&D or sample project waiting on us: status update",
     "on": "record.due", "params": {"idle_business_days": 3, "states": ["waiting_on_us"]},
     "when": {"object_type_in": ["Email"]},
     "handler": "rd_status_update", "owner": "hinted", "due_minutes": 480,
     "done_when": "owner_replied", "enabled": false,
     "off_reason": "measured 2026-10-13 (SQLite gen 11): 32 projects whose customer asked had waited on us 3 or more business days; the owner wrote in the thread within 72 h on none (one later at all). Gen 11 mail carries no customer links, so every party was an outside domain (supplier threads included). Re-measure once mail carries customer links"},
    {"id": "invoice_entry", "label": "Shipment to invoice", "on": "record.due",
     "params": {"window_days": 1},
     "when": {"object_type_in": ["Shipment"]},
     "handler": "invoice_entry", "owner": "hinted", "due_minutes": 480,
     "done_when": "owner_replied"},
    {"id": "shipment_posting", "label": "Order ready to ship: post the shipment",
     "on": "record.due", "params": {"window_days": 1},
     "when": {"object_type_in": ["SalesOrder"]},
     "handler": "shipment_posting", "owner": "hinted", "due_minutes": 480,
     "done_when": "owner_replied"},
    {"id": "cash_application", "label": "Remittance to apply", "on": "record.due",
     "params": {"window_days": 1},
     "when": {"object_type_in": ["Attachment"]},
     "handler": "cash_application", "owner": "hinted", "due_minutes": 480,
     "done_when": "owner_replied"},
    {"id": "supplier_eta", "label": "Supplier states a ship date", "on": "message.received",
     "when": {"side_in": ["supplier"], "intents_none": ["payment_question", "customer_po"]},
     "handler": "supplier_eta", "owner": "recipient", "due_minutes": 480,
     "done_when": "owner_replied"},
    {"id": "desk", "label": "Asked of the owner", "on": "message.received",
     "when": {"asks": true, "mailbox_role": "owner", "addressed_other": false,
              "object_type_in": ["Email"],
              "side_in": ["internal", "customer", "supplier", "unknown"],
              "intents_none": ["customer_po"]},
     "handler": "desk", "owner": "recipient", "due_minutes": 480,
     "done_when": "owner_replied"},
    {"id": "customer_request", "label": "Customer asks for status or documents",
     "on": "message.received",
     "when": {"intents_any": ["status_request", "document_request"],
              "intents_none": ["customer_po", "payment_question"],
              "side_in": ["customer"], "asks": true, "mailbox_role_none": "owner"},
     "handler": "answer_request", "owner": "recipient", "due_minutes": 240,
     "done_when": "owner_replied"},
    {"id": "supplier_delay", "label": "Supplier delay or shortage", "on": "message.received",
     "enabled": false, "off_reason": "until payables data is in the store",
     "when": {"intents_any": ["supplier_delay"], "intents_none": ["payment_question"],
              "side_in": ["supplier"]},
     "handler": "delay_impact", "owner": "recipient", "due_minutes": 240,
     "done_when": "owner_replied"},
    {"id": "approval_request", "label": "Approval requested", "on": "approval.requested",
     "when": {"status_in": ["pending"]},
     "handler": "approval_recommendation", "owner": "approvers", "due_minutes": 1440,
     "done_when": "approval_decided"},
    {"id": "mail_approval_request", "label": "Approval asked in mail", "on": "message.received",
     "when": {"intents_any": ["approval_request"], "mailbox_role_none": "owner",
              "object_type_in": ["Email"],
              "side_in": ["internal", "customer", "supplier", "unknown"]},
     "handler": "approval_recommendation", "owner": "recipient", "due_minutes": 1440,
     "done_when": "owner_replied"},
    {"id": "mc_question", "label": "Asked of you in Mission Control", "on": "question.asked",
     "when": {"open": true},
     "handler": "question_prepare", "owner": "addressee", "due_minutes": 240,
     "done_when": "question_answered"},
    {"id": "task_assigned", "label": "Task assigned", "on": "task.assigned",
     "when": {"assigned": true, "open": true},
     "handler": "task_prepare", "owner": "assignee", "due_minutes": 1440,
     "done_when": "task_closed"},
    {"id": "payment_question", "label": "Invoice or payment question", "on": "message.received",
     "enabled": false, "off_reason": "until payables data is in the store",
     "when": {"intents_any": ["payment_question"], "side_in": ["customer"],
              "asks": true},
     "handler": "ledger_answer", "owner": "recipient", "due_minutes": 240,
     "markings": ["finance"], "done_when": "owner_replied"},
    {"id": "qc_hold", "label": "QC hold or fail", "on": "qc.result",
     "when": {"quality_in": ["On-Hold", "Rejected"], "tested": true},
     "handler": "qc_impact", "owner": "role:quality", "due_minutes": 240,
     "done_when": "batch_released"},
    {"id": "teams_reply", "label": "Someone is waiting on your reply in Teams",
     "on": "message.received",
     "when": {"object_type_in": ["TeamsChatMessage", "TeamsChannelMessage"],
              "engaged_or_asks": true, "closing": false, "intents_none": ["customer_po"],
              "quiet_sender": [3, 0.5, ["internal"]]},
     "handler": "reply_prep", "owner": "recipient", "due_minutes": 240,
     "done_when": "owner_replied"},
    {"id": "teams_group_turn", "label": "Your turn in a group chat",
     "on": "message.received",
     "note": "the first message after the person's own one in a group chat they keep writing in (measured on tuned days 2026-10-06..11-03: they wrote back within 72 h after 94% of them)",
     "when": {"object_type_in": ["TeamsChatMessage"], "to_me": false,
              "after_own_post": [60, 10]},
     "handler": "reply_prep", "owner": "recipient", "due_minutes": 240,
     "done_when": "owner_replied"},
    {"id": "mail_thread_turn", "label": "Asked in a mail thread you keep answering",
     "on": "message.received", "fallback": true,
     "note": "an ask in a mail thread the person wrote in twice or more in 14 days, with two or more people copied (measured on tuned days 2026-10-13..27, R&D, purchasing and the owner: they answered in the thread within 72 h after 47 of 49)",
     "when": {"object_type_in": ["Email"], "asks": true, "closing": false,
              "addressed_other": false, "engaged_or_asks": true, "cc_min": 2,
              "after_own_post": [20160, 2],
              "quiet_sender": [3, 0.5, ["internal"]], "intents_none": ["customer_po"],
              "side_in": ["internal", "customer", "supplier", "unknown"]},
     "handler": "reply_prep", "owner": "recipient", "due_minutes": 480,
     "done_when": "owner_replied"},
    {"id": "reply_prep", "label": "Someone is waiting on your reply", "on": "message.received",
     "fallback": true,
     "when": {"object_type_in": ["Email"],
              "engaged_or_asks": true, "closing": false, "addressed_other": false,
              "quiet_sender": [3, 0.5, ["internal"]], "intents_none": ["customer_po"],
              "side_in": ["internal", "customer", "supplier", "unknown"]},
     "handler": "reply_prep", "owner": "recipient", "due_minutes": 480,
     "done_when": "owner_replied"},
    {"id": "meeting_followup", "label": "Meeting ended", "on": "meeting.ended",
     "when": {"ended": true, "organizer_copy": true, "external_or_linked": true},
     "handler": "meeting_followup", "owner": "organizer", "due_minutes": 1440,
     "done_when": "owner_mailed_attendees"}
  ]
}
