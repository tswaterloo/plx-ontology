{
  "schema": "plx-workflows/v1",
  "note": "The company's recurring workflows (the work graph's section 1) as keyword families over a message's or task's subject and text. A prepared autopilot item and a person's real action are both put in one workflow, so the replay scores each workflow of each role on its own. No entry names a record, a party or a person; the order of 'workflows' is the priority order (the first that holds wins).",
  "families": {
    "po": "\\b(?:purchase order|p\\.?\\s?o\\.?\\s?#|po\\s?#?\\s?\\d{3,}|new order|order placed|place (?:an|the|this) order|blanket order|release order)",
    "order_ack": "order (?:confirmation|acknowledg|received|entered)|sales order|\\bso\\s?#?\\s?\\d{3,}|order #|confirm(?:ing|ation of)? (?:the |your )?order",
    "status_q": "what'?s the status|status (?:update|of|on)|any update|\\beta\\b|where is (?:my|our|the)|when will|expected (?:date|delivery|ship)|tracking (?:number|info)",
    "ship": "\\bshipped\\b|shipping (?:notice|confirmation|docs|documents)|tracking|\\bbol\\b|bill of lading|\\basn\\b|pick ?up|delivery appointment|dispatch|freight (?:quote|booking)|\\bltl\\b|carrier|pallet|packing (?:slip|list)",
    "invoice": "\\binvoice",
    "pay_ar": "past due|overdue|statement of account|account statement|payment reminder|outstanding (?:balance|invoice)|credit hold|collections?\\b",
    "remit": "remittance|payment advice|\\beft\\b|\\bach\\b|wire (?:transfer|confirmation)|payment (?:sent|received|confirmation)|cheque|check run|payment run",
    "quote": "\\bquot(?:e|ation)|\\brfq\\b|pricing|price (?:list|increase|change|request)",
    "rnd": "\\bsamples?\\b|formula|stability|tech(?:nical)? transfer|\\bbrief\\b|prototype|r&d|\\brnd\\b|new product development|\\bnpd\\b|fragrance|reformulat",
    "qc": "\\bcoa\\b|c of a|certificate of analysis|lab results?|test results?|\\bqc\\b|\\bqa\\b|on hold|quality hold|deviation|\\bncr\\b|non-?conform|spec(?:ification)? sheet|\\bsds\\b",
    "cert": "certificat|audit|questionnaire|kosher|halal|organic|\\bgmp\\b|\\bsqf\\b|\\bbrc\\b|\\bcoi\\b",
    "prod": "production (?:schedule|plan|run|update)|\\bbatch(?:es)?\\b|work order|assembly order|\\bblend|filling|manufactur",
    "materials": "shortage|short (?:on|of)|backorder|back order|stock[- ]?out|out of stock|component|allocation|inventory|on hand|materials?\\b",
    "sup_eta": "\\bcontainer\\b|booking|vessel|arrival|in transit|lead time|ready (?:date|to ship)|ship date|delivery date|\\beta\\b",
    "receive": "\\breceived\\b|receiving|delivered|\\bgrn\\b|goods receipt|put ?away|delivery (?:note|receipt)",
    "label": "artwork|\\blabels?\\b|proof|\\bupc\\b|barcode|die ?line|print(?:er)? (?:proof|approval)",
    "approval": "\\bapprov(?:e|al|ed)\\b|sign[- ]off|authori[sz]",
    "report": "\\breport\\b|\\bkpi\\b|dashboard|weekly (?:update|summary)|daily (?:update|summary)|month[- ]end|week ending|forecast",
    "meeting": "^(?:re: |fw: )?(?:invitation|accepted|declined|tentative|updated invitation|canceled|cancelled)[: ]|meeting|teams meeting"
  },
  "workflows": [
    {"id": "cash_remittance", "any": ["remit"]},
    {"id": "ar_collections", "any": ["pay_ar"]},
    {"id": "ap_supplier_invoice", "any": ["invoice"], "side_in": ["supplier"]},
    {"id": "ar_invoice_send", "any": ["invoice"], "side_in": ["customer", "internal_out"]},
    {"id": "rnd_sample_project", "any": ["rnd"]},
    {"id": "label_artwork", "any": ["label"]},
    {"id": "coa_cert_doc_request", "any": ["qc", "cert"], "external": true},
    {"id": "customer_order_intake", "any": ["po", "order_ack"], "side_in": ["customer"]},
    {"id": "customer_status_inquiry", "any": ["status_q"], "side_in": ["customer"]},
    {"id": "quote_pricing", "any": ["quote"], "external": true},
    {"id": "purchase_order_to_supplier", "any": ["po"], "side_in": ["supplier", "internal_out"]},
    {"id": "supplier_eta_receiving", "any": ["sup_eta", "receive", "materials"], "external": true},
    {"id": "shipping_freight", "any": ["ship"], "external": true},
    {"id": "qc_hold_release_internal", "any": ["qc"], "external": false},
    {"id": "production_materials_internal", "any": ["prod", "materials"], "external": false},
    {"id": "internal_approval", "any": ["approval"], "external": false},
    {"id": "external_approval", "any": ["approval"], "external": true},
    {"id": "reporting", "any": ["report"]},
    {"id": "meeting_admin", "any": ["meeting"]}
  ],
  "fallback": {"external": "other_external", "internal": "other_internal"},
  "autopilot_workflow": {
    "customer_po": "customer_order_intake",
    "po_followup": "purchase_order_to_supplier",
    "supplier_eta": "supplier_eta_receiving",
    "supplier_delay": "supplier_eta_receiving",
    "qc_hold": "qc_hold_release_internal",
    "approval_request": "internal_approval",
    "meeting_followup": "meeting_admin",
    "payment_question": "ar_collections"
  },
  "record_workflow": {
    "SalesOrder": "customer_order_intake",
    "CustomerPurchaseOrder": "customer_order_intake",
    "PurchaseOrder": "purchase_order_to_supplier",
    "Receipt": "supplier_eta_receiving",
    "SupplierConfirmation": "supplier_eta_receiving",
    "Shipment": "shipping_freight",
    "SalesInvoice": "ar_invoice_send",
    "SupplierInvoice": "ap_supplier_invoice",
    "Payment": "cash_remittance",
    "Quote": "quote_pricing",
    "Batch": "qc_hold_release_internal",
    "CertificateOfAnalysis": "coa_cert_doc_request",
    "AssemblyOrder": "production_materials_internal",
    "MCApproval": "internal_approval",
    "Meeting": "meeting_admin"
  }
}
