{
  "schema": "plx-autopilot-write-rules/v1",
  "note": "What an autopilot may do by itself once its workflow's write gate is live (operating/autopilot_write.py). Conservative by construction: an action kind, operation or MC approval scope not listed here is never routine; every term class an action names refuses it when its text matches; every payload field whose name holds a deny_fields fragment refuses it. Nothing here names a record, a party or a person.",
  "fresh_from": "2026-11-06T07:00:00Z",
  "tuned_windows": [
    {"from": "2026-07-08T00:00:00Z", "until": "2026-10-05T00:00:00Z",
     "why": "activity of the 90 days before 2026-10-06 was read to set the activity roles' thresholds (autopilot-6, 2026-11-10)"},
    {"from": "2026-10-05T00:00:00Z", "until": "2026-11-06T07:00:00Z",
     "why": "tuning and dev replays 10-06..11-05 (autopilot-4..9, ap-teams, ap-selfmail, ap-mc-tasks, ap-gaps2), receivables entry dev 10-05..10-25 (ap-sage-ar), Vince's day map 10-06..11-05; the held-out set 10-26..11-05 was looked at while tuning"}
  ],
  "clean_windows": [
    {"id": "past-2026-05-06", "from": "2026-05-04T07:00:00Z", "until": "2026-07-08T00:00:00Z",
     "evidence": "no replay, judging file, tuning run or role probe of any autopilot lane covers these days: every replay result window under /data/scratch is from 2026-10-06 on, the earliest days any lane read are the role probe's 2026-07-08 (wave-autopilot 2026-11-11); owner rule 2026-11-11 9:10 PM ET: past days never tuned on count like fresh days"}
  ],
  "gate": {"precision": "0.9", "min_judged": 15},
  "rate_limits": {"per_hour": 5, "per_day": 20, "workflows": {},
                  "approved": {"per_hour": 30, "per_day": 200}},
  "contested_workflows": [],
  "term_classes": {
    "money": ["\\bpay(?:s|ing|ment|ments|out|outs|able|ables)?\\b", "\\brefund\\w*",
              "\\bwire[sd]?\\b", "\\bremit\\w*", "\\bdeposits?\\b", "\\bwrite[- ]?offs?\\b",
              "\\bcharge ?backs?\\b", "\\bcredit (?:memo|note)s?\\b", "\\bACH\\b", "\\bEFT\\b",
              "[$€£]\\s?\\d", "\\b(?:USD|CAD|EUR|GBP)\\s?\\d", "\\binvoic\\w*",
              "\\bbalance due\\b", "\\bamount due\\b", "\\bpast due\\b", "\\bcollections?\\b"],
    "price": ["\\bpric(?:e|es|ed|ing)\\b", "\\bunit cost\\b", "\\bdiscount\\w*", "\\brebates?\\b",
              "\\bsurcharges?\\b", "\\bmark-?ups?\\b", "\\bmargins?\\b", "\\bquot(?:e|es|ed|ation)\\b"],
    "credit": ["\\bcredit\\b", "\\bpayment terms\\b", "\\bnet ?\\d{2}\\b"],
    "permission": ["\\bpermissions?\\b", "\\baccess\\b", "\\broles?\\b", "\\bgrant\\w*",
                   "\\badmin\\w*", "\\bsecrets?\\b", "\\bcredentials?\\b", "\\bapi[ _-]?keys?\\b",
                   "\\btokens?\\b", "\\bpassword\\w*", "\\bsso\\b", "\\bentra\\b"],
    "migration": ["\\bmigrat\\w*", "\\bschema\\b", "\\bcut-?over\\b", "\\bbackfill\\w*",
                  "\\bdrop (?:table|column)\\b", "\\brestore\\b"],
    "production_change": ["\\bproduction\\b", "\\bprod\\b", "\\bdeploy\\w*", "\\bgo[- ]live\\b",
                          "\\bmerge\\w*", "\\bhotfix\\w*", "\\brollback\\w*", "\\bfeature flags?\\b",
                          "\\bflags?\\b"],
    "new_party": ["\\bnew (?:customer|vendor|supplier|account|client)s?\\b", "\\bonboard\\w*",
                  "\\bset ?up (?:a |the )?(?:customer|vendor|supplier|account)\\b"],
    "legal_or_people": ["\\bcontract\\w*", "\\blegal\\b", "\\blawyer\\w*", "\\bterminat\\w*",
                        "\\bsalar\\w*", "\\bpayroll\\b", "\\bhir(?:e|ing)\\b", "\\bfir(?:e|ing)\\b"]
  },
  "deny_fields": ["price", "cost", "amount", "credit", "discount", "payment", "terms", "currency",
                  "tax", "balance", "total", "limit", "blocked", "bank", "salary", "rate"],
  "actions": {
    "mc_approval": {
      "label": "Approve a routine Mission Control gate",
      "scope_kind_in": ["launch"],
      "recommendation_in": ["approve"],
      "deny_term_classes": ["money", "price", "credit", "permission", "migration",
                            "production_change", "new_party", "legal_or_people"]
    },
    "mc_task": {
      "label": "Routine Mission Control task note or label/title/priority update",
      "operations": {
        "task_note": {},
        "task_update": {"require_precondition": "prior"}
      },
      "note": "Never money, prices, credit, permissions or judgment calls: every such term class refuses the action.",
      "deny_term_classes": ["money", "price", "credit", "permission", "migration",
                            "production_change", "new_party", "legal_or_people"]
    },
    "send_mail": {
      "label": "Send the prepared email",
      "max_recipients": 3,
      "known_domains_only": true,
      "deny_term_classes": ["money", "price", "credit", "permission", "new_party",
                            "legal_or_people"]
    },
    "send_teams": {
      "label": "Post the prepared Teams message",
      "deny_term_classes": ["money", "price", "credit", "permission", "new_party",
                            "legal_or_people"]
    },
    "bc_write": {
      "label": "Business Central entry",
      "operations": {
        "sales_order_create": {"require_precondition": "party", "max_lines": 20},
        "sales_order_line_create": {"require_precondition": "document"},
        "sales_order_comment": {"require_precondition": "document"},
        "purchase_order_comment": {"require_precondition": "document"}
      },
      "note": "A new purchase order or a purchase line change commits spend: not routine. Lines carry no price (BC prices them from the item card); any price, cost or discount field refuses the action.",
      "deny_term_classes": ["money", "price", "credit", "new_party", "legal_or_people"]
    },
    "sage_write": {
      "label": "Sage 300 entry",
      "operations": {},
      "note": "The Sage integration has no write path (Sage is read through the Portal reporting replica), and every Sage entry an autopilot prepares (invoice entry, shipment posting, cash application) moves money: none is routine.",
      "deny_term_classes": ["money", "price", "credit", "new_party"]
    },
    "portal_write": {
      "label": "Customer Portal entry",
      "operations": {
        "sales_order_set_customer_po": {"require_precondition": "prior"}
      },
      "deny_term_classes": ["money", "price", "credit", "new_party"]
    },
    "filemaker_write": {
      "label": "FileMaker entry",
      "operations": {
        "record_create": {},
        "record_edit": {"require_precondition": "mod_id"}
      },
      "deny_term_classes": ["money", "price", "credit", "new_party"]
    },
    "planner_write": {
      "label": "Planner task create or update",
      "operations": {
        "task_create": {},
        "task_update": {"require_precondition": "prior"}
      },
      "deny_term_classes": ["money", "price", "credit", "permission", "new_party",
                            "legal_or_people"]
    },
    "calendar_write": {
      "label": "Event in the owner's own calendar",
      "operations": {
        "event_create": {"known_domains_only": true},
        "event_update": {"require_precondition": "prior"}
      },
      "deny_term_classes": ["money", "price", "credit", "permission", "new_party",
                            "legal_or_people"]
    },
    "sharepoint_write": {
      "label": "SharePoint list item create or update",
      "operations": {
        "list_item_create": {"known_domains_only": true},
        "list_item_update": {"require_precondition": "prior"}
      },
      "note": "A file upload is never routine (its content is not read here): only a person approves one.",
      "deny_term_classes": ["money", "price", "credit", "permission", "new_party",
                            "legal_or_people"]
    }
  }
}
