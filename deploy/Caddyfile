# PLX Workbench: one HTTPS origin for the web app and its API.
#
#   https://<host>/api/*  -> operator_api (Python, 127.0.0.1:8780)
#   https://<host>/*      -> the Next.js app (127.0.0.1:3000)
#
# Same origin on purpose: the API's session cookie is Path=/api, SameSite=Strict,
# and its POST routes refuse a foreign Origin.
#
# Host: the machine's Tailscale name first (PLX_APP_HOST, e.g. <machine>.<tailnet>.ts.net).
# Caddy gets the certificate for a *.ts.net name from the local tailscaled
# automatically (tailscaled needs TS_PERMIT_CERT_UID=caddy, see deploy/README.md).
# A staff domain later is a second site block below; Caddy then gets a public
# certificate for it (ACME) once DNS points here.
#
# Validate: caddy validate --config deploy/Caddyfile --adapter caddyfile
{
	# Listen ONLY on loopback and this machine's Tailscale addresses: never on a
	# public interface. PLX_BIND_ADDRS (set in /etc/plx/workbench-caddy.env from
	# `tailscale ip -4` and `tailscale ip -6`) adds the Tailscale addresses;
	# unset, Caddy binds loopback alone. Applies to every listener, including
	# the HTTP->HTTPS redirect.
	default_bind 127.0.0.1 {$PLX_BIND_ADDRS}

	# The HTTP->HTTPS redirect is declared below (not implicit), so `caddy adapt`
	# shows every listener there is.
	auto_https disable_redirects

	# No access log by default: request lines carry questions and record ids.
	# The admin API rebinds every listener and carries no auth, so it is a unix socket
	# only the caddy user can open (a TCP port on loopback is open to every local
	# account). `caddy reload` (ExecReload) reads this address from the file.
	admin unix//var/lib/caddy/admin.sock|0600
	servers {
		protocols h1 h2
	}
}

(plx_workbench) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# The API, including the /api/ask answer stream (text/event-stream).
	# The API returns JSON or an event stream only: nothing on it may run script.
	# flush_interval -1 sends every event as it is written; no compression on
	# this path so nothing buffers the stream.
	handle /api/* {
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		# a deploy's readiness probe (/api/ready) is for loopback only, never served here
		@ready path /api/ready
		respond @ready 404
		# JSON answers compressed (11-21: Home ~260 KB of JSON, Team's labour 355 KB; 6-18x
		# smaller) for a reader on the tailnet; only JSON, so the Ask's event stream is
		# never held back in a compressor's buffer
		encode zstd gzip {
			match {
				header Content-Type application/json*
			}
		}
		# Which API serves (ARCH-T6, deploy/release/plx-release): 127.0.0.1:8780
		# (plx-api.service), and when it takes no connection the deploy's standby
		# (plx-api@standby), which serves only on its unix socket in a directory nobody but
		# the API's own user can write: no dev or mock API anyone starts can be sent readers.
		# A deploy starts the standby held until warm, restarts 8780 held the same way (it
		# closes its port, ends what is under way, exits; readers go to the standby) and stops
		# the standby once 8780 serves again. A request that cannot connect to one is sent to
		# the other (nothing was sent yet, so any request may go again); one that refused is
		# passed over for 2 s. Caddy is never reloaded for it: a reload drops requests under
		# way (measured: 6-12 in 30 reloads at ~350 requests/s).
		reverse_proxy {$PLX_API_UPSTREAM:127.0.0.1:8780} {$PLX_API_STANDBY:unix//run/plx-api-standby/api.sock} {
			lb_policy first
			lb_try_duration 15s
			lb_try_interval 50ms
			fail_duration 2s
			flush_interval -1
			transport http {
				dial_timeout 5s
				response_header_timeout 120s
			}
		}
	}

	# The desktop app's update feed (desktop/README.md "Updates"): installers and the
	# generated latest*.yml, copied by hand into PLX_DESKTOP_FEED (the caddy user needs read
	# access). Files only, nothing proxied; before the catch-all so the web app never sees it.
	handle_path /desktop/* {
		root * {$PLX_DESKTOP_FEED:/data/plx-desktop-feed}
		# the feed's index.html download page carries its own <style>: styles may be inline,
		# nothing else loads or runs (no script, no frame, no form)
		header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		file_server
	}

	# Everything else is the web app.
	handle {
		encode zstd gzip
		reverse_proxy {$PLX_APP_UPSTREAM:127.0.0.1:3000}
	}

	handle_errors {
		respond "The Workbench is restarting or unreachable. Try again in a minute." {err.status_code}
	}
}

{$PLX_APP_HOST:localhost} {
	import plx_workbench
}

http://{$PLX_APP_HOST:localhost} {
	redir https://{host}{uri} permanent
}

