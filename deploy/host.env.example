# Copy to ~/.config/plx/deploy.env on the host and fill in. Read by deploy/lib.sh and
# deploy/render.py. Never commit the filled-in copy (it names the host user).
PLX_USER=<host user that owns /data/plx-state>
PLX_GROUP=<its group>
PLX_HOME=/home/<host user>
PLX_HOSTNAME=<tailnet host name, for the demo link>
PLX_REPO=/data/OntologyProject
PLX_RELEASES=/data/plx-releases
PLX_STATE=/data/plx-state
PLX_VENV=/data/venv
PLX_NODE=/data/tools/node
PLX_SCRATCH=/data/scratch
