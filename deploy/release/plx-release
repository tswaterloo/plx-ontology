#!/bin/bash
# One release for every unit: each commit is unpacked once into its own directory under
# $PLX_RELEASES, every unit runs from $PLX_RELEASES/current (a symlink), the switch is one
# atomic rename, and the previous release stays one command away.
#
#   plx-release build <ref> [--overlay <commit>:<path>]... [--node-modules-from DIR]
#                           [--no-app] [--no-schema-check]
#       Cut a release from <ref> of $PLX_REPO (read only: git archive, nothing checked out).
#       --overlay takes <path> from <commit> instead (the held-back schema files while a
#       generation on the old schema is served). The release's schema digest must equal the
#       served projection's (store_meta schema_digest; in Postgres mode, PLX_ONTOLOGY_PG=only,
#       the release's own `operating.pg.ontology_migrate check` must say ok: Postgres holds
#       its schema and step code), else nothing is built. The app is
#       built inside the release; node_modules is hard-linked from the current release when
#       app/package-lock.json is unchanged (else npm ci). Prints the release id.
#   plx-release preflight <id>  the API's configuration check of <id> (plx-api-check@<id>:
#                               `operator_api serve --check` under the API's own user,
#                               environment and drop-ins); exit 1 when it fails
#   plx-release migrate <id>    Postgres mode: apply the release's pending operating.pg
#                               migrations from its own tree (none pending: a no-op). Refused
#                               (exit 75, nothing applied) while a migration window is open:
#                               $PLX_STAGE_FILE names stage A/B/D (or no stage), a lock in
#                               $PLX_MIGRATION_LOCKS is held, or a migration process runs. A
#                               failed apply raises the host alarm (exit 1). DEPLOY-MIG 11-15.
#   plx-release switch <id>     preflight, then current -> <id>, previous -> the old current
#                               (atomic). A failed preflight switches nothing, nor does (in
#                               Postgres mode) a migration of <id> that Postgres does not hold.
#   plx-release rollback        current -> previous (and previous -> the one rolled back)
#   plx-release restart [--with-ingest] [--cold]
#       Restart (start when stopped: the API and the app are always up, 11-14) plx-api and
#       plx-app, and the other long-running units that are active (try-restart) so they load
#       current (the job-queue worker too: it starts no job process itself and a restarted
#       worker adopts the running jobs; 11-13 it served from a release 6 h old); timer-driven
#       units (delta, proactive, truth check, AI watcher, backup) pick it up on their next
#       run. A serving API is never restarted cold (ARCH-T6, "Warm switch" below): --cold (or
#       a host without the warm switch installed) restarts it in place. plx-ingest restarts
#       only with --with-ingest, as a drain restart: SIGTERM to the host process alone, which
#       starts no capture and lets each running child end its run at a safe point (cursor
#       kept, outcome recorded) within ingest.drain_seconds, then exits; the unit then starts
#       on current. No capture gap is needed (perm-capture-1114).
#       Then /api/health must answer 200 and one authenticated read (/api/me through the
#       Ask canary's service session: sudo plx-mint-link --canary into its own link file, the
#       ticket never printed; the owner's link file is never touched) must answer 200,
#       and (Postgres mode) no migration of the current release may be pending.
#       On a failure (or a warm switch that did not switch) it rolls back by itself: switches
#       to previous, restarts, checks again and raises a host alarm (unit_alarm.py raise:
#       /var/lib/plx-ops/status.json, which the notifier reads), then exits 1. Needs sudo;
#       the operator and the deploy step run it.
#       PLX_RELEASE_PREFLIGHT=required / PLX_RELEASE_AUTH_PROBE=required refuse when the
#       check unit / plx-mint-link is not installed (default: checked when installed, the
#       skip logged); PLX_RELEASE_AUTH_PROBE=0 skips the authenticated read. An installed
#       plx-mint-link without --canary is first refreshed from the serving sealed release;
#       if it still lacks it the read is skipped (logged), never done through the owner link.
#   plx-release deploy <id>     migrate, switch to <id> and restart (a release that does not serve is
#                               rolled back by the restart, exit 1)
#   plx-release slots [sync]    the warm switch's state (serving port, why it is off);
#                               sync: mirror plx-api.service's drop-ins for plx-api@.service
#   plx-release status | list | prune [--keep N]
#   plx-release verify [<id>]   the release (default: current) is sealed: every file owned by
#                               $PLX_RELEASE_OWNER, none writable by group or others (exit 1)
#
# Sealed releases (SEC-S-12): with PLX_RELEASE_OWNER set (deploy/lib.sh default: root) the
# build itself runs as the calling user in $PLX_RELEASES/.staging (git archive, npm, next
# build: no repo code ever runs as root), then `sudo -n` seals it: owned by root, nothing
# writable by anyone else, readable by every unit's user (code holds no secret), renamed into
# place. Switch, prune and the history log need the same sudo; the API's user can read a
# release and change nothing in it. PLX_RELEASE_OWNER= (empty) keeps the old unsealed
# releases (tests, a dev box).
#
# Warm switch (ARCH-T6): a restart never routes a reader to a cold API, and Caddy is not
# reloaded for it (a reload drops requests under way). Caddy sends /api/* to 127.0.0.1:8780
# (plx-api.service) and, when that takes no connection, to the standby plx-api@standby, which
# serves only on its unix socket ($PLX_API_STANDBY_SOCKET, /run/plx-api-standby/api.sock, in a
# directory only the API's user may write: no other listener can be sent readers). A restart
# writes $PLX_API_HOLD_DIR/hold-plx-api-standby (an API started then opens its socket or port
# only once warm: operator_api/server.py), starts plx-api@standby on current and waits for its
# /api/health and /api/ready (its known readers' Today and main screens read ahead and kept
# under the new code version, at most $PLX_API_READY_S, 660 s); then restarts plx-api.service
# held the same way (SIGTERM: it closes 8780 and ends what is under way, so Caddy sends the
# next request to the standby), waits for it, and stops the standby once Caddy sends to 8780
# again. plx-api.service is the serving unit again at the end, so every tool that starts,
# stops or reads plx-api and $PLX_API_URL keeps working. A standby that is not ready is
# stopped and the old API keeps serving (exit 1: the deploy rolls back). Before it starts:
# plx-api@.service is installed, its drop-ins mirror plx-api.service's (synced here) and every
# setting that decides what the API may do is the same for both, the host has memory and
# Postgres has sessions for a second API, and the running Caddy sends to the standby's
# socket; any of these missing, the API restarts in place (cold) and the reason is printed
# and logged ("warm switch off"). deploy/release/README-warm-switch.md: host install, undo.
#
# Settings: deploy/lib.sh (PLX_REPO, PLX_RELEASES, PLX_STATE, PLX_VENV, PLX_NODE,
# PLX_RELEASE_OWNER, PLX_API_URL).
set -euo pipefail
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
. "$here/../lib.sh"
LONG_RUNNING="plx-api plx-app plx-search-follow plx-search-generation plx-rag-backfill plx-jobq-worker"
ALWAYS_UP="plx-api plx-app"     # started by every restart, stopped or not (Fable 11-14 #2)
HOST_OPS=${PLX_HOST_OPS:-/var/lib/plx-ops}
API_UNIT=${PLX_API_UNIT:-plx-api}
API_PORT=${PLX_API_PORT:-$(sed -n 's|^https\{0,1\}://[^/]*:\([0-9][0-9]*\).*|\1|p' <<<"$PLX_API_URL")}
API_PORT=${API_PORT:-8780}
STANDBY=${PLX_API_STANDBY:-standby}               # plx-api@standby
STANDBY_SOCKET=${PLX_API_STANDBY_SOCKET:-/run/plx-api-$STANDBY/api.sock}
STANDBY_HOLD=$(basename "$(dirname "$STANDBY_SOCKET")")   # its hold file's name (server.py)
HOLD_DIR=${PLX_API_HOLD_DIR:-/run/plx-api}        # hold-<port>: open it only once warm
CADDY_UNIT=${PLX_CADDY_UNIT:-plx-caddy}
CADDY_ADMIN=${PLX_CADDY_ADMIN:-/var/lib/caddy/admin.sock}   # the caddy user's 0600 socket
CADDY_USER=${PLX_CADDY_USER:-caddy}
PASS_OVER_S=${PLX_API_PASS_OVER_S:-3}            # > Caddy's fail_duration (2 s)
UNIT_DIR=${PLX_SYSTEMD_DIR:-/etc/systemd/system}
# past the API's own hold limit (operator_api/server.py HOLD_MAX_SECONDS, 600 s): a 300 s wait
# gave up on a standby still warming (11-15 7:18 AM ET: briefing read 145 s) and rolled back
READY_S=${PLX_API_READY_S:-660}
MEM_RESERVE_MB=${PLX_API_MEM_RESERVE_MB:-2048}   # left on the host with both APIs up
MEM_FLOOR_MB=${PLX_API_MEM_FLOOR_MB:-1024}       # a standby is stopped below this
PG_MARGIN=${PLX_API_PG_MARGIN:-8}                # sessions left to everyone else
API_ROLE=${PLX_API_PG_ROLE:-plx_api}
MEMINFO=${PLX_MEMINFO:-/proc/meminfo}
PROC=${PLX_PROC:-/proc}                          # prune skips releases a process runs in
CGROUP_ROOT=${PLX_CGROUP_ROOT:-/sys/fs/cgroup}
# While plx-api warms again beside the standby serving alone, its cgroup's CPU and IO weight are this
# (the units' own: 1000), so the serving API keeps the cores: at equal weight the warm-up took
# half the box and the serving API's reads took 14-17 s (11-21, 90 s into a deploy). Its own
# weight again once ready, before it takes a reader, and at the latest after WARM_LOW_S, so
# a warm-up starved by a loaded box still ends within the deploy's wait.
WARM_CPU_WEIGHT=${PLX_API_WARM_CPU_WEIGHT:-100}
WARM_IO_WEIGHT=${PLX_API_WARM_IO_WEIGHT:-100}
WARM_LOW_S=${PLX_API_WARM_LOW_S:-240}

die() { echo "plx-release: $*" >&2; exit 1; }
sealed() { [ -n "${PLX_RELEASE_OWNER:-}" ]; }
# as_root CMD...: the release tree's owner runs CMD (sudo -n when sealed, else the caller)
as_root() {
  if sealed && [ "$(id -un)" != "$PLX_RELEASE_OWNER" ]; then
    sudo -n "$@" || die "needs sudo for: $* (sealed releases are owned by $PLX_RELEASE_OWNER)"
  else "$@"; fi
}
log() { sealed || mkdir -p "$PLX_RELEASES"; echo "$(date -u +%FT%TZ) $*" | as_root tee -a "$PLX_RELEASES/history.log" >/dev/null; }
staging_root() {
  if sealed; then
    [ -d "$PLX_RELEASES/.staging" ] && [ -w "$PLX_RELEASES/.staging" ] \
      || die "no writable $PLX_RELEASES/.staging (setup: deploy/release/README-api-user.md step 2)"
    echo "$PLX_RELEASES/.staging"
  else mkdir -p "$PLX_RELEASES"; echo "$PLX_RELEASES"; fi
}
current_id() { basename "$(readlink "$PLX_RELEASES/current" 2>/dev/null || echo none)"; }

pg_only() {  # the ontology is served from Postgres (DI-02: PLX_ONTOLOGY_PG=only on every unit)
  # (deploy/lib.sh: the caller's PLX_ONTOLOGY_PG, else the host's deploy.env)
  case "${PLX_ONTOLOGY_PG:-}" in only|1|true|yes) return 0 ;; *) return 1 ;; esac
}

pg_dsn() {  # the API's DSN (never printed): the caller's, else the host env file's
  [ -n "${PLX_PG_DSN:-}" ] && { echo "$PLX_PG_DSN"; return; }
  sed -n "s/^PLX_PG_DSN=//p" "$PLX_CONFIG/plx.env" 2>/dev/null | tr -d "'\"" | head -1
}

# pg_gate <tree>: in Postgres mode the served schema and step code are what Postgres holds;
# the tree's own check (operating.pg.ontology_migrate check, read only) must say ok
pg_gate() {
  local out dsn; dsn=$(pg_dsn)
  [ -n "$dsn" ] || die "Postgres mode but no PLX_PG_DSN (caller or $PLX_CONFIG/plx.env): not built"
  out=$(cd "$1" && PLX_PG_DSN="$dsn" env -u PLX_WORKBENCH_API_KEY timeout 300 \
        "$PLX_VENV/bin/python3" -m operating.pg.ontology_migrate check 2>/dev/null | tail -1) || true
  "$PLX_VENV/bin/python3" -c '
import json, sys
try:
    out = json.loads(sys.argv[1])
except ValueError:
    sys.exit("the Postgres schema check printed no verdict")
if out.get("ok") is not True:
    why = out.get("reason") or "not ok"
    sys.exit("Postgres holds another schema or step code (%s; code %s, served %s)"
             % (why, out.get("code"), out.get("served")))
print(out.get("served") or "")' "$out" || die "not built (--no-schema-check to build without the check)"
}

# ---- Postgres migrations (DEPLOY-MIG 11-15) ------------------------------------------------
# The deploy applies the release's pending `operating.pg` migrations (operating/pg/migrations,
# the ledger plx_meta.migrations) itself, after the build and before the switch; 0026-0029
# were run by hand after the 11-15 5:55 AM deploy because nothing did. Nothing pending: a
# no-op (no window check, no lock, no write). Pending: refused while a migration window is
# open (pg_window below), else applied from the release's own tree under the live-Postgres
# window lock with a short lock_timeout (a migration waiting on a busy table would queue
# every reader behind it). A failed or partial apply raises the host alarm and switches
# nothing: the old release keeps serving. A switch refuses a release with any migration
# pending, and a restart does not call a release healthy while any are pending.
MIG_TIMEOUT_S=${PLX_MIGRATE_TIMEOUT_S:-1800}
MIG_LOCK_TIMEOUT=${PLX_MIGRATE_LOCK_TIMEOUT:-30s}
STAGE_FILE=${PLX_STAGE_FILE:-$PLX_SCRATCH/STAGE-1114.md}
# the locks a migration window holds (deploy/ops/runbook/live_pg_window.sh); space-separated
MIG_LOCKS=${PLX_MIGRATION_LOCKS-$PLX_SCRATCH/cfg/live-pg-window.lock}
# the migration's own working processes (stage_guard.sh TRAIN_PROCS, plus the train runners
# train_t2/t3c/t4.sh and the applying ontology_migrate commands; its read-only `check` is the
# build's own gate). A train's chain script is not one: it idles in a sleep loop long after
# its window closed (chain_t3c.sh at 6:20 AM 11-15) and opens its window through these.
TRAIN_RE=${PLX_TRAIN_PROC_RE-'operating\.pg\.(migrate_chunks|mention_scope|identifier_reparse|timestamp_rezone|link_apply|step_staging)|operating\.pg\.ontology_migrate (apply|seed-steps)|ontology\.(pg_step_inplace|step_migrate|unit_layer_workers)|train-1113/bin/train[_a-z0-9]*\.sh|train-1113/bin/(gl_record\.py|sched\.py|early)'}

# pg_migrations <tree> status|migrate: one JSON line {applied_now, pending, drift} from the
# tree's own operating.pg.migrate (the DSN never printed); exit 1 when it could not be read
pg_migrations() {
  local dsn; dsn=$(pg_dsn)
  [ -n "$dsn" ] || { echo '{"error": "no PLX_PG_DSN (caller or plx.env)"}'; return 1; }
  [ -f "$1/operating/pg/migrate.py" ] || { echo '{"error": "the release has no operating/pg/migrate.py"}'; return 1; }
  (cd "$1" && PLX_PG_DSN="$dsn" PLX_MIG_LOCK_TIMEOUT="$MIG_LOCK_TIMEOUT" env -u PLX_WORKBENCH_API_KEY \
     timeout "$MIG_TIMEOUT_S" "$PLX_VENV/bin/python3" -c '
import json, os, sys
try:
    import psycopg
    from operating.pg import migrate
    with psycopg.connect(os.environ["PLX_PG_DSN"], connect_timeout=10,
                         application_name="plx-release-migrate",
                         options="-c lock_timeout=" + os.environ["PLX_MIG_LOCK_TIMEOUT"]) as conn:
        ran = migrate.migrate(conn) if sys.argv[1] == "migrate" else []
        state = migrate.status(conn)
except Exception as exc:   # one verdict line whatever failed; the DSN is never in it
    detail = str(exc).splitlines()[0] if str(exc) else ""
    print(json.dumps({"error": type(exc).__name__, "detail": detail[:300]}))
    sys.exit(1)
print(json.dumps({"applied_now": ran, "pending": state["pending"], "drift": state["drift"]}))
' "$2" 2>/dev/null | tail -1)
}

# mig_field <json> <key>: the list (space-joined) or text at <key>; "?" when the JSON is not one
mig_field() {
  python3 -I -c '
import json, sys
try:
    v = json.loads(sys.argv[1]).get(sys.argv[2])
except (ValueError, AttributeError):
    print("?"); sys.exit()
print(" ".join(v) if isinstance(v, list) else (v or ""))' "$1" "$2"
}

# pg_window: why a migration window is open now (empty: none). Fails closed: a stage file that
# names no stage is a window.
pg_window() {
  if [ -f "$STAGE_FILE" ]; then
    local stage; stage=$(sed -n 's/^CURRENT STAGE: *\([A-Za-z]\).*/\1/p' "$STAGE_FILE" | head -1)
    case $stage in
      C|E) ;;
      A|B|D) echo "stage $stage in $STAGE_FILE (the migration owns served Postgres)"; return ;;
      *) echo "$STAGE_FILE names no stage this tool knows (${stage:-none}): treated as a window"; return ;;
    esac
  fi
  local l fd
  for l in $MIG_LOCKS; do
    [ -e "$l" ] || continue
    [ -r "$l" ] || { echo "$l cannot be read (its holder is not known)"; return; }
    exec {fd}<"$l"
    if ! flock -n "$fd"; then
      exec {fd}<&-
      local who; who=$(head -c 120 "$(dirname "$l")/$(basename "$l" .lock).holder" 2>/dev/null | tr -d '\n' || true)
      echo "$l is held (${who:-its holder is not recorded})"
      return
    fi
    exec {fd}<&-
  done
  if [ -n "$TRAIN_RE" ]; then
    local p; p=$(pgrep -f -a -- "$TRAIN_RE" 2>/dev/null | grep -v "^$$ " | head -1 | cut -c1-160)
    [ -z "$p" ] || { echo "a migration process runs: $p"; return; }
  fi
}

# pending_or_die <id> <what>: dies unless Postgres holds every migration of release <id>
pending_or_die() {
  local st pend
  st=$(pg_migrations "$PLX_RELEASES/$1" status) \
    || die "release $1: its Postgres migrations could not be read ($(mig_field "$st" error) $(mig_field "$st" detail)): $2"
  pend=$(mig_field "$st" pending)
  [ -z "$pend" ] || die "release $1 has Postgres migrations pending ($pend): $2 (plx-release migrate $1)"
}

migrate() {
  local id=${1:?migrate needs a release id}
  local dir="$PLX_RELEASES/$id"
  [ -f "$dir/RELEASE.json" ] || die "no built release $id"
  pg_only || { echo "migrations: not in Postgres mode, nothing to apply"; return 0; }
  local st pend drift why
  if ! st=$(pg_migrations "$dir" status); then
    raise_alarm release-migrate "release $id not deployed: its Postgres migrations could not be read ($(mig_field "$st" error))"
    die "release $id: Postgres migrations could not be read ($(mig_field "$st" error) $(mig_field "$st" detail)): not migrated, not switched"
  fi
  pend=$(mig_field "$st" pending); drift=$(mig_field "$st" drift)
  if [ -n "$drift" ]; then
    raise_alarm release-migrate "release $id not deployed: applied migrations differ from its files ($drift)"
    die "release $id: applied migrations differ from the release's files ($drift): not migrated, not switched"
  fi
  [ -n "$pend" ] || { echo "migrations: none pending"; return 0; }
  why=$(pg_window)
  if [ -n "$why" ]; then
    log "migrate $id held ($pend): $why"
    echo "plx-release: release $id not deployed: Postgres migrations pending ($pend) and a migration window is open: $why. Nothing applied; the current release keeps serving; deploy again after the window." >&2
    exit 75
  fi
  # held for the apply: no train window opens under it (live_pg_window.sh waits for it)
  local l fd held=""
  for l in $MIG_LOCKS; do
    [ -e "$l" ] || continue
    [ -r "$l" ] || die "release $id: $l cannot be read: nothing applied, not switched"
    exec {fd}<"$l"
    flock -n "$fd" || die "release $id: $l was taken meanwhile: nothing applied, not switched"
    held="$held $fd"
  done
  log "migrate $id: applying $pend"
  local out after rc=0
  out=$(pg_migrations "$dir" migrate) || rc=$?
  after=$(pg_migrations "$dir" status) || true
  for fd in $held; do exec {fd}<&-; done
  local left; left=$(mig_field "$after" pending)
  if [ "$rc" != 0 ] || [ -n "$left" ] || [ "$(mig_field "$after" drift)" != "" ]; then
    local what=${left:-none}
    [ "$what" = "?" ] && what="unknown (status unreadable)"
    raise_alarm release-migrate "release $id not deployed: Postgres migrate failed ($(mig_field "$out" error) $(mig_field "$out" detail)); still pending: $what"
    log "migrate $id FAILED: $(mig_field "$out" error); pending $what"
    die "release $id: Postgres migrate failed ($(mig_field "$out" error) $(mig_field "$out" detail)); still pending: $what. Not switched: the current release keeps serving"
  fi
  log "migrate $id: applied $(mig_field "$out" applied_now)"
  echo "migrations applied: $(mig_field "$out" applied_now)"
}

served_digest() {  # empty: no served projection; fails when one is there but unreadable
  local store="$PLX_STATE/projection/ontology.sqlite"
  pg_only && return 0              # Postgres mode: the SQLite generation is not served
  [ -e "$store" ] || return 0
  "$PLX_VENV/bin/python3" - "$store" <<'PY'
import sqlite3, sys
c = sqlite3.connect(f"file:{sys.argv[1]}?mode=ro", uri=True, timeout=5)
row = c.execute("SELECT value FROM store_meta WHERE key = 'schema_digest'").fetchone()
if not row or not row[0]:
    sys.exit("the served projection records no schema_digest")
print(row[0])
PY
}

# OPS-005: a failed inspection is its own outcome, never read as "nothing to compare"
served_or_die() {
  served_digest || die "the served projection's schema digest could not be read: not built (--no-schema-check to build without the check)"
}

build() {
  local ref="" app=1 schema_check=1 seed="" overlays=()
  while [ $# -gt 0 ]; do
    case $1 in
      --overlay) overlays+=("$2"); shift 2 ;;
      --node-modules-from) seed=$2; shift 2 ;;
      --no-app) app=0; shift ;;
      --no-schema-check) schema_check=0; shift ;;
      -*) die "unknown option $1" ;;
      *) ref=$1; shift ;;
    esac
  done
  [ -n "$ref" ] || die "build needs a ref"
  local sha; sha=$(git -C "$PLX_REPO" rev-parse --verify "$ref^{commit}") || die "no commit $ref"
  local id=${sha:0:12}
  if [ ${#overlays[@]} -gt 0 ]; then
    local spec="" o
    for o in "${overlays[@]}"; do
      spec+="$(git -C "$PLX_REPO" rev-parse --verify "${o%%:*}^{commit}"):${o#*:} "
    done
    id="$id-o$(printf %s "$spec" | sha256sum | cut -c1-8)"
  fi
  local dir="$PLX_RELEASES/$id"
  if [ -f "$dir/RELEASE.json" ]; then
    # OPS-002: a release is reused only when it was built as this build asks: with the app
    # when the app is wanted, and on the served schema when the check is on
    if [ "$app" = 1 ] && [ -f "$dir/app/package.json" ] && [ ! -d "$dir/app/.next" ]; then
      die "release $id was built without the app (--no-app): build with --no-app, or remove $dir to rebuild it"
    fi
    if [ "$schema_check" = 1 ]; then
      local had served
      had=$("$PLX_VENV/bin/python3" -c 'import json,sys; print(json.load(open(sys.argv[1])).get("schema_digest") or "")' "$dir/RELEASE.json") \
        || die "release $id: RELEASE.json could not be read"
      served=$(served_or_die)
      if pg_only; then served=$(pg_gate "$dir"); fi
      if [ -n "$served" ] && [ "$had" != "$served" ]; then
        die "release $id has schema ${had:-unknown}, the served generation's is $served: not reused (--no-schema-check to reuse it)"
      fi
    fi
    echo "$id"; return 0
  fi
  local tmp; tmp="$(staging_root)/.build-$id-$$"
  rm -rf "$tmp"; mkdir -p "$tmp"
  trap "as_root rm -rf '$tmp'" EXIT
  git -C "$PLX_REPO" archive "$sha" | tar -x -C "$tmp"
  for o in "${overlays[@]}"; do
    git -C "$PLX_REPO" archive "${o%%:*}" -- "${o#*:}" | tar -x -C "$tmp"
  done
  local got="" want="" built_app=0 app_tree=""
  # the app/ tree this build holds (none when an overlay may change app/): a build of the
  # same tree as the current release's reuses that release's .next instead of `next build`
  # (process sweep 11-07: every deploy rebuilt an unchanged app)
  app_tree=$(git -C "$PLX_REPO" rev-parse -q --verify "$sha:app" 2>/dev/null || true)
  for o in "${overlays[@]}"; do
    case "${o#*:}" in app|app/*|./app|./app/*|.|./|"") app_tree="";; esac
  done
  if [ -d "$tmp/ontology/schema" ]; then
    if ! got=$(cd "$tmp" && timeout 300 "$PLX_VENV/bin/python3" -c \
          "from ontology.schema import load_schema; print(load_schema().digest)"); then
      [ "$schema_check" = 1 ] && die "the release's schema could not be loaded: not built"
      got=""
    fi
  fi
  [ "$schema_check" = 1 ] && want=$(served_or_die)
  if [ "$schema_check" = 1 ] && pg_only; then want=$(pg_gate "$tmp"); got=${got:-$want}; fi
  if [ "$schema_check" = 1 ] && [ -n "$want" ] && [ "$got" != "$want" ]; then
    die "schema $got differs from the served generation's $want: not built (--overlay the served schema, or --no-schema-check)"
  fi
  if [ "$app" = 1 ] && [ -f "$tmp/app/package.json" ]; then
    local cur="$PLX_RELEASES/current/app"
    if [ -z "$seed" ] && [ -d "$cur/node_modules" ] && cmp -s "$cur/package-lock.json" "$tmp/app/package-lock.json"; then
      seed="$cur/node_modules"
    fi
    if [ -n "$seed" ]; then
      # sealed: hard links only to a sealed seed (root may link root's files; linking an
      # unsealed seed would make the seal re-own that tree's files), else a copy
      if sealed && [ "$(stat -c %U "$(readlink -f "$seed")")" = "$PLX_RELEASE_OWNER" ]; then
        as_root cp -al "$(readlink -f "$seed")" "$tmp/app/node_modules"
      elif sealed; then
        cp -a "$(readlink -f "$seed")" "$tmp/app/node_modules"
      else
        cp -al "$(readlink -f "$seed")" "$tmp/app/node_modules"
      fi
    else
      (cd "$tmp/app" && PATH="$PLX_NODE/bin:/usr/bin:/bin" npm ci --no-audit --no-fund >/dev/null)
    fi
    local cur_tree=""
    if [ -n "$app_tree" ] && [ -f "$PLX_RELEASES/current/RELEASE.json" ]; then
      cur_tree=$("$PLX_VENV/bin/python3" -c 'import json,sys; print((json.load(open(sys.argv[1])).get("profile") or {}).get("app_tree") or "")' \
        "$PLX_RELEASES/current/RELEASE.json" 2>/dev/null || true)
    fi
    if [ -n "$app_tree" ] && [ "$cur_tree" = "$app_tree" ] && [ -f "$cur/.next/BUILD_ID" ] \
        && cmp -s "$cur/package-lock.json" "$tmp/app/package-lock.json"; then
      cp -a "$(readlink -f "$cur/.next")" "$tmp/app/.next"
      echo "app tree ${app_tree:0:12} unchanged: reused the current release's build" >&2
    else
      (cd "$tmp/app" && PATH="$PLX_NODE/bin:/usr/bin:/bin" NEXT_TELEMETRY_DISABLED=1 \
         node node_modules/next/dist/bin/next build > "$tmp/.app-build.log" 2>&1) \
        || { tail -20 "$tmp/.app-build.log" >&2; die "app build failed"; }
    fi
    built_app=1
  fi
  [ "$built_app" = 1 ] || app_tree=""
  "$PLX_VENV/bin/python3" - "$tmp/RELEASE.json" "$id" "$sha" "$ref" "$got" "$built_app" \
      "$schema_check" "$app_tree" "${overlays[@]}" <<'PY'
import json, sys, datetime
path, rid, sha, ref, digest, built_app, checked, app_tree, *overlays = sys.argv[1:]
json.dump({"id": rid, "sha": sha, "ref": ref, "overlays": overlays, "schema_digest": digest,
           "profile": {"app": built_app == "1", "schema_checked": checked == "1",
                       "app_tree": app_tree or None},
           "built_at": datetime.datetime.now(datetime.timezone.utc).isoformat()},
          open(path, "w"), indent=1)
PY
  # the derived-code versions are part of the release too (operating/derived_status.py,
  # DERIVED-CODE.json): an API started on it reads them in milliseconds instead of parsing
  # its code (24-58 s) before its first page; a failure leaves them to the API, as before
  if [ -x "$PLX_VENV/bin/python3" ]; then
    (cd "$tmp" && "$PLX_VENV/bin/python3" -m operating.derived_status versions --release \
      >/dev/null) || echo "plx-release: derived-code versions not precomputed (the API computes them)" >&2
  fi
  # the bytecode is part of the release: a sealed tree is read-only to every unit, so a
  # process could not write its __pycache__ and would recompile on every start
  [ -x "$PLX_VENV/bin/python3" ] && "$PLX_VENV/bin/python3" -m compileall -q -j 0 -x '/node_modules/' \
    "$tmp" >/dev/null 2>&1 || true
  if sealed; then
    # nothing in a release is writable but by its owner: no unit's user can change the code
    # it runs (the release holds no secret, so every user may read it)
    as_root chown -R "$PLX_RELEASE_OWNER:$(id -gn "$PLX_RELEASE_OWNER")" "$tmp"
    as_root chmod -R u+rwX,go+rX,go-w "$tmp"
  else
    chmod -R go+rX "$tmp"        # caddy reads the Caddyfile from the release
  fi
  as_root mv -T "$tmp" "$dir"
  trap - EXIT
  # the builder owned the staging directory until the rename: check what landed
  if sealed; then verify "$id" >/dev/null || die "release $id is not sealed after the build"; fi
  log "built $id from $ref ($sha)${overlays:+ overlays ${overlays[*]}}"
  echo "$id"
}

relink() {  # relink <name> <target id>: atomic (rename over the old link)
  as_root ln -sfn "$2" "$PLX_RELEASES/.$1.new"
  as_root mv -Tf "$PLX_RELEASES/.$1.new" "$PLX_RELEASES/$1"
}

# raise_alarm KEY MESSAGE: the host alarm (deploy/ops/host/unit_alarm.py raise), on the root
# disk where the notifier reads it; a failure to record it is said, never fatal
raise_alarm() {
  python3 "$here/../ops/host/unit_alarm.py" --ops-dir "$HOST_OPS" raise "$1" "$2" >/dev/null 2>&1 \
    || echo "plx-release: alarm not recorded: $2" >&2
}

preflight() {  # preflight <id>: the API's own configuration check of release <id>
  local id=${1:?preflight needs a release id} unit
  [ -f "$PLX_RELEASES/$id/RELEASE.json" ] || die "no built release $id"
  unit="plx-api-check@$id.service"
  if [ "$(systemctl show -p LoadState --value "$unit" 2>/dev/null)" != loaded ]; then
    [ "${PLX_RELEASE_PREFLIGHT:-auto}" = required ] && die "preflight: $unit is not installed (deploy/ops/host/install.py)"
    log "preflight $id skipped: check unit not installed"
    echo "preflight $id skipped: plx-api-check@.service is not installed"
    return 0
  fi
  # the check unit runs one fixed release root (WorkingDirectory=/data/plx-releases/%i); a
  # release built under another $PLX_RELEASES (a test or staging root) is not the one it would
  # check, so starting it would judge a different (or missing) tree: said and skipped, or
  # refused when the preflight is required. An unreadable WorkingDirectory still runs the check.
  local wd; wd=$(systemctl show -p WorkingDirectory --value "$unit" 2>/dev/null || true)
  if [ -n "$wd" ] && [ "$(readlink -f "$wd")" != "$(readlink -f "$PLX_RELEASES/$id")" ]; then
    [ "${PLX_RELEASE_PREFLIGHT:-auto}" = required ] && die "preflight: $unit checks $wd, not $PLX_RELEASES/$id"
    log "preflight $id skipped: check unit checks another release root"
    echo "preflight $id skipped: $unit checks $wd, not $PLX_RELEASES/$id"
    return 0
  fi
  if sudo -n systemctl start "$unit"; then
    log "preflight $id ok"; echo "preflight $id ok"; return 0
  fi
  log "preflight $id FAILED"
  journalctl -u "$unit" -n 15 -o cat --no-pager 2>/dev/null | grep -viE 'key|secret|token|password|dsn' >&2 || true
  return 1
}

switch() {
  local id=${1:?switch needs a release id}
  [ -f "$PLX_RELEASES/$id/RELEASE.json" ] || die "no built release $id"
  if sealed; then verify "$id" >/dev/null || die "release $id is not sealed: not switched"; fi
  local old; old=$(current_id)
  [ "$old" = "$id" ] && { echo "already current: $id"; return 0; }
  if [ "${2:-}" != --no-preflight ]; then
    preflight "$id" || die "release $id failed its configuration check: not switched (current stays $old)"
    # DEPLOY-MIG: Postgres must hold the release's migrations (plx-release migrate <id>); a
    # rollback (--no-preflight) is never held by Postgres
    pg_only && pending_or_die "$id" "not switched (current stays $old)"
  fi
  relink current "$id"
  [ "$old" != none ] && relink previous "$old"
  log "switch $old -> $id"
  echo "current: $id (previous: $old). Long-running units load it on: $0 restart"
}

rollback() {
  local prev; prev=$(basename "$(readlink "$PLX_RELEASES/previous" 2>/dev/null || true)")
  [ -n "$prev" ] || die "no previous release"
  # back to what served before: its check passed when it was switched to, and a check that
  # fails now (the host's configuration) must not keep the broken release in place
  switch "$prev" --no-preflight
}

# mint_has_canary <mint>: the installed plx-mint-link knows --canary (the canary's own link)
mint_has_canary() { grep -qF -- '"--canary"' "$1" 2>/dev/null; }

# refresh_mint_link <mint>: an installed plx-mint-link without --canary is replaced by the
# serving release's copy, before the probe needs it, so an old host copy (which reads --canary
# as a TTL and refuses) never rolls a deploy back. Only from a sealed release (owned by the
# release owner, nothing group/other-writable; never the repo checkout), only a copy that has
# --canary (never a downgrade), never anything else.
refresh_mint_link() {
  local mint=$1 owner=${PLX_RELEASE_OWNER:-root}
  local src; src="$PLX_RELEASES/$(current_id)/deploy/ops/plx-mint-link"
  mint_has_canary "$mint" && return 0
  [ -f "$src" ] && mint_has_canary "$src" || return 0
  if [ "$(stat -L -c %U "$src")" != "$owner" ] || [ -n "$(find -L "$src" -perm /022)" ]; then
    log "plx-mint-link not refreshed: $src is not sealed"; return 0
  fi
  sudo -n install -m 755 "$src" "$mint" >/dev/null 2>&1 \
    && log "plx-mint-link refreshed from release $(current_id) (--canary)" \
    || log "plx-mint-link could not be refreshed from release $(current_id)"
}

# auth_probe: one authenticated read through the Ask canary's service session (plx-mint-link
# --canary: its own link file, ask-canary-access-link; the session is served /api/me); 0 = it
# answered 200 (or the probe is off / not installed and not required). The owner's link file
# (workbench-access-link) is never minted, read or used: a sign-in ticket works once, so a
# probe through it left the owner a dead link after every deploy. A plx-mint-link that still
# lacks --canary after the refresh leaves the check at /api/health (logged; required: refused).
# Nothing secret is printed.
auth_probe() {
  local mode=${PLX_RELEASE_AUTH_PROBE:-auto} mint=${PLX_MINT_LINK:-/usr/local/sbin/plx-mint-link}
  [ "$mode" = 0 ] && return 0
  if [ ! -x "$mint" ]; then
    [ "$mode" = required ] && { echo "auth probe: $mint is not installed" >&2; return 1; }
    log "auth probe skipped: $mint not installed"; return 0
  fi
  refresh_mint_link "$mint"
  if ! mint_has_canary "$mint"; then
    [ "$mode" = required ] && { echo "auth probe: $mint has no --canary mode (the owner's link is never used)" >&2; return 1; }
    log "auth probe skipped: $mint has no --canary mode; checked by /api/health only (the owner's link is never used)"
    return 0
  fi
  local link="$HOME/.config/plx/ask-canary-access-link" jar body code=000
  sudo -n "$mint" --canary >/dev/null 2>&1 || { echo "auth probe: the canary link could not be minted" >&2; return 1; }
  jar=$(mktemp); body=$(mktemp); chmod 600 "$jar" "$body"
  python3 -I -c 'import json,sys;u=open(sys.argv[1]).read().strip();print(json.dumps({"ticket":u.split("#ticket=",1)[1]}))' \
    "$link" > "$body" 2>/dev/null \
    && curl -s -m 30 -o /dev/null -c "$jar" -H 'Content-Type: application/json' --data @"$body" \
         "$PLX_API_URL/api/auth/dev-login" >/dev/null 2>&1 \
    && code=$(curl -s -m 60 -o /dev/null -w '%{http_code}' -b "$jar" "$PLX_API_URL/api/me" || true)
  rm -f "$jar" "$body"
  [ "$code" = 200 ] || { echo "auth probe: /api/me answered $code" >&2; return 1; }
}

# serving: /api/health 200 (up to 3 min: the API loads its readers) and the authenticated read
serving() {
  local code=000 i
  for i in $(seq 1 60); do
    code=$(curl -s -m 10 -o /dev/null -w '%{http_code}' "$PLX_API_URL/api/health" || true)
    [ "$code" = 200 ] && break; sleep 3
  done
  [ "$code" = 200 ] || { echo "health=$code"; return 1; }
  auth_probe || { echo "health=200 auth=failed"; return 1; }
  # DEPLOY-MIG: never healthy while a migration of the release it serves is pending
  if pg_only; then
    local st pend; st=$(pg_migrations "$PLX_RELEASES/$(current_id)" status) || st=""
    pend=$(mig_field "${st:-x}" pending)
    [ "$pend" = "?" ] && { echo "health=200 auth=ok migrations=unreadable"; return 1; }
    [ -z "$pend" ] || { echo "health=200 auth=ok migrations=pending:${pend// /,}"; return 1; }
    echo "health=200 auth=ok migrations=none-pending"; return 0
  fi
  echo "health=200 auth=ok"
}

# plx-ingest drained, not killed: SIGTERM to its main process only (a host that drains ends each
# capture at a safe point within its drain bound and exits 0), bounded; then started on current.
restart_ingest_drained() {
  systemctl is-active -q plx-ingest || return 0
  local bound t0
  bound=$(python3 -I -c 'import json,sys
try:
    v = json.load(open(sys.argv[1])).get("drain_seconds")
    print(int(v) if isinstance(v, (int, float)) and not isinstance(v, bool) and v > 0 else 60)
except (OSError, ValueError):
    print(60)' "${PLX_INGEST_STATE:-/data/plx-state}/host/serve-health.json" 2>/dev/null || echo 60)
  t0=$(date +%s)
  sudo systemctl kill --kill-whom=main -s TERM plx-ingest
  until ! systemctl is-active -q plx-ingest || [ $(( $(date +%s) - t0 )) -gt $(( bound + 90 )) ]; do sleep 1; done
  systemctl is-active -q plx-ingest && sudo systemctl stop plx-ingest
  sudo systemctl start plx-ingest
  log "ingest drain restart in $(( $(date +%s) - t0 )) s (bound $bound s)"
}

api_get() {  # api_get <port|standby> <path> [curl options]: plx-api by $PLX_API_URL, the
  # standby by its socket
  local who=$1 path=$2; shift 2
  if [ "$who" = "$API_PORT" ]; then curl -s -m 5 "$@" "${PLX_API_URL%/}$path"
  else curl -s -m 5 "$@" --unix-socket "$STANDBY_SOCKET" "http://localhost$path"; fi
}

api_health() {  # api_health <port|standby>: the HTTP status of /api/health
  api_get "$1" /api/health -o /dev/null -w '%{http_code}' || true
}

cold_restart_api() {  # the API restarted in place, then /api/health (the pre-ARCH-T6 restart)
  # restart, not try-restart: a deploy stopped half way leaves plx-api stopped and the standby
  # serving, and try-restart would leave 8780 down
  sudo systemctl restart "$API_UNIT" || true
  local code=000 i standby; standby=$(slot_unit "$STANDBY")
  for i in $(seq 1 60); do
    code=$(api_health "$API_PORT")
    [ "$code" = 200 ] && break; sleep 3
  done
  # 8780 serves again: a standby still up (that half-finished deploy's) stops once Caddy
  # passes back to 8780, so no reader stays on another release
  if [ "$code" = 200 ] && systemctl is-active -q "$standby"; then
    sleep "$PASS_OVER_S"; sudo systemctl stop "$standby" || true
  fi
  echo "$code"
}

# A deploy restarts a unit only when what it runs changed (each deploy restarted plx-app and
# switched the API warm: ~45 restarts in 8 h, every one a cold start or a cut stream for
# someone). runs_release <unit>: the release its main process runs from (its cwd), else empty.
runs_release() {
  local pid cwd; pid=$(systemctl show "$1" -p MainPID --value 2>/dev/null || true)
  [ -n "$pid" ] && [ "$pid" != 0 ] || return 0
  cwd=$(sudo -n readlink -e "/proc/$pid/cwd" 2>/dev/null || readlink -e "/proc/$pid/cwd" 2>/dev/null || true)
  local root; root=$(readlink -f "$PLX_RELEASES")   # plx-app runs from <release>/app
  case $cwd in "$root"/?*) cwd=${cwd#"$root"/}; echo "${cwd%%/*}" ;; esac
  return 0
}
release_field() {  # release_field <id> <sha|overlays|app_tree>: from its RELEASE.json, else empty
  "$PLX_VENV/bin/python3" - "$PLX_RELEASES/$1/RELEASE.json" "$2" <<'PY' 2>/dev/null || true
import json, sys
r = json.load(open(sys.argv[1]))
v = (r.get("profile") or {}).get("app_tree") if sys.argv[2] == "app_tree" else r.get(sys.argv[2])
print(json.dumps(v) if isinstance(v, list) else (v or ""))
PY
}
# Paths the API process never reads: the Next app, docs, tests, the host's deploy tooling (units,
# Caddy, backups and this script are installed or run on their own). Anything else counts.
API_IGNORED='^(app/|docs/|desktop/|devloop/|deploy/(ops|release|spark|systemd|backup)/|deploy/Caddyfile$)|(^|/)tests/|^[^/]*\.md$'
# unit_unchanged <plx-app|plx-api>: 0 (prints the release it runs) when that release and current
# hold the same app tree (plx-app) or differ only in API_IGNORED paths (plx-api); 1 when unknown
unit_unchanged() {
  local ran cur a b; ran=$(runs_release "$1"); cur=$(current_id)
  [ -n "$ran" ] && [ -d "$PLX_RELEASES/$ran" ] || return 1
  [ "$ran" = "$cur" ] && { echo "$ran"; return 0; }
  if [ "$1" = plx-app ]; then
    a=$(release_field "$ran" app_tree); b=$(release_field "$cur" app_tree)
    [ -n "$a" ] && [ "$a" = "$b" ] && { echo "$ran"; return 0; }
    return 1
  fi
  [ "$(release_field "$ran" overlays)" = "[]" ] && [ "$(release_field "$cur" overlays)" = "[]" ] || return 1
  a=$(release_field "$ran" sha); b=$(release_field "$cur" sha)
  [ -n "$a" ] && [ -n "$b" ] || return 1
  local changed; changed=$(git -C "$PLX_REPO" diff --name-only "$a" "$b" 2>/dev/null) || return 1
  # no pipe into grep -q: with pipefail its early exit could read as "nothing relevant"
  local relevant; relevant=$(printf '%s\n' "$changed" | grep -vE "$API_IGNORED" | grep -v '^$' || true)
  [ -z "$relevant" ] || return 1
  echo "$ran"
}

restart() {
  local units="" u cold=0 ingest=0 with=""
  for u in "$@"; do
    case $u in
      --with-ingest) ingest=1 ;;
      --cold) cold=1 ;;
      *) die "unknown option $u" ;;
    esac
    with="$with $u"
  done
  for u in $LONG_RUNNING; do [ "$u" = plx-api ] || units="$units $u"; done
  # stopped while unused is read before the restart: after it, an API the new release
  # crashes is "activating" or "failed", never a stopped one
  local api_was_active=yes
  systemctl is-active -q "$API_UNIT" || api_was_active=no
  if [ "$api_was_active" = no ] && systemctl is-active -q "$(slot_unit "$STANDBY")"; then
    api_was_active=yes   # a deploy stopped half way: the standby serves
  fi
  # A oneshot unit (plx-search-follow) restarted mid-run holds try-restart until its whole run
  # ends (11-13: a deploy waited 30+ min); it loads current on its next run, so queue its
  # restart without waiting. Long-running services are still restarted and waited for.
  # The API and the app are always up: restarted, or started when stopped (11-13 auto-deploy
  # stopped them after every deploy, and a stopped API skipped the health check entirely).
  # A serving API is never restarted here: the warm switch (or an in-place restart) below.
  local svc="" one="" up=""
  for u in $units; do
    case " $ALWAYS_UP " in *" $u "*) up="$up $u"; continue ;; esac
    if [ "$(systemctl show "$u" -p Type --value 2>/dev/null)" = oneshot ]; then one="$one $u"; else svc="$svc $u"; fi
  done
  local api="" kept_app=""
  # plx-app serving the same app tree keeps serving (a restart drops the pages under way)
  if [ "$cold" = 0 ] && case " $up " in *" plx-app "*) true ;; *) false ;; esac \
      && systemctl is-active -q plx-app && kept_app=$(unit_unchanged plx-app); then
    up=$(printf '%s' "$up" | sed 's/ plx-app\b//'); units=$(printf '%s' "$units" | sed 's/ plx-app\b//')
    echo "$(plx_now) plx-app kept: the release it runs ($kept_app) has the same app" >&2
  fi
  if [ "$api_was_active" = yes ] && [ "$cold" = 0 ] && [ "${PLX_RELEASE_API_KEPT:-0}" != 1 ] \
      && systemctl is-active -q "$API_UNIT"; then
    # never on a rollback's own restart: an API that did not serve is restarted then
    if [ "${PLX_RELEASE_NO_ROLLBACK:-0}" != 1 ]; then
      local ran; ran=$(unit_unchanged plx-api) && api="kept: no API change since $ran"
    fi
  fi
  if [ "$api_was_active" = no ] && [ "${PLX_RELEASE_API_KEPT:-0}" != 1 ]; then
    up="$API_UNIT$up"; api="started"   # nothing it serves is cut off
  fi
  # shellcheck disable=SC2086
  [ -z "$up" ] || sudo systemctl restart $up || true     # a unit that does not start fails serving
  # shellcheck disable=SC2086
  [ -z "$svc" ] || sudo systemctl try-restart $svc
  # shellcheck disable=SC2086
  [ -z "$one" ] || sudo systemctl try-restart --no-block $one
  # a reload drops requests under way: only when the Caddyfile changed with the release
  if ! cmp -s "$PLX_CURRENT/deploy/Caddyfile" "$PLX_RELEASES/previous/deploy/Caddyfile"; then
    sudo systemctl reload-or-restart "$CADDY_UNIT" 2>/dev/null || true
  fi
  [ "$ingest" = 1 ] && { restart_ingest_drained; units="$units plx-ingest"; }
  local why="" warm_failed=0
  if [ "${PLX_RELEASE_API_KEPT:-0}" = 1 ]; then
    api="kept: it serves the release rolled back to"
  elif [ -z "$api" ]; then
    if [ "$cold" = 1 ]; then why="--cold asked"
    else why=$(warm_refusal); fi
    if [ -z "$why" ]; then
      if warm_switch; then api="warm switch"; else api="warm switch failed"; warm_failed=1; fi
    else
      echo "$(plx_now) warm switch off: $why; the API restarts in place" >&2
      cold_restart_api >/dev/null
      api="cold: $why"
    fi
  fi
  local seen bad
  if [ "$warm_failed" = 1 ]; then seen="not switched"; bad=1
  else seen=$(serving) && bad=0 || bad=1; fi
  log "restart ($units) $seen ($api) on $(current_id)"
  echo "$(plx_now) restarted on $(current_id): $seen ($api)"
  [ "$bad" = 0 ] && return 0
  local failed prev; failed=$(current_id)
  prev=$(basename "$(readlink "$PLX_RELEASES/previous" 2>/dev/null || true)")
  local served=""
  [ "$warm_failed" = 1 ] && served="; the API that served before still serves"
  if [ "${PLX_RELEASE_NO_ROLLBACK:-0}" = 1 ] || [ -z "$prev" ] || [ "$prev" = "$failed" ]; then
    if [ "$warm_failed" = 1 ]; then
      # nothing to roll back to and the other units already run $failed: the API restarts in
      # place on it too, so the app and the API never run different releases
      local code; code=$(cold_restart_api)
      served="; the API was restarted in place on it (health=$code)"
    fi
    raise_alarm release "release $failed is not serving ($seen$served) and there is nothing to roll back to"
    die "API not serving on $failed ($seen$served); no rollback"
  fi
  rollback >/dev/null
  # a warm switch that failed before plx-api.service restarted leaves it serving what it ran
  # (the release rolled back to): the rollback restarts the other units only
  local kept=0
  [ "$warm_failed" = 1 ] && systemctl is-active -q "$API_UNIT" && kept=1
  local after
  # shellcheck disable=SC2086
  after=$(PLX_RELEASE_NO_ROLLBACK=1 PLX_RELEASE_API_KEPT=$kept "$0" restart $with 8>&- 2>&1 | tail -1) && bad=0 || bad=1
  if [ "$bad" = 0 ]; then
    raise_alarm release "release $failed was not serving ($seen$served): rolled back to $prev, which serves"
  else
    raise_alarm release "release $failed was not serving ($seen$served); rolled back to $prev, which does not serve either ($after)"
  fi
  die "API not serving on $failed ($seen$served): rolled back to $prev (${after:-})"
}

deploy() {
  local id=${1:?deploy needs a release id}
  migrate "$id"   # nothing applied and nothing switched when it fails or a window is open
  switch "$id"
  restart   # a release that does not serve is rolled back by restart itself (exit 1)
  echo "$(plx_now) deployed release $id"
}

# ---- warm switch (ARCH-T6) -----------------------------------------------------------------

slot_unit() {  # the unit that serves on port $1 (8780), else plx-api@$1 (the standby)
  if [ "$1" = "$API_PORT" ]; then echo "$API_UNIT"; else echo "$API_UNIT@$1"; fi
}

priv() {  # priv CMD...: as the caller when it may write $HOLD_DIR's parent, else sudo -n
  if [ -w "$(dirname "$HOLD_DIR")" ]; then "$@"; else sudo -n "$@"; fi
}

hold() { priv mkdir -p "$HOLD_DIR" && priv touch "$HOLD_DIR/hold-$1"; }
unhold() { priv rm -f "$HOLD_DIR/hold-$1"; }

caddy_sends_to_standby() {  # whether the running Caddy's config names the standby's socket
  local config
  config=$(sudo -n -u "$CADDY_USER" curl -s -m 5 --unix-socket "$CADDY_ADMIN" \
           http://localhost/config/apps/http/servers 2>/dev/null) || return 1
  [[ $config == *\"dial\":\"unix/$STANDBY_SOCKET\"* ]]
}

mem_available_mb() { awk '/^MemAvailable:/{print int($2/1024)}' "$MEMINFO"; }

api_memory_mb() {  # what the serving API holds now: its cgroup's anonymous memory, else all
  local unit="$API_UNIT"
  systemctl is-active -q "$unit" >/dev/null || unit=$(slot_unit "$STANDBY")
  local cg="$CGROUP_ROOT/system.slice/$unit.service/memory.stat" bytes=""
  [ -r "$cg" ] && bytes=$(awk '$1=="anon"{print $2}' "$cg")
  [ -n "$bytes" ] || bytes=$(systemctl show -p MemoryCurrent --value "$unit")
  [[ $bytes =~ ^[0-9]+$ ]] || return 1
  echo $((bytes / 1048576))
}

pg_room() {  # empty when Postgres can take a second API's sessions, else why not
  pg_only || return 0
  local dsn; dsn=$(pg_dsn)
  [ -n "$dsn" ] || { echo "no PLX_PG_DSN to count the API's Postgres sessions"; return 0; }
  local row
  row=$(psql "$dsn" -XAtq -v ON_ERROR_STOP=1 -v role="$API_ROLE" -v app="$API_UNIT" <<'SQL' 2>/dev/null
SELECT CASE WHEN r.rolconnlimit < 0 THEN current_setting('max_connections')::int
            ELSE r.rolconnlimit END,
       (SELECT count(*) FROM pg_stat_activity a
         WHERE a.usename = r.rolname OR (r.rolconnlimit < 0 AND a.usename IS NOT NULL)),
       (SELECT count(*) FROM pg_stat_activity a WHERE a.application_name = :'app')
  FROM pg_roles r WHERE r.rolname = :'role';
SQL
  ) || true
  [[ $row =~ ^([0-9]+)\|([0-9]+)\|([0-9]+)$ ]] \
    || { echo "the API's Postgres sessions could not be counted"; return 0; }
  local limit=${BASH_REMATCH[1]} used=${BASH_REMATCH[2]} api=${BASH_REMATCH[3]}
  if [ $((used + api + PG_MARGIN)) -gt "$limit" ]; then
    echo "Postgres has no room for a second API ($API_ROLE: $used of $limit sessions in use, the API holds $api)"
  fi
}

# the settings that decide what the API may read, write and run: equal for both units
PARITY="KillMode User Group SupplementaryGroups DynamicUser WorkingDirectory RootDirectory Environment
EnvironmentFiles UnsetEnvironment PassEnvironment ExecStart ProtectSystem ProtectHome
ReadWritePaths ReadOnlyPaths InaccessiblePaths BindPaths BindReadOnlyPaths TemporaryFileSystem
StateDirectory StateDirectoryMode CapabilityBoundingSet AmbientCapabilities SystemCallFilter
SystemCallErrorNumber NoNewPrivileges UMask PrivateTmp PrivateDevices PrivateNetwork
RestrictAddressFamilies RestrictNamespaces RestrictSUIDSGID LockPersonality ProtectKernelTunables
ProtectKernelModules ProtectKernelLogs ProtectControlGroups ProtectClock ProtectHostname
OOMScoreAdjust CPUWeight IOWeight CPUQuotaPerSecUSec MemoryMax MemoryHigh TasksMax Nice LimitNOFILE
Restart TimeoutStopUSec Slice"

unit_settings() {  # unit_settings <unit>: PARITY as key=value, the unit's own name and where
  # it serves (the standby's socket) written as the serving unit's (ExecStart: argv only)
  systemctl show "$1" $(printf -- '-p %s ' $PARITY) | sed -e 's/^\(ExecStart=\).*argv\[\]=\([^;]*\);.*/\1\2/' \
    -e "s/$1\b/$API_UNIT/g" -e "s|--unix-socket [^ ]*|--port $API_PORT|g" | sort
}

slot_conf() {  # the standby's ExecStart drop-in: plx-api.service's own argv, --port %i
  local argv
  argv=$(systemctl show -p ExecStart --value "$API_UNIT" | sed -n 's/.*argv\[\]=\([^;]*\) ;.*/\1/p')
  argv=${argv% }
  [ "$(grep -o -- "--port $API_PORT\b" <<<"$argv" | wc -l)" = 1 ] || return 1
  [[ $argv =~ ^[A-Za-z0-9_./=:@$\ -]+$ ]] || return 1
  printf '%s\n' "# written by plx-release (ARCH-T6): $API_UNIT.service's own ExecStart on the standby's socket;" \
    "# every other setting comes from the mirrored $API_UNIT.service drop-ins beside this file" \
    "[Service]" "ExecStart=" "ExecStart=${argv/--port $API_PORT/--unix-socket /run/plx-api-%i/api.sock}"
}

SYNC_DRY=0   # 1 (plx-release slots): only say whether the mirror is out of date
slots_sync() {  # mirror plx-api.service's drop-ins into plx-api@.service.d; prints "changed"
  local dir="$UNIT_DIR/$API_UNIT@.service.d" want conf changed=0 path name
  want=$(slot_conf) || { echo "$API_UNIT.service's ExecStart does not name --port $API_PORT once"; return 1; }
  [ "$SYNC_DRY" = 1 ] || sudo -n mkdir -p "$dir" || return 1
  local keep=" zzzz-slot.conf "
  for path in $(systemctl show -p DropInPaths --value "$API_UNIT"); do
    case $path in */"$API_UNIT".service.d/*.conf) ;; *) continue ;; esac   # not the prefix ones
    name=$(basename "$path")
    [[ $name < zzzz-slot.conf ]] || { echo "drop-in $name sorts after zzzz-slot.conf"; return 1; }
    keep="$keep$name "
    if [ "$(readlink "$dir/$name" 2>/dev/null)" != "$path" ]; then
      changed=1; [ "$SYNC_DRY" = 1 ] || sudo -n ln -sfn "$path" "$dir/$name" || return 1
    fi
  done
  if [ "$(cat "$dir/zzzz-slot.conf" 2>/dev/null)" != "$want" ]; then
    changed=1
    if [ "$SYNC_DRY" = 0 ]; then
      printf '%s\n' "$want" | sudo -n tee "$dir/zzzz-slot.conf" >/dev/null || return 1
      sudo -n chmod 0644 "$dir/zzzz-slot.conf" || return 1
    fi
  fi
  for path in "$dir"/*; do   # a drop-in plx-api.service no longer has
    [ -e "$path" ] || [ -L "$path" ] || continue
    name=$(basename "$path")
    case $keep in *" $name "*) ;; *) changed=1; [ "$SYNC_DRY" = 1 ] || sudo -n rm -f "$path" || return 1 ;; esac
  done
  [ "$changed" = 1 ] || return 0
  if [ "$SYNC_DRY" = 1 ]; then echo "out of date (plx-release slots sync)"; return 1; fi
  sudo -n systemctl daemon-reload || return 1
  echo changed
}

warm_refusal() {  # empty when the warm switch may run, else why not
  local standby; standby=$(slot_unit "$STANDBY")
  [ "$(systemctl show -p LoadState --value "$standby")" = loaded ] \
    || { echo "$API_UNIT@.service is not installed"; return; }
  local out; out=$(slots_sync) || { echo "the standby's drop-ins were not synced: $out"; return; }
  local diff
  diff=$(diff <(unit_settings "$API_UNIT") <(unit_settings "$standby") \
         | sed -n 's/^[<>] \([A-Za-z]*\)=.*/\1/p' | sort -u | tr '\n' ' ')
  [ -z "$diff" ] || { echo "$standby differs from $API_UNIT in: $diff"; return; }
  local avail have
  avail=$(mem_available_mb); have=$(api_memory_mb) || { echo "the API's memory could not be read"; return; }
  if [ $((avail - have)) -lt "$MEM_RESERVE_MB" ]; then
    echo "memory: ${avail} MB available, a second API needs ~${have} MB and ${MEM_RESERVE_MB} MB stay free"
    return
  fi
  local pg; pg=$(pg_room)
  [ -z "$pg" ] || { echo "$pg"; return; }
  caddy_sends_to_standby \
    || echo "the running Caddy does not send /api/* to $STANDBY_SOCKET (reload plx-caddy on a Caddyfile that does)"
}

release_code() {  # the code version of current's operator_api (what /api/ready reports)
  (cd "$PLX_CURRENT" && env -u PLX_WORKBENCH_API_KEY "$PLX_VENV/bin/python3" -c \
    'from operator_api.page_store import code_version; print(code_version())' 2>/dev/null)
}

wait_ready() {  # wait_ready <port> <code version>: 0 once ready on that code, else 1 (says why)
  local port=$1 want=$2 unit; unit=$(slot_unit "$1")
  local end=$((SECONDS + READY_S)) body state healthy=0
  while [ $SECONDS -lt $end ]; do
    state=$(systemctl is-active "$unit" || true)
    [ "$state" = active ] || { echo "$unit is $state" >&2; return 1; }
    if [ "$(mem_available_mb)" -lt "$MEM_FLOOR_MB" ]; then
      echo "memory under ${MEM_FLOOR_MB} MB available while $unit warmed" >&2; return 1
    fi
    if [ "$healthy" = 0 ]; then
      [ "$(api_health "$port")" = 200 ] && healthy=1
    fi
    warm_restore due
    if [ "$healthy" = 1 ]; then
      body=$(api_get "$port" /api/ready || true)
      if [[ $body =~ \"ready\":\ *true ]]; then
        [[ $body =~ \"code_version\":\ *\"$want\" ]] && return 0
        echo "$unit is ready on another code version than $(current_id)" >&2; return 1
      fi
    fi
    sleep 2
  done
  echo "$unit not ready within ${READY_S} s" >&2
  return 1
}

LOWERED=""   # "<cgroup dir>|<cpu.weight>|<io.weight>|<since>" while a warming unit is lowered

cg_write() {  # cg_write <file> <value>: as the caller when it may write it, else sudo -n
  if [ -w "$1" ]; then printf '%s\n' "$2" > "$1"; else printf '%s\n' "$2" | sudo -n tee "$1" >/dev/null; fi
}

warm_low() {  # warm_low <unit>: its cgroup's weights lowered while it warms (WARM_CPU_WEIGHT)
  local cg="$CGROUP_ROOT/system.slice/$1.service" cpu io
  LOWERED=""
  cpu=$(cat "$cg/cpu.weight" 2>/dev/null) || return 0   # no cgroup (stopped, or none here)
  [[ $cpu =~ ^[0-9]+$ ]] && [ "$cpu" -gt "$WARM_CPU_WEIGHT" ] || return 0
  io=$(sed -n 's/^default \([0-9][0-9]*\)$/\1/p' "$cg/io.weight" 2>/dev/null || true)
  cg_write "$cg/cpu.weight" "$WARM_CPU_WEIGHT" || return 0
  LOWERED="$cg|$cpu|$io|$SECONDS"
  if [ -n "$io" ] && [ "$io" -gt "$WARM_IO_WEIGHT" ]; then
    cg_write "$cg/io.weight" "default $WARM_IO_WEIGHT" || true
  fi
}

warm_restore() {  # the lowered unit's own weights again (also once WARM_LOW_S passed: "due")
  [ -n "$LOWERED" ] || return 0
  local cg cpu io since; IFS='|' read -r cg cpu io since <<<"$LOWERED"
  [ "${1:-}" = due ] && [ $((SECONDS - since)) -lt "$WARM_LOW_S" ] && return 0
  LOWERED=""
  [ -e "$cg/cpu.weight" ] || return 0   # the unit stopped: its next start has its own
  cg_write "$cg/cpu.weight" "$cpu" || true
  [ -z "$io" ] || cg_write "$cg/io.weight" "default $io" || true
}

warm_heal() {  # each API unit's cgroup back at its own weights (a deploy killed mid-warm-up)
  local unit cg own io
  for unit in "$API_UNIT" "$(slot_unit "$STANDBY")"; do
    cg="$CGROUP_ROOT/system.slice/$unit.service"
    [ -e "$cg/cpu.weight" ] || continue
    own=$(systemctl show -p CPUWeight --value "$unit" 2>/dev/null || true)
    [[ $own =~ ^[0-9]+$ ]] || own=100   # systemd's default when the unit sets none
    [ "$(cat "$cg/cpu.weight")" = "$own" ] || { cg_write "$cg/cpu.weight" "$own" || true; echo "$(plx_now) $unit cpu.weight back at $own" >&2; }
    io=$(systemctl show -p IOWeight --value "$unit" 2>/dev/null || true)
    [[ $io =~ ^[0-9]+$ ]] || io=100
    if [ -e "$cg/io.weight" ] && [ "$(sed -n 's/^default //p' "$cg/io.weight")" != "$io" ]; then
      cg_write "$cg/io.weight" "default $io" || true
    fi
  done
}

hold_of() { if [ "$1" = "$API_PORT" ]; then echo "$API_PORT"; else echo "$STANDBY_HOLD"; fi; }

start_held() {  # start_held <port|standby> <code> [low]: its unit (re)started on current, its port or
  # socket opened only once warm (the hold file), and ready on that code; 1 (says why) otherwise
  local unit name; unit=$(slot_unit "$1"); name=$(hold_of "$1")
  local t0=$SECONDS
  hold "$name" || { echo "no hold file in $HOLD_DIR" >&2; return 1; }
  # interrupted: no hold file outlives this run (a later start would hold; server.py also
  # ignores one older than 15 min)
  trap "warm_restore; unhold '$name'; exit 130" INT TERM HUP
  if ! sudo systemctl restart "$unit"; then
    unhold "$name"; trap - INT TERM HUP; return 1
  fi
  # lowered only when asked (plx-api's restart, while the standby serves alone): the
  # standby's own warm-up beside the old, warm API runs at its own weight, since at 100
  # it hit the first pass's 420 s cut with 23 of 59 reads not done and then served them
  # cold (11-21 7:03 AM ET deploy: 10.5 min, Home not done in 30 s after the switch)
  [ "${3:-}" = low ] && warm_low "$unit"
  if ! wait_ready "$1" "$2"; then
    warm_restore; unhold "$name"; trap - INT TERM HUP; return 1
  fi
  warm_restore; unhold "$name"; trap - INT TERM HUP
  echo "$(plx_now) $unit warm on $(current_id) in $((SECONDS - t0)) s"
}

warm_switch() {  # 0: plx-api.service serves current, warm; 1: the API that served still does
  # the lock is released on every return: the self-rollback's nested restart switches again
  # (11-15 review: it waited 900 s on this run's lock, plx-api left on the failed release).
  # flock -u, not only the close: units started meanwhile may hold a copy of fd 8
  exec 8>"${TMPDIR:-/tmp}/plx-api-switch-$(id -u).lock"
  flock -w 900 8 || { exec 8>&-; echo "another switch holds the lock" >&2; return 1; }
  local rc=0
  warm_switch_locked || rc=$?
  flock -u 8; exec 8>&-
  return $rc
}

warm_switch_locked() {
  local want standby; standby=$(slot_unit "$STANDBY")
  unhold "$API_PORT"; unhold "$STANDBY_HOLD"   # an interrupted run's, if any
  warm_heal                                    # and its lowered weights
  want=$(release_code) && [ -n "$want" ] \
    || { echo "the code version of $(current_id) could not be read" >&2; return 1; }
  if systemctl is-active -q "$API_UNIT"; then
    # the standby, warm on current, takes the readers while plx-api.service restarts
    if ! start_held "$STANDBY" "$want"; then
      sudo systemctl stop "$standby" || true
      echo "$standby was not ready on $(current_id): $API_UNIT keeps serving the release it runs" >&2
      return 1
    fi
  fi
  # plx-api.service: SIGTERM closes 8780 and ends what is under way (Caddy sends the next
  # request to the standby), then it starts on current and opens 8780 once warm
  if ! start_held "$API_PORT" "$want" low; then
    sudo systemctl stop "$API_UNIT" || true
    echo "$API_UNIT was not ready on $(current_id): $standby keeps serving it" >&2
    return 1
  fi
  # Caddy passes over an upstream that refused for its fail_duration: then 8780 serves again
  sleep "$PASS_OVER_S"
  sudo systemctl stop "$standby" || true
  return 0
}

slots() {
  echo "$API_UNIT: $(systemctl is-active "$API_UNIT" || true); $(slot_unit "$STANDBY"): $(systemctl is-active "$(slot_unit "$STANDBY")" || true)"
  if [ "${1:-}" = sync ]; then slots_sync || true; else SYNC_DRY=1; fi
  local why; why=$(warm_refusal)
  echo "warm switch: ${why:-on}"
  warm_heal
}

status() {
  echo "current:  $(current_id)"
  echo "previous: $(basename "$(readlink "$PLX_RELEASES/previous" 2>/dev/null || echo none)")"
  [ -f "$PLX_RELEASES/current/RELEASE.json" ] && cat "$PLX_RELEASES/current/RELEASE.json"
  local pid cwd
  for pid in $(pgrep -u "$PLX_USER" -f 'python3 -m (operator_api|operating|ontology)' || true); do
    cwd=$(readlink "/proc/$pid/cwd" 2>/dev/null || true)
    [ -n "$cwd" ] && echo "pid $pid runs from ${cwd#$PLX_RELEASES/}"
  done | sort -k4 | uniq -c -f3 | sed 's/^ *//' || true
}

list() {
  local d
  for d in "$PLX_RELEASES"/*/RELEASE.json; do
    [ -f "$d" ] || continue
    printf '%s  %s\n' "$(basename "$(dirname "$d")")" "$(date -r "$d" +%FT%T)"
  done
}

prune() {
  local keep=5
  [ "${1:-}" = "--keep" ] && keep=$2
  local cur prev busy d n=0
  cur=$(current_id); prev=$(basename "$(readlink "$PLX_RELEASES/previous" 2>/dev/null || echo none)")
  busy=$(for p in "$PROC"/[0-9]*; do readlink "$p/cwd" 2>/dev/null || true; done | sort -u)
  for d in $(ls -1td "$PLX_RELEASES"/*/ 2>/dev/null); do
    d=${d%/}; local id; id=$(basename "$d")
    [ -L "$d" ] && continue   # current/previous: links, never releases (rm -rf would drop the link)
    [ -f "$d/RELEASE.json" ] || continue
    n=$((n + 1))
    if [ "$id" = "$cur" ] || [ "$id" = "$prev" ] || [ $n -le "$keep" ] || grep -qx "$d.*" <<<"$busy"; then continue; fi
    as_root rm -rf "$d" && log "pruned $id" && echo "pruned $id"
  done
}

verify() {   # verify [<id>]: sealed = owned by the release owner, nothing group/other-writable
  local id=${1:-$(current_id)} owner=${PLX_RELEASE_OWNER:-root}
  local dir="$PLX_RELEASES/$id"
  [ -f "$dir/RELEASE.json" ] || die "no built release $id"
  local bad
  bad=$(find "$dir" \( ! -user "$owner" -o -perm /022 \) ! -type l -print 2>/dev/null | head -5)
  if [ -n "$bad" ]; then
    echo "release $id is NOT sealed (owner $owner, no group/other write); first offenders:" >&2
    echo "$bad" | sed "s|^$PLX_RELEASES/||" >&2
    return 1
  fi
  echo "release $id sealed: owned by $owner, nothing writable by group or others"
}

cmd=${1:-status}; shift || true
case $cmd in
  build|preflight|migrate|switch|rollback|restart|deploy|slots|status|list|prune|verify) "$cmd" "$@" ;;
  *) die "unknown command $cmd (build|preflight|migrate|switch|rollback|restart|deploy|slots|status|list|prune|verify)" ;;
esac
