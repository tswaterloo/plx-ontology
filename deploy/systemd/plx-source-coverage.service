# Every source reachable (operating.pg.source_coverage): per source system and per served
# type, the records the sources hold against those a full reader reaches through the AI's
# door (records, the curated and communications tables). Counts only, to
# <state>/source-coverage/status.json (+ baseline.json); the reliability alarms raise
# source_coverage (high) when a type's reachable share drops, a new type is unreachable,
# a door view disagrees with its table, or the check could not run or is over 14 h old.
# Reads no business system and writes no table: every credential is dropped.
[Unit]
Description=PLX source coverage check (every type reachable through the door)
After=postgresql.service

[Service]
Type=oneshot
User=@PLX_USER@
Group=@PLX_GROUP@
WorkingDirectory=@PLX_CURRENT@
EnvironmentFile=/etc/plx/ingest.env
EnvironmentFile=@PLX_HOME@/.config/plx/plx.env
UnsetEnvironment=AZURE_CLIENT_SECRET BC_CLIENT_SECRET MICROSOFT_GRAPH_CLIENT_SECRET MC_MCP_API_KEY PLX_WORKBENCH_API_KEY AZURE_STORAGE_KEY AZURE_DOC_INTEL_KEY PLX_WORKBENCH_SESSION_SECRET
Environment=PATH=/data/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PGAPPNAME=%N
ExecStart=/data/venv/bin/python3 -m operating.pg.source_coverage run --state-dir ${PLX_INGEST_STATE}
# exit 1 = alarms found (reported through the status file, not a unit failure)
SuccessExitStatus=1
Nice=10
CPUWeight=20
IOWeight=20
MemoryMax=1G
TimeoutStartSec=30min
UMask=0077
