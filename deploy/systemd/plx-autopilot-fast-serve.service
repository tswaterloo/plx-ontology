[Unit]
# operating/autopilot_fast.serve (AUDIT3-10): one consumer reads a capture's signal within
# a second; while it is down plx-autopilot-follow is its backstop (the per-signal
# plx-autopilot-fast units were retired). Prepares My work items only (never sends,
# writes or approves).
Description=PLX Workbench autopilot fast feed, continuous (prepares work items only)
After=postgresql.service
# a failing consumer backs off itself (15 s doubling to 15 min, before it takes the lock)
# and pages after 3 failures in a row (ops_alarms autopilot_fast_restarts)
StartLimitIntervalSec=0

[Service]
Type=simple
User=@PLX_USER@
Group=@PLX_GROUP@
WorkingDirectory=@PLX_CURRENT@
EnvironmentFile=-@PLX_HOME@/.config/plx/proactive.env
# the consumer re-checks this file before each cycle and ends when it changed (a new people
# exclusion or PLX_AUTOPILOT_OFF), so Restart=always starts it over the new values
Environment=PLX_PROACTIVE_ENV=@PLX_HOME@/.config/plx/proactive.env
Environment=PATH=/data/venv/bin:/usr/local/bin:/usr/bin:/bin
# This consumer is the fast feed, so it carries every drafting setting the live feed
# (plx-autopilot-follow.service) has (operating/tests/test_install_keep_fresh.py holds
# them). Without them it prepared
# no reply draft for anyone (2026-11-18: 0 drafts in the live queue in two weeks, every
# model-drafted item dropped as draft_model_off).
# the chat ask reader (operating.chat_ask_model): claude -p on the user's own login
Environment=PLX_CHAT_ASK_MODEL=haiku
# reply drafts for the people who switched them on (operating/autopilot_drafter.py)
Environment=PLX_AUTOPILOT_DRAFT_MODEL=opus
# look-ups as the person the draft is for (operator_api.autopilot_context.Lookup): the
# session secret and the readers file; either absent: no look-up, the plain draft
EnvironmentFile=-@PLX_HOME@/.config/plx/workbench-session.env
Environment=PLX_AUTOPILOT_READERS_FILE=@PLX_HOME@/.config/plx/autopilot-readers.json
Environment=PLX_AUTOPILOT_HOST_CONFIG=@PLX_HOME@/.config/plx/workbench-host-vince/host.json
Environment=PLX_AUTOPILOT_HOST_STATE=/data/plx-state
# names its Postgres sessions after the unit (ARCH T2: pg_stat_activity, slow-query log)
Environment=PGAPPNAME=%N
Environment=PLX_ONTOLOGY_PG=only
Environment=PLX_AUTOPILOT_EVQ=1
# the person's memory and template for each draft (operator_api.autopilot_context), and
# from plx.env only the allowlisted names (autopilot_context.ENV_ALLOWED)
Environment=PLX_AUTOPILOT_ENV_FILE=@PLX_HOME@/.config/plx/plx.env
Environment=PLX_AUTOPILOT_MEMORY_DSN=postgresql:///plx
# a new release: the consumer ends and Restart=always runs it on that release
Environment=PLX_RELEASE_CURRENT=@PLX_CURRENT@
ExecStart=/data/venv/bin/python3 -m operator_api.autopilot_context fast --serve --state-dir /data/plx-state
Nice=5
CPUWeight=100
MemoryHigh=4G
MemoryMax=6G
MemorySwapMax=512M
TimeoutStopSec=5min
Restart=always
RestartSec=15s
UMask=0077

[Install]
WantedBy=multi-user.target
