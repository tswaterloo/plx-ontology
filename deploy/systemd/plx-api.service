# PLX Workbench API (operator_api), behind Caddy. Not enabled by the build.
# Runs as the dedicated unprivileged user plx-workbench (deploy/README.md).
# The serve flags (mode, state directory, Entra resource file) live in
# /etc/plx/workbench-api.env as PLX_API_ARGS, so this file holds no secrets.
#   demo over fixtures:  PLX_API_ARGS=--mock
#   production:          PLX_API_ARGS=--entra-resource /etc/plx/entra-resource.json --state-dir /var/lib/plx-workbench/state
# If the state directory lives elsewhere, add it with a drop-in:
#   sudo systemctl edit plx-api   ->   [Service]  ReadWritePaths=/that/dir
[Unit]
Description=PLX Workbench API (operator_api)
After=network-online.target postgresql.service
Wants=network-online.target
# always up: a crash loop backs off (3 s doubling to 2 min) instead of
# restarting 140 times an hour (seen on plx-api), and past 20 starts in 30 min the unit stays
# failed for plx-liveness.timer to start again after its cooldown, with an alarm
StartLimitIntervalSec=30min
StartLimitBurst=20

[Service]
# DI-02: Postgres is the only store (no projection file)
Environment=PLX_ONTOLOGY_PG=only
# names its Postgres sessions after the unit (ARCH T2)
Environment=PGAPPNAME=%N
Type=simple
User=plx-workbench
Group=plx-workbench
WorkingDirectory=@PLX_CURRENT@
EnvironmentFile=/etc/plx/workbench-api.env
# the measured system-of-record precedence (plx-precedence-measure.service writes it)
Environment=PLX_PRECEDENCE_TABLE=/data/plx-state/precedence/measured.json
# every model call counted (operating/model_ledger.py: no prompt or answer text)
Environment=PLX_MODEL_LEDGER=/var/lib/plx-workbench/model-calls.jsonl
# the model that writes a reply from a person's one line (POST /api/autopilot/items/{id}/reply-from-line,
# operating/autopilot_drafter.py); unset it answers 409. It runs on the autopilot's own access-token-only
# claude home, never an operator's ~/.claude (operating/chat_ask_model.py)
Environment=PLX_AUTOPILOT_DRAFT_MODEL=opus
Environment=PLX_CHAT_ASK_CLAUDE_HOME=/var/lib/plx-autopilot/claude-home
ExecStart=/usr/bin/env python3 -m operator_api serve --bind 127.0.0.1 --port 8780 $PLX_API_ARGS
# always: a clean exit (0, or a stop that was not systemctl's) is brought back too
Restart=always
RestartSteps=6
RestartMaxDelaySec=2min
RestartSec=3
# SIGTERM: the requests under way end (60 s at most), then the workers (20 s) (ARCH-T6)
TimeoutStopSec=100

# Hardening: read-only everywhere except the API's own state directory.
StateDirectory=plx-workbench
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/plx-workbench -/var/lib/plx-autopilot/claude-home
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0027

[Install]
WantedBy=multi-user.target
