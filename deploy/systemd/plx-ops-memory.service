# The memory checks of the reliability alarms (operating.ops_alarms memory) every minute,
# between the full 5-minute passes: an alert pass plus agents went from comfortable to an
# OOM kill faster than one full pass. Available memory under 8 GB (memory_warn_gb) opens an
# incident in the app with the top leaf cgroups and processes named; under 6 GB for 5
# minutes is the second, louder incident. Same state and lock as plx-ops-health; reads
# /proc and /sys/fs/cgroup only and sends nothing.
[Unit]
Description=PLX Workbench memory early warning (every minute)

[Service]
Type=oneshot
User=@PLX_USER@
Group=@PLX_GROUP@
WorkingDirectory=@PLX_CURRENT@
EnvironmentFile=/etc/plx/ingest.env
EnvironmentFile=-@PLX_HOME@/.config/plx/plx.env
# Reads no business system: the credentials that can send, write or reach one are dropped
# (SEC-S-05; tests/test_deploy_release.py names the units that may keep them).
UnsetEnvironment=AZURE_CLIENT_SECRET BC_CLIENT_SECRET MICROSOFT_GRAPH_CLIENT_SECRET MC_MCP_API_KEY PLX_WORKBENCH_API_KEY AZURE_STORAGE_KEY AZURE_DOC_INTEL_KEY PLX_WORKBENCH_SESSION_SECRET
EnvironmentFile=-/etc/plx/workbench-api.env
EnvironmentFile=-/etc/plx/ops-page.env
Environment=PATH=/data/venv/bin:/usr/local/bin:/usr/bin:/bin
# names its Postgres sessions after the unit (ARCH T2: pg_stat_activity, slow-query log)
Environment=PGAPPNAME=%N
ExecStart=/data/venv/bin/python3 -m operating.ops_alarms memory --state-dir ${PLX_INGEST_STATE}
# runs when memory is short: small, but never the one the kernel picks first
Nice=5
CPUWeight=50
MemoryHigh=256M
MemoryMax=512M
OOMScoreAdjust=-500
TimeoutStartSec=50s
UMask=0077
