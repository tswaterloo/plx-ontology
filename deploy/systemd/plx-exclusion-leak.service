# The people-exclusion leak scan (operating.exclusion_leak): counts what is still served or
# in the search index of an excluded person's mail and 1:1 chats, and of the mail the
# capture withholds (the daily purge's own dry run, a transaction rolled back). Counts only
# to <state>/exclusion-leak/status.json; the reliability alarms raise exclusion_leak
# (critical) on more than 0, a scan that could not run or one over 3 h old. Reads no
# business system: the exclusion list comes from plx.env, every credential is dropped.
[Unit]
Description=PLX people-exclusion leak scan (hourly, counts only)
After=postgresql.service

[Service]
Type=oneshot
User=@PLX_USER@
Group=@PLX_GROUP@
WorkingDirectory=@PLX_CURRENT@
EnvironmentFile=/etc/plx/ingest.env
# PLX_PG_DSN and the exclusion list (PLX_EXCLUDED_PEOPLE_OIDS / _FILE)
EnvironmentFile=@PLX_HOME@/.config/plx/plx.env
UnsetEnvironment=AZURE_CLIENT_SECRET BC_CLIENT_SECRET MICROSOFT_GRAPH_CLIENT_SECRET MC_MCP_API_KEY PLX_WORKBENCH_API_KEY AZURE_STORAGE_KEY AZURE_DOC_INTEL_KEY PLX_WORKBENCH_SESSION_SECRET
Environment=PATH=/data/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PGAPPNAME=%N
ExecStart=/data/venv/bin/python3 -m operating.exclusion_leak run --state-dir ${PLX_INGEST_STATE}
Nice=10
CPUWeight=20
IOWeight=20
MemoryMax=2G
TimeoutStartSec=30min
UMask=0077
