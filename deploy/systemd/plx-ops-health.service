# The reliability alarms (operating.ops_alarms): one pass every 5 minutes over freshness
# (delta, each capture source, search follow, proactive), failed or stuck plx-* system and
# user units, Postgres connections, free disk and memory, and the backups. A breach opens an
# incident the app shows (the banner on every page and /ops) to the owner and the Team
# readers until it recovers; nothing is paged or mailed. The pass
# exits 0 whatever it finds (the banner is the alarm); a failed unit means the checker
# itself broke, and the banner says the checks have not run. The env files name values,
# never hold them here.
[Unit]
Description=PLX Workbench reliability alarms (freshness, units, Postgres, disk, memory, backups)

[Service]
Type=oneshot
User=@PLX_USER@
Group=@PLX_GROUP@
WorkingDirectory=@PLX_CURRENT@
EnvironmentFile=/etc/plx/ingest.env
# PLX_PG_DSN as the API has it
EnvironmentFile=-@PLX_HOME@/.config/plx/plx.env
# Reads no business system: the credentials that can send, write or reach one are dropped
# (SEC-S-05; tests/test_deploy_release.py names the units that may keep them).
UnsetEnvironment=AZURE_CLIENT_SECRET BC_CLIENT_SECRET MICROSOFT_GRAPH_CLIENT_SECRET MC_MCP_API_KEY PLX_WORKBENCH_API_KEY AZURE_STORAGE_KEY AZURE_DOC_INTEL_KEY PLX_WORKBENCH_SESSION_SECRET
EnvironmentFile=-/etc/plx/workbench-api.env
# optionally PLX_OPS_IGNORE_UNITS, PLX_OPS_PG_DSN
EnvironmentFile=-/etc/plx/ops-page.env
Environment=PATH=/data/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/data/venv/bin/python3 -m operating.ops_alarms run --state-dir ${PLX_INGEST_STATE}
Nice=10
CPUWeight=20
MemoryHigh=512M
MemoryMax=1G
TimeoutStartSec=4min
UMask=0077
