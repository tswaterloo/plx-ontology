# PLX Workbench web app (Next.js production server), behind Caddy.
# Runs as the dedicated unprivileged user plx-workbench (created per
# deploy/README.md). Install: see deploy/README.md. Not enabled by the build.
[Unit]
Description=PLX Workbench web app (Next.js)
After=network-online.target plx-api.service
Wants=network-online.target
# always up: a crash loop backs off (3 s doubling to 2 min) instead of
# restarting 140 times an hour (seen on plx-api), and past 20 starts in 30 min the unit stays
# failed for plx-liveness.timer to start again after its cooldown, with an alarm
StartLimitIntervalSec=30min
StartLimitBurst=20

[Service]
Type=simple
User=plx-workbench
Group=plx-workbench
WorkingDirectory=@PLX_CURRENT@/app
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=PATH=/data/tools/node/bin:/usr/bin:/bin
# names its Postgres sessions after the unit (ARCH T2: pg_stat_activity, slow-query log)
Environment=PGAPPNAME=%N
# Loopback only: Caddy is the only way in.
ExecStart=/data/tools/node/bin/node node_modules/next/dist/bin/next start -p 3000 -H 127.0.0.1
# always: a clean exit (0, or a stop that was not systemctl's) is brought back too
Restart=always
RestartSteps=6
RestartMaxDelaySec=2min
# next exits 143 on SIGTERM: a stop is not a failure
SuccessExitStatus=143
RestartSec=3

# Hardening: read-only everywhere except Next's runtime cache.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@PLX_CURRENT@/app/.next/cache
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0027

[Install]
WantedBy=multi-user.target
