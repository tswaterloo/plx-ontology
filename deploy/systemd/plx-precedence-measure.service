# PLX Workbench measured system-of-record precedence: one run of
# `python3 -m operating.source_precedence` over the Postgres ontology. Per record type x
# field it counts how often each source's copy (FileMaker, the Portal, Sage, BC) agreed
# with the downstream evidence (shipments, invoices, receipts, completion records) and
# writes the table the read tools trust disagreeing copies by (PLX_PRECEDENCE_TABLE; the
# API unit names the same file). Read-only on the store; writes only its table. Started
# weekly by plx-precedence-measure.timer.
[Unit]
Description=PLX measured system-of-record precedence (one run)
After=postgresql.service

[Service]
Type=oneshot
User=@PLX_USER@
Group=@PLX_GROUP@
WorkingDirectory=@PLX_CURRENT@
EnvironmentFile=@PLX_HOME@/.config/plx/plx.env
# Reads no business system: the credentials that can send, write or reach one are dropped
# (SEC-S-05; tests/test_deploy_release.py names the units that may keep them).
UnsetEnvironment=AZURE_CLIENT_SECRET BC_CLIENT_SECRET MICROSOFT_GRAPH_CLIENT_SECRET MC_MCP_API_KEY PLX_WORKBENCH_API_KEY AZURE_STORAGE_KEY AZURE_DOC_INTEL_KEY PLX_WORKBENCH_SESSION_SECRET
Environment=PATH=/data/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/data/venv/bin/python3 -m operating.source_precedence --pg-dsn "dbname=plx" --out /data/plx-state/precedence/measured.json
Nice=10
IOSchedulingClass=idle
MemoryHigh=2G
MemoryMax=3G
TimeoutStartSec=4h
UMask=0077
