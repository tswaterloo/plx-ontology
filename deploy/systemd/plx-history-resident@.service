# PLX resident History builder, one shard (instance "0-of-4" = shard 0 of 4): every purchase order
# page's History tab kept current per record (operator_api/history_resident.py). The process runs
# on the s7d3d Spark, in spark_run's sandbox against the Spark's hot standby; this unit holds its
# ssh and starts it again when it ends (it ends itself when the people exclusion changes, so the
# new list reaches it on ssh's stdin, and after a fixed number of answers or hours).
# Not enabled by the build: enabled by hand once the Spark's memory is checked
# (deploy/spark/history_resident.sh; settings in /etc/plx/plan-resident.env, non-secret).
[Unit]
Description=PLX resident History builder (a Spark process), shard %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=30min
StartLimitBurst=40

[Service]
Type=simple
User=@PLX_USER@
Group=@PLX_GROUP@
WorkingDirectory=@PLX_CURRENT@
Environment=PGAPPNAME=%N
ExecStart=@PLX_CURRENT@/deploy/spark/history_resident.sh run --shard %i
Restart=always
RestartSec=30
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=multi-user.target
