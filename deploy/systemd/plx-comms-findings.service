# PLX Workbench comms findings: one run of `python3 -m operating.pg.comms_findings run`,
# after each business views refresh (plx-business-views.service names this unit in
# OnSuccess=) and on its own timer (plx-comms-findings.timer). Reads the mail and Teams
# messages of the last 30 days not read yet (up to 600 a run, newest first), screened before
# any model call (Freightcom, the people exclusion, pay or HR matter, marked text, bulk
# mail), and keeps the decisions, requests, complaints and praise a model finds in them as
# rows of biz.comms_findings (no body, quote or address), which plx.sql reads only through
# biz_sql.comms_findings: a finding shows only with a copy of its message the reader may
# read. Writes only biz.comms_findings, biz.comms_read, biz.comms_findings_runs and that view.
# The model: claude -p on the Workbench's own access-token config (no tools, no settings);
# PLX_COMMS_FINDINGS_MODEL=off (or unset) reads nothing. One run at a time.
# The people exclusion comes from proactive.env (fails
# closed without it: nothing is read). The user is the business schema's owner (it makes
# the guarded view).
[Unit]
Description=PLX comms findings over mail and Teams (one run)
After=postgresql.service

[Service]
Type=oneshot
User=@PLX_USER@
Group=@PLX_GROUP@
WorkingDirectory=@PLX_CURRENT@
EnvironmentFile=/etc/plx/ingest.env
EnvironmentFile=@PLX_HOME@/.config/plx/plx.env
EnvironmentFile=-@PLX_HOME@/.config/plx/proactive.env
# Reads no business system: the credentials that can send, write or reach one are dropped
# (SEC-S-05; tests/test_deploy_release.py names the units that may keep them).
UnsetEnvironment=AZURE_CLIENT_SECRET BC_CLIENT_SECRET MICROSOFT_GRAPH_CLIENT_SECRET MC_MCP_API_KEY PLX_WORKBENCH_API_KEY AZURE_STORAGE_KEY AZURE_DOC_INTEL_KEY PLX_WORKBENCH_SESSION_SECRET
Environment=PATH=/data/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PGAPPNAME=%N
Environment=PLX_ONTOLOGY_PG=only
Environment=PLX_COMMS_FINDINGS_MODEL=sonnet
ExecCondition=/bin/sh -c '/data/venv/bin/python3 -c "import ontology.window_lock" 2>/dev/null || exit 0; exec /data/venv/bin/python3 -m ontology.window_lock check delta'
ExecStart=/data/venv/bin/python3 -m operating.pg.comms_findings run
MemoryHigh=1500M
MemoryMax=2G
TimeoutStartSec=45min
TimeoutStopSec=1min
UMask=0077
