# PLX Workbench bare-mention rebuild (row 14), nightly at low priority: one run of
# `python3 -m operating.pg.bare_mentions build`. Links every current captured mail's bare
# identifiers (customer and item codes, order numbers) into ontology.bare_mentions through a
# staging table and one merge, so readers (PLX_PG_BARE_MENTIONS=1) never see a half table.
# It closes the gap the delta refresh leaves: a mail naming a record by an identifier new to
# that record links within a day. Excluded people's mail is never read (the exclusion not
# loaded refuses). Does nothing until migration 0035 is applied (--if-migrated); skipped in a
# migration window (window_lock). Started by plx-bare-mentions.timer.
[Unit]
Description=PLX bare-mention rebuild (one run)
After=postgresql.service

[Service]
Type=oneshot
User=@PLX_USER@
Group=@PLX_GROUP@
WorkingDirectory=@PLX_CURRENT@
EnvironmentFile=/etc/plx/ingest.env
EnvironmentFile=@PLX_HOME@/.config/plx/plx.env
# Reads no business system: the credentials that can send, write or reach one are dropped
# (SEC-S-05; tests/test_deploy_release.py names the units that may keep them).
UnsetEnvironment=AZURE_CLIENT_SECRET BC_CLIENT_SECRET MICROSOFT_GRAPH_CLIENT_SECRET MC_MCP_API_KEY PLX_WORKBENCH_API_KEY AZURE_STORAGE_KEY AZURE_DOC_INTEL_KEY PLX_WORKBENCH_SESSION_SECRET
Environment=PATH=/data/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PGAPPNAME=%N
ExecCondition=/bin/sh -c '/data/venv/bin/python3 -c "import ontology.window_lock" 2>/dev/null || exit 0; exec /data/venv/bin/python3 -m ontology.window_lock check delta'
ExecStart=/data/venv/bin/python3 -m operating.pg.bare_mentions build --if-migrated --state ${PLX_INGEST_STATE} --workers 16
Nice=19
CPUWeight=20
IOWeight=20
IOSchedulingClass=idle
MemoryHigh=6G
MemoryMax=8G
TimeoutStartSec=3h
UMask=0077
