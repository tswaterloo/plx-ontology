# The autopilot's live event feed (`python3 -m operating.autopilot follow`): one cycle types
# the records changed since the last one (the store's event index over a window, the feed
# the replay gate scores, plus small delta layers once Postgres applied them), stores each
# event once and prepares the work of the workflows that passed their replay gate
# (autopilot-gate.json beside the queue) or are in Draft (operating/autopilot_draft.json),
# into <state>/autopilot/autopilot.sqlite, which My work reads.
#
# Prepares only. Nothing here sends, writes to a business system or approves: a draft goes
# out only through the app's card desk after its owner's confirm, and a write intent only
# through operating.autopilot_write (not run by this unit), dry run until the item's person
# turned the workflow on for themselves and the master switch PLX_AUTOPILOT_WRITES is on. Off at once: PLX_AUTOPILOT_OFF=1 in
# proactive.env, or a file named autopilot.off beside the queue.
#
# PLX_AUTOPILOT_EVQ=1: the cycle's events are handed out through the ordered event queue
# (operating.jobq.events, Postgres plx_jobq): an approval or a customer's message before
# routine updates, one thread's events in order. Postgres unreachable: the cycle is
# "blocked" and its events wait (never handled unordered). PLX_ONTOLOGY_PG=1: reads the
# Postgres ontology, current to the last applied delta layer, as plx-proactive-inc does.
# Started by plx-autopilot-follow.path (a delta publish) and .timer (5 min after the last
# cycle ended). The people exclusion comes from proactive.env (fails closed without it).
[Unit]
Description=PLX Workbench autopilot live feed (prepares work items only)
After=plx-delta.service postgresql.service

[Service]
Type=oneshot
User=@PLX_USER@
Group=@PLX_GROUP@
WorkingDirectory=@PLX_CURRENT@
EnvironmentFile=-@PLX_HOME@/.config/plx/proactive.env
Environment=PATH=/data/venv/bin:/usr/local/bin:/usr/bin:/bin
# names its Postgres sessions after the unit (ARCH T2: pg_stat_activity, slow-query log)
Environment=PGAPPNAME=%N
Environment=PLX_ONTOLOGY_PG=1
Environment=PLX_AUTOPILOT_EVQ=1
ExecStart=/data/venv/bin/python3 -m operating.autopilot follow --state-dir /data/plx-state
# Measured 2026-11-13 on Postgres (loaded box), peak 0.27 GB: a cycle after the store changed
# reads the 72 h window again, 7-9 min (its handling stops at the 240 s budget, the rest
# waits); a cycle over an unchanged store handles what waits, 2 min.
Nice=10
CPUWeight=20
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryHigh=1G
MemoryMax=2G
MemorySwapMax=512M
TimeoutStartSec=30min
UMask=0077
