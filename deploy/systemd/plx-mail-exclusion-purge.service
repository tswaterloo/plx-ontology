# Daily people-exclusion purge of captured mail (operating.mail_exclusion_purge): re-reads
# the in-tenant and draft messages through the GET-only Graph client (scan, resumable),
# decides the attachments by the mail they carry (carried), then removes from Postgres, the
# SQLite stores and the capture store every message the exclusion refuses, every copy the
# capture remembered as withheld and the derived copies of the handles a capture purge
# journalled (purge --apply, under the capture's cycle lock: beside the continuous ingest it
# asks for a gap with --wait-gap, the ingest drains its captures and lets go of the lock for
# the purge, then goes on; no restart). Counts only in the journal,
# never an address. A scan or carried run that stops early (exit 1) resumes next day; the
# purge still removes what is known. Skipped while a window hold blocks delta
# (ontology.window_lock: a migration or maintenance window owns the stores).
[Unit]
Description=PLX mail people-exclusion purge (daily)
After=postgresql.service

[Service]
Type=oneshot
User=@PLX_USER@
Group=@PLX_GROUP@
WorkingDirectory=@PLX_CURRENT@
# PLX_INGEST_STATE and the capture's Graph app (read-only scopes) and exclusion list
EnvironmentFile=/etc/plx/ingest.env
EnvironmentFile=@PLX_HOME@/.config/plx/plx.env
Environment=PATH=/data/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PGAPPNAME=%N
# exit 75 (held) skips the run; a release without window_lock runs it
ExecCondition=/bin/sh -c '/data/venv/bin/python3 -c "import ontology.window_lock" 2>/dev/null || exit 0; exec /data/venv/bin/python3 -m ontology.window_lock check delta'
ExecStart=-/data/venv/bin/python3 -m operating.mail_exclusion_purge scan --state-dir ${PLX_INGEST_STATE} --live-audience @PLX_CURRENT@/examples/ingest_all.capture-audience.json --principal svc:workbench-host --workers 16
ExecStart=-/data/venv/bin/python3 -m operating.mail_exclusion_purge carried --state-dir ${PLX_INGEST_STATE} --live-audience @PLX_CURRENT@/examples/ingest_all.capture-audience.json --workers 16 --apply
ExecStart=/data/venv/bin/python3 -m operating.mail_exclusion_purge purge --state-dir ${PLX_INGEST_STATE} --apply --wait-gap 1200
Nice=10
CPUWeight=20
IOWeight=20
MemoryMax=6G
TimeoutStartSec=5h
UMask=0077
