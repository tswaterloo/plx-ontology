# The autopilot's fast feed (`python3 -m operating.autopilot fast`, run through operator_api.autopilot_context, operating/autopilot_fast.py):
# a Teams or mail message the capture just stored is projected on its own (the one projector,
# a scratch store of those records) and handled over the served Postgres ontology as the live
# feed handles it (people exclusion, replay gate and Draft, horizon, rate limit, ordered event
# queue), so its prepared work is in My work seconds after the capture, not after the next
# delta cycle. The same message typed later by plx-autopilot-follow is the same event, never
# handled twice.
#
# Prepares only, as plx-autopilot-follow: nothing here sends, writes to a business system or
# approves. Off at once: PLX_AUTOPILOT_OFF=1 in proactive.env, or autopilot.off beside the
# queue. Started by plx-autopilot-fast.path (a capture stored a message: <store>.new) and
# .timer (1 min after the last start ended, in case a signal came while a cycle ran); a start
# with nothing new since the last cycle opens no store and exits at once.
[Unit]
Description=PLX Workbench autopilot fast feed (prepares work items only)
After=postgresql.service
# No start rate limit: each capture commit touches its <store>.new, a cycle with nothing new
# ends in ~0.1 s, so a commit burst starts it more than 5 times in 10 s; the default limit
# then failed the start and with it plx-autopilot-fast.path, for good (2026-11-15: off from
# 7:52 AM). The path unit's own trigger limit (200 in 2 s) still bounds a runaway.
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=@PLX_USER@
Group=@PLX_GROUP@
WorkingDirectory=@PLX_CURRENT@
EnvironmentFile=-@PLX_HOME@/.config/plx/proactive.env
# the chat ask reader (operating.chat_ask_model): claude -p on the user's own login
Environment=PATH=/data/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PLX_CHAT_ASK_MODEL=haiku
# reply drafts for the people who switched them on (operating/autopilot_drafter.py)
Environment=PLX_AUTOPILOT_DRAFT_MODEL=opus
# names its Postgres sessions after the unit (ARCH T2: pg_stat_activity, slow-query log)
Environment=PGAPPNAME=%N
Environment=PLX_ONTOLOGY_PG=only
Environment=PLX_AUTOPILOT_EVQ=1
# Each draft takes the person's memory and matching template (operator_api.autopilot_context):
# the served Postgres, and from plx.env only the allowlisted names (autopilot_context.
# ENV_ALLOWED: the Graph read app for the excluded people's names, the exclusion); no other
# name of plx.env reaches this process, and a name this unit or proactive.env set wins.
Environment=PLX_AUTOPILOT_ENV_FILE=@PLX_HOME@/.config/plx/plx.env
Environment=PLX_AUTOPILOT_MEMORY_DSN=postgresql:///plx
ExecStart=/data/venv/bin/python3 -m operator_api.autopilot_context fast --state-dir /data/plx-state
Nice=5
CPUWeight=100
MemoryHigh=1G
MemoryMax=2G
MemorySwapMax=512M
TimeoutStartSec=10min
UMask=0077
