# PLX Workbench search indexes on the communications tables: one run of
# `python3 -m operating.pg.number_indexes comms`, after each business views refresh
# (plx-business-views.service names this unit in OnSuccess=). Makes, CONCURRENTLY (the tables keep
# serving), the btree indexes Ask's mail and file reads filter on (email subject, sender
# domain, mailbox; attachment file name) when a table has none yet, each only after the disk
# budget (operating.disk_budget) grants its peak; a refusal is printed and retried at the next
# run. A unit of its own and not a step of the refresh: one CREATE INDEX CONCURRENTLY is a
# single statement of minutes, which the refresh's watchdog (WatchdogSec: no progress) would
# stop as a hang and start again, in a loop. A second start while one runs does nothing.
[Unit]
Description=PLX search indexes on the communications tables (one run)
After=postgresql.service

[Service]
Type=oneshot
User=@PLX_USER@
Group=@PLX_GROUP@
WorkingDirectory=@PLX_CURRENT@
EnvironmentFile=/etc/plx/ingest.env
EnvironmentFile=@PLX_HOME@/.config/plx/plx.env
# Reads no business system: the credentials that can send, write or reach one are dropped
# (SEC-S-05; tests/test_deploy_release.py names the units that may keep them).
UnsetEnvironment=AZURE_CLIENT_SECRET BC_CLIENT_SECRET MICROSOFT_GRAPH_CLIENT_SECRET MC_MCP_API_KEY PLX_WORKBENCH_API_KEY AZURE_STORAGE_KEY AZURE_DOC_INTEL_KEY PLX_WORKBENCH_SESSION_SECRET
Environment=PATH=/data/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PGAPPNAME=%N
Environment=PLX_ONTOLOGY_PG=only
ExecCondition=/bin/sh -c '/data/venv/bin/python3 -c "import ontology.window_lock" 2>/dev/null || exit 0; exec /data/venv/bin/python3 -m ontology.window_lock check delta'
ExecStart=/data/venv/bin/python3 -m operating.pg.number_indexes comms
MemoryHigh=3G
MemoryMax=4G
TimeoutStartSec=2h
TimeoutStopSec=2min
UMask=0077
