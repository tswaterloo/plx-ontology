# PLX Workbench own-issued guard refresh at low priority: one run of
# deploy/spark/own_issued.sh, the pass with its judging on a Spark (the box keeps
# serving). The box bundles the inputs of the documents no pass judged yet (the digests,
# their capture rows, and their blobs, cleaned up after each run), the Spark judges them
# there (the extraction and matching CPU and memory are the Spark's), and the box applies
# the decisions in refresh's own transaction, the only writes of
# ontology.own_issued_documents / own_issued_judged. Same judgement, same rows:
# a document the pass cannot read is never recorded and is judged again on a later pass.
# Does nothing until migration 0038 is applied (--if-migrated); skipped in a migration
# window (window_lock). Started by plx-own-issued.timer.
[Unit]
Description=PLX own-issued guard refresh (one run)
After=postgresql.service

[Service]
Type=oneshot
User=@PLX_USER@
Group=@PLX_GROUP@
WorkingDirectory=@PLX_CURRENT@
EnvironmentFile=/etc/plx/ingest.env
EnvironmentFile=@PLX_HOME@/.config/plx/plx.env
# Reads no business system: the credentials that can send, write or reach one are dropped
# (SEC-S-05; tests/test_deploy_release.py names the units that may keep them).
UnsetEnvironment=AZURE_CLIENT_SECRET BC_CLIENT_SECRET MICROSOFT_GRAPH_CLIENT_SECRET MC_MCP_API_KEY PLX_WORKBENCH_API_KEY AZURE_STORAGE_KEY AZURE_DOC_INTEL_KEY PLX_WORKBENCH_SESSION_SECRET
Environment=PATH=/data/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PGAPPNAME=%N
ExecCondition=/bin/sh -c '/data/venv/bin/python3 -c "import ontology.window_lock" 2>/dev/null || exit 0; exec /data/venv/bin/python3 -m ontology.window_lock check delta'
ExecStart=@PLX_CURRENT@/deploy/spark/own_issued.sh /data/scratch/plx-own-issued
Nice=19
CPUWeight=20
IOWeight=20
IOSchedulingClass=idle
MemoryHigh=6G
MemoryMax=8G
TimeoutStartSec=8h
UMask=0077
