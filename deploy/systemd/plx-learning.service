# What each person's own replies and edits of Autopilot drafts teach their next drafts
# (operating/learning.py distil): the autopilot queue's items paired with the person's sent
# reply in the mail thread or Teams chat (draft vs what they sent: greeting, sign-off,
# length, sentences added or taken out), decayed and voted into lessons in
# ${PLX_INGEST_STATE}/learning/learning.sqlite (0600), which the autopilot cycle reads
# (operating.autopilot.learned_style). The people exclusion first (unavailable: nothing
# taken in). Stores read-only; never sends or writes to a business system. Hourly.
[Unit]
Description=PLX learning from replies and draft edits
After=plx-ingest.service

[Service]
Type=oneshot
User=@PLX_USER@
Group=@PLX_GROUP@
WorkingDirectory=@PLX_CURRENT@
EnvironmentFile=/etc/plx/ingest.env
EnvironmentFile=-@PLX_HOME@/.config/plx/proactive.env
UnsetEnvironment=AZURE_CLIENT_SECRET BC_CLIENT_SECRET MICROSOFT_GRAPH_CLIENT_SECRET MC_MCP_API_KEY PLX_WORKBENCH_API_KEY AZURE_STORAGE_KEY AZURE_DOC_INTEL_KEY PLX_WORKBENCH_SESSION_SECRET
Environment=PATH=/data/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PGAPPNAME=%N
Environment=PLX_ONTOLOGY_PG=only
ExecStart=/data/venv/bin/python3 -m operating.learning distil --state-dir ${PLX_INGEST_STATE}
ProtectSystem=strict
ReadOnlyPaths=/data/plx-state
ReadWritePaths=/data/plx-state/learning
NoNewPrivileges=true
PrivateTmp=true
Nice=15
CPUWeight=20
MemoryHigh=2G
MemoryMax=4G
TimeoutStartSec=30min
UMask=0077
