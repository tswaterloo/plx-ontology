# PLX Workbench API, the deploy's standby (ARCH-T6: warm-then-switch restarts), instance
# "standby": plx-api@standby. Never enabled and never started by hand: `plx-release restart`
# (deploy/release/plx-release) starts it on the new release, held until warm, while
# plx-api.service (8780) restarts on it, and stops it once 8780 serves again. Caddy sends
# /api/* to 8780, and to this unit's socket when 8780 takes no connection (deploy/Caddyfile).
# It serves on a unix socket, not a TCP port: /run/plx-api-%i/api.sock, in a directory
# systemd creates for this unit only (owned by its user, 0711, removed when it stops), so no
# other process (a dev or mock API an agent started) can ever be where Caddy sends readers.
# It runs exactly as plx-api.service does: plx-release mirrors every plx-api.service drop-in
# into plx-api@.service.d (symlinks, plus zzzz-slot.conf: plx-api.service's own ExecStart
# with --unix-socket for --port) and refuses the switch when any setting of the two differs.
# Install: deploy/release/README-warm-switch.md.
[Unit]
Description=PLX Workbench API (operator_api), the deploy's %i
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
# the serving unit's slice: a template instance would otherwise sit in system-plx\x2dapi.slice,
# with other weights than plx-api.service, and plx-release refuses the switch ("differs in: Slice")
Slice=system.slice
# names its Postgres sessions after the unit (ARCH T2)
Environment=PLX_ONTOLOGY_PG=only
Environment=PGAPPNAME=%N
Type=simple
User=plx-workbench
Group=plx-workbench
WorkingDirectory=@PLX_CURRENT@
EnvironmentFile=/etc/plx/workbench-api.env
# the measured system-of-record precedence (plx-precedence-measure.service writes it)
Environment=PLX_PRECEDENCE_TABLE=/data/plx-state/precedence/measured.json
# every model call counted (operating/model_ledger.py: no prompt or answer text)
Environment=PLX_MODEL_LEDGER=/var/lib/plx-workbench/model-calls.jsonl
# the model that writes a reply from a person's one line (POST /api/autopilot/items/{id}/reply-from-line,
# operating/autopilot_drafter.py); unset it answers 409. It runs on the autopilot's own access-token-only
# claude home, never an operator's ~/.claude (operating/chat_ask_model.py)
Environment=PLX_AUTOPILOT_DRAFT_MODEL=opus
Environment=PLX_CHAT_ASK_CLAUDE_HOME=/var/lib/plx-autopilot/claude-home
ExecStart=/usr/bin/env python3 -m operator_api serve --bind 127.0.0.1 --unix-socket /run/plx-api-%i/api.sock $PLX_API_ARGS
# the serving unit's restart policy (plx-release refuses the switch on any difference:
# a "differs in: Restart" mismatch made every deploy restart the API cold)
Restart=always
RestartSteps=6
RestartMaxDelaySec=2min
RestartSec=3
# SIGTERM: the requests under way end (60 s at most), then the workers (20 s)
TimeoutStopSec=100
# the socket's directory: this unit's user alone may create anything in it
RuntimeDirectory=plx-api-%i
RuntimeDirectoryMode=0711

# Hardening: read-only everywhere except the API's own state directory.
StateDirectory=plx-workbench
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/plx-workbench -/var/lib/plx-autopilot/claude-home
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0027
# never enabled: plx-release starts and stops it (no [Install] section)
