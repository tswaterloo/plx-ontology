# PLX Workbench daily changes: one run of `python3 -m operating.pg.daily_changes run`, after each
# business views refresh (plx-business-views.service names this unit in OnSuccess=). Adds the
# object versions recorded since the last run to biz.daily_changes (what each system created,
# changed and removed per day, by kind of record and permission class), in chunks of a million
# versions each in a transaction of its own, then makes the guarded view biz_sql.daily_changes.
# The first run reads the whole history (about 17M versions, a few minutes); later runs a few
# thousand; the served counts are regrouped from the objects as they are now on every run, so a
# record whose audience narrowed or whose owner was excluded changes class at the next run. A run
# goes to the head: only a hung statement (statement_timeout) ends it.
# A unit of its own: the refresh's watchdog must not see a long statement as a hang. A second
# start while one runs does nothing.
[Unit]
Description=PLX daily changes per system (one run)
After=postgresql.service

[Service]
Type=oneshot
User=@PLX_USER@
Group=@PLX_GROUP@
WorkingDirectory=@PLX_CURRENT@
EnvironmentFile=/etc/plx/ingest.env
EnvironmentFile=@PLX_HOME@/.config/plx/plx.env
# Reads no business system: the credentials that can send, write or reach one are dropped
# (SEC-S-05; tests/test_deploy_release.py names the units that may keep them).
UnsetEnvironment=AZURE_CLIENT_SECRET BC_CLIENT_SECRET MICROSOFT_GRAPH_CLIENT_SECRET MC_MCP_API_KEY PLX_WORKBENCH_API_KEY AZURE_STORAGE_KEY AZURE_DOC_INTEL_KEY PLX_WORKBENCH_SESSION_SECRET
Environment=PATH=/data/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PGAPPNAME=%N
Environment=PLX_ONTOLOGY_PG=only
ExecCondition=/bin/sh -c '/data/venv/bin/python3 -c "import ontology.window_lock" 2>/dev/null || exit 0; exec /data/venv/bin/python3 -m ontology.window_lock check delta'
ExecStart=/data/venv/bin/python3 -m operating.pg.daily_changes run
MemoryHigh=2G
MemoryMax=3G
TimeoutStartSec=infinity
TimeoutStopSec=2min
UMask=0077
