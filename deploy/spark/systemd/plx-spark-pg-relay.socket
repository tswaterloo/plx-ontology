[Unit]
Description=PLX Spark runs: the box end of their read-only Postgres path (peer = plx-sparkpg -> plx_eval only)
# deploy/spark/README-spark-run.md. Only the tunnel's ssh client (the host group) may connect here.

[Socket]
ListenStream=/run/plx-spark-pg/.s.PGSQL.5432
SocketUser=plx-sparkpg
SocketGroup=@PLX_GROUP@
SocketMode=0660
DirectoryMode=0755

[Install]
WantedBy=sockets.target
