[Unit]
Description=PLX Spark runs: Postgres tunnel %i (<spark>:<n>; reverse ssh, a socket only the Spark login can open)
Requires=plx-spark-pg-relay.socket
After=plx-spark-pg-relay.socket network-online.target

[Service]
User=@PLX_USER@
Group=@PLX_GROUP@
# Several instances per Spark (s7d3d:1 .. s7d3d:16): each is its own TCP stream through the
# user-space Tailscale; spark_pg_balance.py on the Spark spreads connections over them.
ExecStart=/data/plx-releases/current/deploy/spark/spark_pg_tunnel.sh %i
Restart=always
RestartSec=15
MemoryMax=128M
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
