{
  "name": "plx-workbench-app",
  "version": "0.1.0",
  "private": true,
  "description": "PLX Workbench web app: ask questions across BC, Portal, mail, Teams and files, with sources.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
